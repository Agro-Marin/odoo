#!/bin/sh
# ruff format must not rewrite ''' to """ below — see tooling/_trampoline.sh.
# fmt: off
''':'
# Self-locating sh/python trampoline: re-exec this file with the workspace venv
# interpreter. The logic is shared — see tooling/_trampoline.sh.
_t="$(dirname "$0")/../_trampoline.sh"
[ -f "$_t" ] || { echo "$(basename "$0"): missing $_t" >&2; exit 1; }
. "$_t"
'''
# fmt: on

__doc__ = """Fast warm-server HOOT test runner for the Odoo 19 web module.

Replaces the ~8-11 min ``odoo-bin --test-tags /web:WebSuite.test_X`` loop:
boots ONE persistent threaded dev server (once), keeps it warm across
invocations, and drives Chrome via Odoo's own ``ChromeBrowser`` CDP driver
against ``/web/tests``. The ERP boot and the esbuild bundle build are paid once;
every later run is seconds-to-~1min instead of minutes.

Examples
--------
  hoot '@web/core/domain'              # run one suite
  hoot '@web/services' '@web/model'    # several suites
  hoot '@mail/discuss' '@bus'          # other addons: DB hoot_bus_mail is
                                       #   created with those modules installed
  hoot --affected                      # suites touched by your git diff
  hoot --watch '@web/core/domain'      # re-run on file change
  hoot --status                        # show all warm servers
  hoot --stop [--db hoot_mail]         # stop ONE warm server (keep its DB)
  hoot --clean [--db hoot_mail]        # stop ONE warm server AND drop its DB
                                       #   and that DB's filestore
  hoot --stop --all                    # stop EVERY warm server (all sessions),
                                       #   including untracked orphans

Full test path form works too (HOOT resolves an id against a suite OR a single
test), e.g.  hoot '@web/core/domain/Basic Properties/empty'.
"""


import argparse
import contextlib
import logging
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import hoot_lib as H

C_GREEN, C_RED, C_YEL, C_DIM, C_RST = (H.C_GREEN, H.C_RED, H.C_YEL, H.C_DIM, H.C_RST)
_color = H.color

PRESET_ENV = {
    "desktop": {"size": "1366x768", "touch": False, "tag": ""},
    "mobile": {"size": "375x667", "touch": True, "tag": "-headless"},
}
"""``tag`` mirrors what ``tests/test_js.py`` sends per preset.

``MobileWebSuite`` drives every one of its runs with ``tag="-headless"`` while
``WebSuite`` sends none, because the mobile preset only excludes ``desktop`` --
a ``headless`` test is DOM-free by definition and re-running it at 375x667
buys nothing. Omitting it locally made the runner disagree with CI in the
direction that hides work: a local mobile run is a strict *superset*, so
tagging a suite ``headless`` produced no visible change here and a real one in
CI. Override with ``--tag`` (``--tag ''`` clears it).
"""


def _setup_logging(verbose: bool) -> None:
    level = logging.INFO if verbose else logging.WARNING
    logging.basicConfig(
        level=level,
        format=f"{C_DIM}%(asctime)s %(name)s %(levelname)s{C_RST} %(message)s"
        if sys.stdout.isatty()
        else "%(asctime)s %(name)s %(levelname)s %(message)s",
        datefmt="%H:%M:%S",
    )


def _repeated_note(result) -> str:
    return (
        f"  note: {result.repeated} test re-executions observed — this selection "
        f"makes HOOT run overlapping suites repeatedly, so the run never reaches "
        f"its summary. Split the suite ids instead of raising --timeout."
    )


def _report_unrun_preset(suites: list[str], args, result: H.RunResult) -> None:
    """Say when the other preset owns tests this run did not execute.

    The README already says to run both presets and to "gate on the per-preset
    test count, not on the exit code alone". A PASS that silently skipped every
    mobile test in the selection is exactly the reading that advice guards
    against, and nothing was saying so.
    """
    if args.preset != "desktop" or result.failed:
        return
    files = H.mobile_tagged_files(suites)
    if not files:
        return
    names = ", ".join(sorted(p.name for p in files)[:4])
    if len(files) > 4:
        names += f", +{len(files) - 4} more"
    print(
        _color(
            f"  note: {len(files)} selected file(s) own mobile-tagged tests this "
            f"preset does not run ({names}). Verify with: "
            f"./hoot --preset mobile {' '.join(suites)}",
            C_DIM,
        )
    )


def _report(result: H.RunResult) -> None:
    header = " ".join(result.suites) or "(no suites)"
    if result.server_died:
        print(
            _color(
                f"VOID  {header}  "
                f"(THE WARM SERVER DIED DURING THIS RUN — "
                f"{result.failed} failed / {result.passed} passed, "
                f"{result.wall:.1f}s)",
                C_RED,
            )
        )
        print(
            _color(
                "  These failures are not the code: once the server is gone every "
                "test still to configure its MockServer fails in _loadModels with "
                "`TypeError: Failed to fetch`. Re-run; if it repeats, read the "
                "server log for `inotify is out of capacity` (ENOSPC) or `Postgres "
                "unavailable`. Freeing instances -- `hoot --stop --db <name>` for "
                "servers you own -- is the cheapest mitigation.",
                C_YEL,
            )
        )
        return
    if result.ok:
        print(
            _color(
                f"PASS  {header}  ({result.passed} passed, {result.wall:.1f}s)", C_GREEN
            )
        )
        return
    if result.incomplete and not result.failed:
        print(
            _color(
                f"WARN  {header}  "
                f"({result.passed} passed, no clean summary — likely a browser "
                f"teardown timeout, {result.wall:.1f}s)",
                C_YEL,
            )
        )
        if result.repeated:
            print(_color(_repeated_note(result), C_YEL))
        if result.error:
            print(_color(f"  note: {result.error}", C_DIM))
        return
    if result.incomplete:
        print(
            _color(
                f"FAIL  {header}  "
                f"({result.failed} failed / {result.passed} passed, "
                f"RUN TRUNCATED — remaining tests never ran, {result.wall:.1f}s)",
                C_RED,
            )
        )
        print(
            _color(
                "  note: counts are DISTINCT tests seen so far, a prefix of the "
                "suite; re-run with a larger --timeout or in smaller suite groups "
                "for a complete result.",
                C_YEL,
            )
        )
        if result.repeated:
            print(_color(_repeated_note(result), C_YEL))
        if result.error:
            print(_color(f"  error: {result.error}", C_YEL))
        for name in result.failed_tests[:50]:
            print(_color(f"  - {name}", C_RED))
        if len(result.failed_tests) > 50:
            print(_color(f"  ... and {len(result.failed_tests) - 50} more", C_RED))
        return
    print(
        _color(
            f"FAIL  {header}  "
            f"({result.failed} failed / {result.passed} passed, "
            f"{result.wall:.1f}s)",
            C_RED,
        )
    )
    if result.error:
        print(_color(f"  error: {result.error}", C_YEL))
    for name in result.failed_tests[:50]:
        print(_color(f"  - {name}", C_RED))
    if len(result.failed_tests) > 50:
        print(_color(f"  ... and {len(result.failed_tests) - 50} more", C_RED))


def _resolve_suites(args) -> list[str]:
    if args.affected:
        changed = H.changed_web_js(args.suites or None)
        suites = H.affected_suites(changed, downstream=args.downstream)
        if not suites:
            print(
                _color("No affected suites detected from the changed JS files.", C_YEL)
            )
        else:
            print(
                _color(f"Affected suites ({len(suites)}): " + " ".join(suites), C_DIM)
            )
        return suites
    return list(args.suites)


def _run_isolated(suites: list[str], state: dict, args) -> H.RunResult:

    merged = H.RunResult(ok=True, suites=list(suites))
    for suite in suites:
        result = _run_once([suite], state, args)
        merged.passed += result.passed
        merged.failed += result.failed
        merged.repeated += result.repeated
        merged.wall += result.wall
        merged.failed_tests.extend(result.failed_tests)
        merged.incomplete = merged.incomplete or result.incomplete
        merged.server_died = merged.server_died or result.server_died
        merged.ok = merged.ok and result.ok
        if result.error and not merged.error:
            merged.error = result.error
    return merged


def _run_once(suites: list[str], state: dict, args) -> H.RunResult:
    env = PRESET_ENV.get(args.preset, PRESET_ENV["desktop"])
    browser_size = args.browser_size or env["size"]
    touch = env["touch"] if args.touch is None else args.touch
    tag = env["tag"] if args.tag is None else args.tag
    extra = f"&tag={tag}" if tag else ""
    if args.filter:
        extra += f"&filter={args.filter}"
    if args.hook_timeout is not None:
        extra += f"&hookTimeout={args.hook_timeout}"
    result = H.run_suites(
        suites,
        port=state["port"],
        db=state["db"],
        preset=args.preset,
        hoot_timeout_ms=args.hoot_timeout,
        wall_timeout_s=args.timeout,
        browser_size=browser_size,
        touch_enabled=touch,
        extra=extra,
        verbose=args.verbose,
    )
    # Ask whether the server we ran against is still THAT server. Warmth alone
    # is not the question: a concurrent invocation reboots a died server, and
    # `server_is_warm` would then answer for its replacement while this run's
    # failures came from the gap. Identity is the pid.
    after = H.read_state(state["db"]) or {}
    if after.get("pid") != state.get("pid") or not H.server_is_warm(after):
        result.server_died = True
        result.ok = False
    return result


def _watch(suites: list[str], state: dict, args) -> int:

    watched_addons = H.addons_for_suites(suites) | {"web"}
    watch_roots = []
    for addon in H.iter_addon_dirs():
        if addon.name not in watched_addons:
            continue
        for kind in ("src", "tests"):
            d = addon / "static" / kind
            if d.is_dir():
                watch_roots.append(d)

    def snapshot() -> dict[str, float]:
        snap = {}
        for root in watch_roots:
            for p in root.rglob("*.js"):
                with contextlib.suppress(OSError):
                    snap[str(p)] = p.stat().st_mtime
        return snap

    print(_color("Watch mode: edit a .js file to re-run. Ctrl-C to exit.", C_YEL))
    last = snapshot()
    _report(_run_once(suites, state, args))
    try:
        while True:
            time.sleep(1.0)
            cur = snapshot()
            changed = [Path(k) for k in cur if cur[k] != last.get(k)]
            if not changed:
                last = cur
                continue
            last = cur
            print(_color(f"\nChanged: {len(changed)} file(s) -> re-running", C_DIM))
            run_suites = suites
            if args.affected:
                run_suites = (
                    H.affected_suites(changed, downstream=args.downstream) or suites
                )
                print(_color("Affected: " + " ".join(run_suites), C_DIM))
            _report(_run_once(run_suites, state, args))
    except KeyboardInterrupt:
        print("\nWatch stopped.")
        return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="hoot",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=__doc__,
    )
    ap.add_argument(
        "suites",
        nargs="*",
        help="@web/... suite paths (or full test paths) to run. "
        "With --affected, these are treated as changed files.",
    )
    ap.add_argument(
        "--affected",
        action="store_true",
        help="Run only suites affected by changed JS "
        "(default: git diff in every addons-path repo).",
    )
    ap.add_argument(
        "--downstream",
        action="store_true",
        help="With --affected: also select affected suites owned "
        "by OTHER addons (a core file reaches ~100 of them).",
    )
    ap.add_argument(
        "--isolate",
        action="store_true",
        help="Run each suite in its own page load, as CI does; "
        "batched suites pollute each other.",
    )
    ap.add_argument(
        "--watch", action="store_true", help="Re-run on JS file changes (mtime poll)."
    )
    ap.add_argument(
        "--preset",
        default="desktop",
        choices=["desktop", "mobile"],
        help="HOOT preset (default: desktop).",
    )
    ap.add_argument(
        "--db",
        default=None,
        help="Warm-server database (default: derived from the "
        "requested suites' addons, e.g. @mail/... -> "
        "hoot_mail; plain @web -> hoot_web).",
    )
    ap.add_argument(
        "--timeout",
        type=int,
        default=300,
        help="Wall-clock timeout per run, seconds (default: 300).",
    )
    ap.add_argument(
        "--hoot-timeout",
        type=int,
        default=15000,
        help="HOOT in-page timeout, ms (default: 15000). Covers the "
        "test body only, not its hooks.",
    )
    ap.add_argument(
        "--hook-timeout",
        type=int,
        default=None,
        help="HOOT before-test/after-test hook timeout, ms "
        "(default: HOOT's own 5000). Lower it to reproduce a "
        "hook that outlives the threshold.",
    )
    ap.add_argument(
        "--filter", default="", help="Extra HOOT text filter appended to the URL."
    )
    ap.add_argument(
        "--tag",
        default=None,
        help="HOOT tag filter, e.g. '-headless' or 'desktop'. "
        "Defaults to what CI sends for the preset "
        "(mobile: -headless); pass '' to clear it.",
    )
    ap.add_argument(
        "--browser-size",
        default=None,
        help="Chrome window WxH (default: from --preset, e.g. mobile=375x667).",
    )
    ap.add_argument(
        "--touch",
        action="store_true",
        default=None,
        help="Force touch emulation (default: from --preset).",
    )
    ap.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Verbose (server + browser INFO logs).",
    )
    ap.add_argument(
        "--status", action="store_true", help="Print warm-server status and exit."
    )
    ap.add_argument(
        "--stop",
        action="store_true",
        help="Stop this invocation's warm server (keep its DB) and exit.",
    )
    ap.add_argument(
        "--clean",
        action="store_true",
        help="Stop this invocation's warm server, drop its DB and that "
        "DB's filestore, then exit.",
    )
    ap.add_argument(
        "--all",
        action="store_true",
        help="With --stop/--clean: act on EVERY recorded warm "
        "server, including those other sessions are using, and reap "
        "untracked orphans no state file accounts for.",
    )
    ap.add_argument(
        "--restart",
        action="store_true",
        help="Force a fresh warm server before running.",
    )
    args = ap.parse_args()
    _setup_logging(args.verbose)

    if args.status:
        states = H.read_all_states()
        warm = [st for st in states if H.server_is_warm(st)]
        if not warm:
            print(_color("COLD  no warm server", C_YEL))
        for st in warm:
            print(
                _color(
                    f"WARM  pid={st['pid']} port={st['port']} db={st['db']}", C_GREEN
                )
            )
        # Orphans hold connection slots and inotify watches while answering to
        # nobody, so a status that omits them reads as clean while the cluster
        # fills up. `--stop --all` is what clears them.
        for pid, db in sorted(H.find_untracked_servers().items()):
            print(
                _color(
                    f"ORPHAN pid={pid} db={db} — untracked; `hoot --stop --all` "
                    f"reaps it",
                    C_YEL,
                )
            )
        return 0
    if args.stop or args.clean:
        db = args.db
        if db is None and not args.all:
            db = H.db_for_modules(H.modules_for_suites(list(args.suites)))
        print(H.stop_server(db=db, clean=args.clean))
        if args.all:
            reaped = H.stop_untracked_servers(clean=args.clean)
            if reaped:
                print(reaped)
        return 0

    suites = _resolve_suites(args)
    if not suites:
        # `--restart` used to be read only on the way into a run, so a bare
        # `hoot --restart` returned 0 here having stopped nothing: the next
        # invocation reused the stale server and silently tested the sources
        # as they were at ITS boot. Honour the flag whether or not there is
        # something to run, resolving the database the way `--stop` does.
        if args.restart:
            db = args.db or H.db_for_modules(H.modules_for_suites([]))
            print(H.stop_server(db=db, clean=False))
        return 0

    modules = H.modules_for_suites(suites)
    db = args.db or H.db_for_modules(modules)
    if args.restart:
        H.stop_server(db=db, clean=False)

    t0 = time.time()
    try:
        state, booted = H.ensure_server(db, modules, verbose=args.verbose)
    except H.PostgresUnavailable as exc:
        # Not a hoot failure and not a test failure: the shared cluster is out
        # of connection slots. Say which, so nobody spends the next hour
        # bisecting a green branch.
        print(
            _color(
                f"hoot: cannot reach PostgreSQL — {exc}\n"
                f"      The cluster is shared; wait for slots rather than "
                f"dropping anyone's database.",
                C_DIM,
            ),
            file=sys.stderr,
        )
        return 2
    isolated = args.isolate and len(suites) > 1
    if booted:
        scopes = (
            [H.module_scope_param([s]) for s in suites]
            if isolated
            else [H.module_scope_param(suites)]
        )
        warmed = H.warm_bundles(state["port"], state["db"], scopes)
        print(
            _color(
                f"Warm server booted (port={state['port']} db={state['db']}) "
                f"in {time.time() - t0:.1f}s (bundles: {warmed:.1f}s)",
                C_DIM,
            )
        )
    else:
        print(
            _color(
                f"Reusing warm server (port={state['port']} db={state['db']})", C_DIM
            )
        )

    if args.watch:
        return _watch(suites, state, args)

    result = (_run_isolated if isolated else _run_once)(suites, state, args)
    _report(result)
    _report_unrun_preset(suites, args, result)
    if result.failed:
        return 1
    return 0 if (result.ok or result.incomplete) else 1


if __name__ == "__main__":
    sys.exit(main())
