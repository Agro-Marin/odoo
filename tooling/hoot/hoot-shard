#!/bin/sh
''':'
# Self-locating sh/python trampoline: re-exec this file with the workspace venv
# interpreter. The logic is shared — see tooling/_trampoline.sh.
_t="$(dirname "$0")/../_trampoline.sh"
[ -f "$_t" ] || { echo "$(basename "$0"): missing $_t" >&2; exit 1; }
. "$_t"
'''
"""Parallel shard wrapper around the warm-server ``hoot`` runner.

HOOT runs a suite's tests *serially inside one browser page*, so a single
``hoot`` invocation's wall-clock is just the sum of its tests. This wrapper
partitions the requested suites into N balanced shards and runs N ``hoot``
invocations **concurrently**, each against its own warm database (the runner
auto-picks a free port and auto-creates/installs ``web`` per DB, and its
lifecycle is explicitly per-DB so concurrent warm servers never collide). On a
many-core box this turns a ~10 min full-web run into a ~2-3 min one.

Balancing uses a per-suite runtime table (``data/hoot_shard_weights.json``
beside this script, seeded from observed timings) and longest-processing-time (LPT)
bin-packing, so the slowest suites are spread across shards instead of piling
onto one.

Examples
--------
  hoot-shard                          # full web suite, auto shard count, desktop
  hoot-shard -j 4                     # force 4 shards
  hoot-shard --preset mobile          # full web suite on mobile
  hoot-shard '@web/views/fields' '@web/webclient' '@web/core'   # only these
  hoot-shard --plan                   # print the partition and exit (no run)
  hoot-shard --calibrate              # time each suite solo, refresh weights
  hoot-shard --stop                   # stop every shard's warm server

Shard 0 reuses the canonical ``hoot_web`` DB (so an already-warm server is
reused); shards 1..N-1 use ``hoot_web_s1`` .. ``hoot_web_s{N-1}`` (created +
``web``-installed once, in parallel, on first use).
"""

# CLI tool: print() is the user-facing output channel (T201 is already
# ignored for tooling/** in ruff.toml, so no per-file directive is needed).
import argparse
import contextlib
import json
import os
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOOT = HERE / "hoot"

sys.path.insert(0, str(HERE))  # hoot_lib lives beside this script
import hoot_lib as H

WEIGHTS_PATH = HERE / "data" / "hoot_shard_weights.json"

# Colours and the isatty-aware wrapper live in hoot_lib: `hoot-shard` parses
# `hoot`'s output, so the two agreeing on them is a contract.
C_GREEN, C_RED, C_YEL, C_DIM, C_RST = (
    H.C_GREEN, H.C_RED, H.C_YEL, H.C_DIM, H.C_RST
)
_color = H.color



def default_web_suites() -> list[str]:
    """Exactly what ``web/tests/test_js.py`` drives, read from the runner.

    This used to be a hand-maintained copy carrying a "KEEP IN SYNC" comment,
    and it had drifted: ``@html_editor`` (4766 tests, 494 s) and ``@web/libs``
    were missing, so a run that presented itself as the full web suite covered
    66% of its tests and 56% of its runtime. ``test_shard_runner_covers_ci``
    now fails the build if the two ever diverge again.
    """
    return sorted(H.ci_runner_suites("web"))

# Seed runtimes (seconds), rough, for balancing only. Refined by --calibrate.
SEED_WEIGHTS = {
    "@web/core": 45, "@web/components": 40, "@web/services": 25, "@web/ui": 15,
    "@web/model": 15, "@web/views/calendar": 15, "@web/views/fields": 180,
    "@web/views/form": 35, "@web/views/kanban": 22, "@web/views/list": 40,
    "@web/views/graph": 40, "@web/views/pivot": 30, "@web/views/pivot_view": 25,
    "@web/views/view_components": 20, "@web/views/view_compiler": 10,
    "@web/views/view_dialogs": 15, "@web/views/widgets": 20,
    "@web/views/layout": 8, "@web/views/view_button": 10,
    "@web/views/view_buttons": 8, "@web/views/view_button_hook": 6,
    "@web/views/view_service": 8, "@web/views/view": 20,
    "@web/views/view_utils": 8, "@web/views/module_views": 6,
    "@web/views/settings": 6,
    "@web/search": 40, "@web/webclient": 90, "@web/public": 20, "@web/env": 5,
    "@web/reactivity": 5, "@web/t_custom_click": 4, "@web/helpers": 6,
    "@web/interactions": 15, "@web/l10n": 8, "@web/mock_server": 10,
    "@web/modules": 8,
}
DEFAULT_WEIGHT = 30  # unknown suite


def load_weights() -> dict:
    """The measured runtime table, seeded with SEED_WEIGHTS.

    Read-only. It used to write SEED_WEIGHTS to the committed weights file when
    that file was absent, which put a tracked-file mutation on the path of
    every `--plan` and every run — a getter with a side effect that shows up in
    `git status`. `--calibrate` is the one thing that writes here, and it says
    so on the tin.
    """
    weights = dict(SEED_WEIGHTS)
    if WEIGHTS_PATH.exists():
        with contextlib.suppress(ValueError, OSError):
            weights.update(json.loads(WEIGHTS_PATH.read_text()))
    return weights


def refine(suites: list[str], n: int, weights: dict) -> list[str]:
    """Split suites too heavy to balance into their child suites.

    A whole-addon id is one serial page load however long it runs, so LPT can
    only ever put ``@html_editor`` (494 s, against 620 s for all 36 other web
    suites combined) alone on a shard and let the rest idle. Descending into
    the directory behind it turns that into 65 schedulable units. A child with
    no measured weight inherits its parent's, pro-rated by test-file count.
    """
    target = max(sum(weight_of(s, weights) for s in suites) / max(n, 1), 1.0)
    out, todo = [], list(suites)
    while todo:
        suite = todo.pop()
        if weight_of(suite, weights) <= target:
            out.append(suite)
            continue
        children = H.child_suites(suite)
        if not children:
            out.append(suite)
            continue
        parent_files = len(H.suite_test_files(suite)) or 1
        parent_weight = weight_of(suite, weights)
        for child in children:
            weights.setdefault(
                child,
                parent_weight * len(H.suite_test_files(child)) / parent_files,
            )
        todo.extend(children)
    return out


def weight_of(suite: str, weights: dict) -> float:
    """Measured runtime, else an estimate from the suite's test-file count.

    A flat constant for unknown suites is what hid ``@html_editor``: at
    DEFAULT_WEIGHT it looked like a 30 s suite worth scheduling whole, while it
    actually runs 494 s — so it was never refined and one shard carried it
    alone. Test-file count is the cheapest proxy that scales.
    """
    if suite in weights:
        return weights[suite]
    files = len(H.suite_test_files(suite))
    return files * seconds_per_file(weights) if files else DEFAULT_WEIGHT


_SECONDS_PER_FILE: list[float] = []


def seconds_per_file(weights: dict) -> float:
    if not _SECONDS_PER_FILE:
        pairs = [(w, len(H.suite_test_files(s))) for s, w in weights.items()]
        total_w = sum(w for w, f in pairs if f)
        total_f = sum(f for w, f in pairs if f)
        _SECONDS_PER_FILE.append((total_w / total_f) if total_f else DEFAULT_WEIGHT)
    return _SECONDS_PER_FILE[0]


def partition(suites: list[str], n: int, weights: dict) -> list[list[str]]:
    """LPT bin-packing: heaviest suite first, onto the lightest shard."""
    shards: list[list[str]] = [[] for _ in range(n)]
    loads = [0.0] * n
    for suite in sorted(suites, key=lambda s: weight_of(s, weights), reverse=True):
        i = loads.index(min(loads))
        shards[i].append(suite)
        loads[i] += weight_of(suite, weights)
    return [s for s in shards if s]  # drop empties when n > len(suites)


def db_for(index: int, prefix: str) -> str:
    return prefix if index == 0 else f"{prefix}_s{index}"


def hoot_cmd(extra: list[str]) -> list[str]:
    # Invoke ``hoot`` under this same (venv) interpreter so we do not depend on
    # its executable bit / shebang; its python body runs directly.
    return [sys.executable, str(HOOT), *extra]


# hoot's per-run summary lines (see hoot's _report()).
RE_SUMMARY = re.compile(r"^(PASS|FAIL|WARN)\s+(.*?)\s+\((.+)\)\s*$")
RE_FAILED = re.compile(r"(\d+)\s+failed")
RE_PASSED = re.compile(r"(\d+)\s+passed")
RE_WALL = re.compile(r"([\d.]+)s")
RE_BULLET = re.compile(r"^\s+-\s+(@\S.*?)\s*$")


class ShardResult:
    def __init__(self, index: int, db: str):
        self.index, self.db = index, db
        self.status = "?"
        self.passed = self.failed = 0
        self.wall = 0.0
        self.failed_tests: list[str] = []
        self.rc = 0
        self.raw = ""

    def parse(self) -> None:
        for line in self.raw.splitlines():
            if m := RE_SUMMARY.match(line):
                self.status = m[1]
                detail = m[3]
                self.failed = int(RE_FAILED.search(detail)[1]) if RE_FAILED.search(detail) else 0
                self.passed = int(RE_PASSED.search(detail)[1]) if RE_PASSED.search(detail) else 0
                self.wall = float(RE_WALL.search(detail)[1]) if RE_WALL.search(detail) else 0.0
            elif b := RE_BULLET.match(line):
                self.failed_tests.append(b[1])
        # A nonzero rc with no parsed summary => the shard's hoot run itself
        # broke (boot failure, timeout). Surface it as a failure, not silence.
        if self.status == "?" and self.rc != 0:
            self.status = "FAIL"
            self.failed = max(self.failed, 1)


#: Extra seconds a shard gets on top of its per-page budget: a cold shard DB
#: pays a one-time `web` install plus a server boot before the first page load.
SHARD_BOOT_GRACE_S = 600


def _as_text(chunk) -> str:
    if chunk is None:
        return ""
    return chunk if isinstance(chunk, str) else chunk.decode("utf-8", "replace")


def shard_deadline(suites: list[str], args) -> float:
    """Wall-clock ceiling for one shard's ``hoot`` subprocess.

    ``--timeout`` is per PAGE LOAD and is handed to ``hoot``; with ``--isolate``
    a shard loads one page per suite, so its own ceiling is the sum plus a boot
    allowance. Without any ceiling the subprocess could hang forever: ``hoot``'s
    timeout only bounds the in-page wait, and a Chrome that never reaches the
    ready signal (or a warm server that dies mid-run) leaves ``subprocess.run``
    blocking with no output, taking the whole ThreadPoolExecutor with it.
    """
    return len(suites) * args.timeout + SHARD_BOOT_GRACE_S


def run_shard(index: int, suites: list[str], args) -> ShardResult:
    db = db_for(index, args.db_prefix)
    res = ShardResult(index, db)
    extra = ["--db", db, "--preset", args.preset, "--timeout", str(args.timeout),
             "--isolate"]
    if args.hoot_timeout:
        extra += ["--hoot-timeout", str(args.hoot_timeout)]
    if args.verbose:
        extra.append("-v")
    extra += suites
    try:
        proc = subprocess.run(
            hoot_cmd(extra), capture_output=True, text=True, check=False,
            timeout=shard_deadline(suites, args),
        )
        res.raw = proc.stdout + proc.stderr
        res.rc = proc.returncode
    except subprocess.TimeoutExpired as exc:
        # TimeoutExpired.stdout/.stderr are not reliably decoded even under
        # text=True, so normalise before parsing.
        res.raw = _as_text(exc.stdout) + _as_text(exc.stderr)
        res.rc = 124
        res.raw += (
            f"\nhoot-shard: shard {index} exceeded "
            f"{shard_deadline(suites, args):.0f}s and was killed; its warm "
            f"server on {db} is left running (stop it with --stop).\n"
        )
    res.parse()
    return res


def calibrate(suites: list[str], args) -> None:
    """Time each suite solo (sequentially, one DB) and rewrite the weights file.

    Runs on the *refined* list, so the child suites the plan actually schedules
    get measured weights instead of a pro-rated guess from their parent's.
    Sequential and uncontended on purpose: concurrent shards inflate timings and
    fail timing-sensitive tests (5 of the 11 failures the batched runner used to
    report never reproduced on an idle box).
    """
    weights = load_weights()
    for suite in suites:
        r = run_shard(0, [suite], args)
        if r.wall:
            weights[suite] = round(r.wall, 1)
        tag = _color("ok", C_GREEN) if r.status == "PASS" else _color(r.status, C_YEL)
        print(f"  {tag}  {suite}  {r.wall:.1f}s ({r.passed} passed)")
    WEIGHTS_PATH.write_text(json.dumps(weights, indent=2, sort_keys=True))
    print(_color(f"Wrote {WEIGHTS_PATH}", C_DIM))


def stop_all(prefix: str) -> None:
    """Stop every recorded shard server, not ``range(auto_shard_count)``.

    The shard count is derived from the CPU count when ``-j`` is omitted, so a
    bare ``--stop`` after ``hoot-shard -j 8`` used to walk shards 0..5 on a
    22-core box and leave s6 and s7 running, still holding their ports. What
    was started is recorded in the state files; read those instead of
    recomputing a number that was never the one used.
    """
    dbs = sorted(
        {
            db
            for state in H.read_all_states()
            if (db := state.get("db")) and (db == prefix or db.startswith(f"{prefix}_s"))
        }
    )
    if not dbs:
        print("no shard server recorded")
        return
    for db in dbs:
        subprocess.run(hoot_cmd(["--db", db, "--stop"]), check=False)
        print(f"stopped {db}")


def main() -> int:
    p = argparse.ArgumentParser(
        prog="hoot-shard",
        description="Run @web/... HOOT suites across N concurrent warm servers.",
    )
    p.add_argument("suites", nargs="*", help="@web/... suites (default: full web).")
    p.add_argument("-j", "--shards", type=int, default=0,
                   help="Shard count (default: auto from CPU count).")
    p.add_argument("--preset", choices=("desktop", "mobile"), default="desktop")
    p.add_argument("--timeout", type=int, default=900,
                   help="Per-shard wall-clock timeout, seconds (default: 900).")
    p.add_argument("--hoot-timeout", type=int, default=0,
                   help="HOOT in-page timeout, ms (default: hoot's own).")
    p.add_argument("--db-prefix", default="hoot_web",
                   help="Shard 0 uses this DB; shard i uses <prefix>_s{i}.")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--plan", action="store_true",
                   help="Print the shard partition and exit (no run).")
    p.add_argument("--calibrate", action="store_true",
                   help="Time each suite solo and refresh the weights file.")
    p.add_argument("--stop", action="store_true",
                   help="Stop every shard's warm server and exit.")
    args = p.parse_args()

    # Before any suite discovery: stopping servers needs no shard plan, and
    # building one costs an AST parse of every addon's test_js.py.
    if args.stop:
        stop_all(args.db_prefix)
        return 0

    suites = args.suites or default_web_suites()
    if args.preset == "mobile" and not args.suites:
        # Explicit suites are someone asking for exactly what they typed, as in
        # MobileWebSuite._run_hoot; a bare whole-suite run must mirror CI.
        suites = H.mobile_suites(suites)
    if not suites:
        # `default_web_suites` reads the CI runner by parsing its AST, and that
        # read is failure-suppressed — a moved or unparseable test_js.py yields
        # an empty set rather than an error. Running nothing then presented
        # itself as success: `--plan` printed "0 shards" and exited 0, and a
        # real run died on `max_workers must be greater than 0`, a message
        # about thread pools rather than about suites.
        print(_color(
            "hoot-shard: no suites to run. With no arguments the plan comes "
            "from web/tests/test_js.py's _run_hoot calls; an empty result means "
            "that file could not be read or no longer declares any.", C_RED))
        return 2
    weights = load_weights()

    # Auto shard count: ~3 cores per shard (Chrome + threaded server), capped so
    # we never make more shards than suites.
    cores = os.cpu_count() or 4
    auto = max(1, min(8, (cores - 2) // 3))
    n = args.shards or auto
    n = max(1, min(n, len(suites)))

    if args.calibrate:
        calibrate(refine(suites, n, weights), args)
        return 0

    suites = refine(suites, n, weights)
    shards = partition(suites, n, weights)
    n = len(shards)

    def est(group: list[str]) -> float:
        return sum(weight_of(s, weights) for s in group)

    print(_color(f"Shard plan ({n} shards, preset={args.preset}):", C_DIM))
    for i, group in enumerate(shards):
        print(f"  s{i} [{db_for(i, args.db_prefix)}]  ~{est(group):.0f}s  "
              + " ".join(group))
    if args.plan:
        return 0
    est_wall = max((est(g) for g in shards), default=0)
    print(_color(f"Running {n} shards concurrently "
                 f"(est ~{est_wall:.0f}s wall; first run of new shard DBs "
                 f"adds a one-time web install)...", C_DIM))

    t0 = time.time()
    with ThreadPoolExecutor(max_workers=n) as pool:
        results = list(pool.map(lambda ig: run_shard(ig[0], ig[1], args),
                                enumerate(shards)))
    wall = time.time() - t0

    total_passed = total_failed = 0
    all_failed: list[str] = []
    cpu_equiv = 0.0
    for r in results:
        cpu_equiv += r.wall
        total_passed += r.passed
        total_failed += r.failed
        all_failed += r.failed_tests
        code = C_GREEN if r.status == "PASS" else (C_YEL if r.status == "WARN" else C_RED)
        print(_color(
            f"  s{r.index} [{r.db}]  {r.status}  "
            f"({r.failed} failed / {r.passed} passed, {r.wall:.1f}s)", code))
        for name in r.failed_tests:
            print(_color(f"       - {name}", C_RED))
        if r.status not in ("PASS", "WARN") and not r.failed_tests and r.rc:
            # broke without a parseable summary — show a hint from the tail
            tail = "\n".join(r.raw.strip().splitlines()[-4:])
            print(_color(f"       (rc={r.rc}) {tail}", C_YEL))

    print("=" * 60)
    speedup = f"{cpu_equiv / wall:.1f}x" if wall else "n/a"
    line = (f"TOTAL: {total_failed} failed / {total_passed} passed in "
            f"{wall:.1f}s wall  ({cpu_equiv:.0f}s serial-equiv across {n} "
            f"shards → {speedup})")
    print(_color(line, C_GREEN if total_failed == 0 else C_RED))
    if all_failed:
        print(_color("FAILED:", C_RED))
        for name in all_failed:
            print(_color(f"  - {name}", C_RED))
    return 1 if total_failed or any(r.status not in ("PASS", "WARN") for r in results) else 0


if __name__ == "__main__":
    sys.exit(main())
