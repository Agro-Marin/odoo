{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "target": "ESNext",
        "noEmit": true,
        "allowJs": true,
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "skipLibCheck": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "disableSizeLimit": true,
        "types": [],
        "paths": {
            "@odoo/hoot": ["addons/web/static/lib/hoot/hoot.js"],
            "@odoo/hoot-mock": ["addons/web/static/lib/hoot/hoot-mock.js"],
            "@odoo/hoot-dom": ["addons/web/static/lib/hoot-dom/hoot-dom.js"],
            "@web/*": ["addons/web/static/src/*"],
            "@web_enterprise/*": ["../enterprise/web_enterprise/static/src/*"],
            "@web_unsplash/*": ["addons/web_unsplash/static/src/*"],
            "@web_tour/*": ["addons/web_tour/static/src/*"],
            "@web_gantt/*": ["../enterprise/web_gantt/static/src/*"],
            "@web_cohort/*": ["../enterprise/web_cohort/static/src/*"],
            "@web_map/*": ["../enterprise/web_map/static/src/*"],
            "@web_mobile/*": ["../enterprise/web_mobile/static/src/*"],
            "@web_grid/*": ["../enterprise/web_grid/static/src/*"],
            "@web_studio/*": ["../enterprise/web_studio/static/src/*"],
            "@bus/*": ["addons/bus/static/src/*"],
            "@mail/*": ["addons/mail/static/src/*"],
            "@im_livechat/*": ["addons/im_livechat/static/src/*"],
            "@spreadsheet/*": ["addons/spreadsheet/static/src/*"],
            "@whatsapp/*": ["../enterprise/whatsapp/static/src/*"],

            "@website/*": ["addons/website/static/src/*"],
            "@html_editor/*": ["addons/html_editor/static/src/*"],
            "@html_builder/*": ["addons/html_builder/static/src/*"],
            "@point_of_sale/*": ["addons/point_of_sale/static/src/*"],
            "@hw_posbox_homepage/*": ["addons/hw_posbox_homepage/static/src/*"],
            "@l10n_ar_pos/*": ["addons/l10n_ar_pos/static/src/*"],
            "@l10n_co_pos/*": ["addons/l10n_co_pos/static/src/*"],
            "@l10n_es_pos/*": ["addons/l10n_es_pos/static/src/*"],
            "@l10n_fr_pos_cert/*": ["addons/l10n_fr_pos_cert/static/src/*"],
            "@l10n_gcc_pos/*": ["addons/l10n_gcc_pos/static/src/*"],
            "@l10n_in_pos/*": ["addons/l10n_in_pos/static/src/*"],
            "@l10n_sa_pos/*": ["addons/l10n_sa_pos/static/src/*"],
            "@pos_adyen/*": ["addons/pos_adyen/static/src/*"],
            "@pos_discount/*": ["addons/pos_discount/static/src/*"],
            "@pos_hr/*": ["addons/pos_hr/static/src/*"],
            "@pos_hr_restaurant/*": ["addons/pos_hr_restaurant/static/src/*"],
            "@pos_loyalty/*": ["addons/pos_loyalty/static/src/*"],
            "@pos_mrp/*": ["addons/pos_mrp/static/src/*"],
            "@pos_online_payment/*": ["addons/pos_online_payment/static/src/*"],
            "@pos_online_payment_self_order/*": [
                "addons/pos_online_payment_self_order/static/src/*"
            ],
            "@pos_restaurant/*": ["addons/pos_restaurant/static/src/*"],
            "@pos_restaurant_adyen/*": ["addons/pos_restaurant_adyen/static/src/*"],
            "@pos_restaurant_stripe/*": ["addons/pos_restaurant_stripe/static/src/*"],
            "@pos_sale/*": ["addons/pos_sale/static/src/*"],
            "@pos_sale_loyalty/*": ["addons/pos_sale_loyalty/static/src/*"],
            "@pos_sale_margin/*": ["addons/pos_sale_margin/static/src/*"],
            "@pos_self_order/*": ["addons/pos_self_order/static/src/*"],
            "@pos_self_order_adyen/*": ["addons/pos_self_order_adyen/static/src/*"],
            "@pos_self_order_epson_printer/*": ["addons/pos_self_order_epson_printer/static/src/*"],
            "@pos_self_order_sale/*": ["addons/pos_self_order_sale/static/src/*"],
            "@pos_self_order_stripe/*": ["addons/pos_self_order_stripe/static/src/*"],
            "@pos_stripe/*": ["addons/pos_stripe/static/src/*"],
            "@spreadsheet_dashboard_pos_hr/*": ["addons/spreadsheet_dashboard_pos_hr/static/src/*"],

            "@l10n_cl_edi_pos/*": ["../enterprise/l10n_cl_edi_pos/static/src/*"],
            "@l10n_de_pos_cert/*": ["../enterprise/l10n_de_pos_cert/static/src/*"],
            "@l10n_de_pos_res_cert/*": ["../enterprise/l10n_de_pos_res_cert/static/src/*"],
            "@l10n_in_reports_gstr_pos/*": ["l10n_in_reports_gstr_pos/static/src/*"],
            "@l10n_mx_edi_pos/*": ["../enterprise/l10n_mx_edi_pos/static/src/*"],
            "@l10n_pl_reports_pos_jpk/*": ["l10n_pl_reports_pos_jpk/static/src/*"],
            "@pos_account_reports/*": ["pos_account_reports/static/src/*"],
            "@pos_blackbox_be/*": ["../enterprise/pos_blackbox_be/static/src/*"],
            "@pos_enterprise/*": ["../enterprise/pos_enterprise/static/src/*"],
            "@pos_hr_mobile/*": ["../enterprise/pos_hr_mobile/static/src/*"],
            "@pos_iot/*": ["../enterprise/pos_iot/static/src/*"],
            "@pos_iot_six/*": ["../enterprise/pos_iot_six/static/src/*"],
            "@l10n_se_pos/*": ["../enterprise/l10n_se_pos/static/src/*"],
            "@pos_online_payment_self_order_preparation_display/*": [
                "pos_online_payment_self_order_preparation_display/static/src/*"
            ],
            "@pos_order_tracking_display/*": ["../enterprise/pos_order_tracking_display/static/src/*"],
            "@pos_restaurant_appointment/*": ["../enterprise/pos_restaurant_appointment/static/src/*"],
            "@pos_restaurant_preparation_display/*": [
                "../enterprise/pos_restaurant_preparation_display/static/src/*"
            ],
            "@pos_sale_stock_renting/*": ["pos_sale_stock_renting/static/src/*"],
            "@pos_self_order_iot/*": ["../enterprise/pos_self_order_iot/static/src/*"],
            "@pos_self_order_preparation_display/*": [
                "../enterprise/pos_self_order_preparation_display/static/src/*"
            ],
            "@pos_settle_due/*": ["../enterprise/pos_settle_due/static/src/*"],
            "@pos_tyro/*": ["../enterprise/pos_tyro/static/src/*"],
            "@whatsapp_pos/*": ["../enterprise/whatsapp_pos/static/src/*"],

            "@test_mail/*": ["addons/test_mail/static/src/*"]
        }
    },
    "include": ["**/*.js", "**/*.ts"],
    "exclude": [
        "node_modules",
        "setup",
        "doc",
        "**/lib/ace",
        "**/lib/bootstrap",
        "**/lib/Chart",
        "**/lib/chartjs-adapter-luxon",
        "**/lib/dompurify",
        "**/lib/fullcalendar",
        "**/lib/jquery",
        "**/lib/luxon",
        "**/lib/odoo_ui_icons",
        "**/lib/owl",
        "**/lib/pdfjs",
        "**/lib/popper",
        "**/lib/qunit",
        "**/lib/signature_pad",
        "**/lib/stacktracejs",
        "**/lib/zxing-library",
        // Anchored at addons/, NOT "**/l10n*": the loose glob was aimed at the
        // l10n_* localisation addons but every path segment starting "l10n"
        // matched it, so addons/web/static/tests/{core/l10n,l10n} — eight
        // .test.js files — were dropped from the program. They reported no
        // errors because nothing compiled them, and the default-deny gate
        // counted that silence as eight files locked at zero.
        "addons/l10n_*",
        "addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js"
    ]
}
