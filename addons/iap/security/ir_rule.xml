<odoo noupdate="1">

    <record id="user_iap_account" model="ir.rule">
        <field name="name">User IAP Account</field>
        <field name="model_id" ref="model_iap_account" />
        <!-- users only access IAP accounts shared by all companies or linked to one of their own -->
        <field
            name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
    </record>

</odoo>
