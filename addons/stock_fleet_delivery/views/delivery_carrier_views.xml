<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_carrier_form_dispatch_mode" model="ir.ui.view">
        <field name="name">delivery.carrier.form.dispatch.mode</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <field name="delivery_type" position="after">
                <field name="dispatch_mode" />
            </field>
        </field>
    </record>

    <record id="view_delivery_carrier_tree_dispatch_mode" model="ir.ui.view">
        <field name="name">delivery.carrier.list.dispatch.mode</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_tree" />
        <field name="arch" type="xml">
            <field name="delivery_type" position="after">
                <field name="dispatch_mode" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_stock_location_form_dispatch_mode" model="ir.ui.view">
        <field name="name">stock.location.form.dispatch.mode</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_stock_location_form" />
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field
                    name="dispatch_mode"
                    invisible="usage not in ('transit', 'internal')" />
            </field>
        </field>
    </record>

</odoo>
