<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sa_partner_address_form" model="ir.ui.view">
        <field name="name">sa.partner.form.address</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="900" />
        <field name="arch" type="xml">
            <form>
                <div class="o_address_format">
                    <field name="parent_id" invisible="1" />
                    <field name="type" invisible="1" />
                    <field
                        name="street"
                        placeholder="Street..."
                        force_save="1"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_street" />
                    <field
                        name="street2"
                        placeholder="District..."
                        force_save="1"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_street" />
                    <field
                        name="city"
                        placeholder="City"
                        force_save="1"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_city" />
                    <field
                        name="state_id"
                        placeholder="State"
                        force_save="1"
                        options="{&quot;no_open&quot;: True}"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_state" />
                    <field
                        name="zip"
                        placeholder="ZIP"
                        force_save="1"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_zip" />
                    <field
                        name="country_id"
                        placeholder="Country"
                        force_save="1"
                        options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_country" />
                    <field
                        name="l10n_sa_edi_building_number"
                        placeholder="Building Number"
                        force_save="1"
                        options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                        invisible="country_code != 'SA'"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_building_number" />
                    <field
                        name="l10n_sa_edi_plot_identification"
                        placeholder="Plot Identification"
                        force_save="1"
                        options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                        invisible="country_code != 'SA'"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_plot_identification" />
                </div>
            </form>
        </field>
    </record>

    <record id="base.sa" model="res.country">
        <field name="address_view_id" ref="sa_partner_address_form" />
        <field
            name="address_format"
            eval="'%(street)s\n%(street2)s\n%(city)s %(state_code)s %(zip)s\n%(l10n_sa_edi_building_number)s %(l10n_sa_edi_plot_identification)s\n%(country_name)s'" />
    </record>

</odoo>
