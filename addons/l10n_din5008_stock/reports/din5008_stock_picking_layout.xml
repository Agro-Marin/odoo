<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <template
            id="external_layout_din5008_deliveryslip"
            inherit_id="l10n_din5008.external_layout_din5008">
            <xpath expr="//div[@id='din5008_report_main_address']" position="before">
                <t
                    t-if="o and o._name == 'stock.picking' and (o.is_delivery_address_print_required() or o.partner_id)">
                    <t t-set="address">
                        <t
                            t-set="main_address"
                            t-value="o.move_ids[0].partner_id if o.is_delivery_address_print_required() else o.partner_id" />
                        <t t-if="o.is_delivery_address_print_required()">
                            <address
                                class="mb-0"
                                t-field="o.move_ids[0].partner_id"
                                t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                        </t>
                        <t t-else="">
                            <address
                                class="mb-0"
                                t-field="o.partner_id"
                                t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}" />
                        </t>
                    </t>
                </t>
            </xpath>
        </template>
    </data>

</odoo>
