<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.certificate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="after">
                <block
                    id="certificates_and_keys_settings"
                    title="Certificates and Keys"
                    groups="base.group_system">
                    <setting
                        id="certificates_settings"
                        string="Manage your certificates"
                        title="Add, edit and delete certificates."
                        company_dependent="1">
                        <div class="content-group">
                            <div class="row mt16">
                                <div class="col-6">
                                    <button
                                        name="%(certificate.certificate_certificate_action_view_list)d"
                                        type="action"
                                        string="Certificates"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting
                        id="keys_settings"
                        string="Manage your keys"
                        title="Add, edit and delete keys."
                        company_dependent="1">
                        <div class="content-group">
                            <div class="row mt16">
                                <div class="col-6">
                                    <button
                                        name="%(certificate.certificate_key_action_view_list)d"
                                        type="action"
                                        string="Keys"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
