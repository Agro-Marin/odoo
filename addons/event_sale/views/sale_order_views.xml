<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.event.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_attendee_list"
                    type="object"
                    icon="fa-users"
                    invisible="attendee_count == 0"
                    class="oe_stat_button">
                    <field name="attendee_count" string="Attendees" widget="statinfo" />
                </button>
            </div>
            <xpath
                expr="//field[@name='line_ids']//form//field[@name='product_id']"
                position="after">
                <field
                    name="event_id"
                    domain="[                         ('event_ticket_ids.product_id','=', product_id),                         ('date_end','&gt;=',time.strftime('%Y-%m-%d 00:00:00')),                         '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)                     ]"
                    options="{'no_open': True, 'no_create': True}"
                    invisible="service_tracking != 'event'"
                    required="service_tracking == 'event'" />
                <field
                    name="event_slot_id"
                    domain="[('event_id','=', event_id)]"
                    options="{'no_open': True, 'no_create': True}"
                    invisible="not is_multi_slots or service_tracking != 'event'"
                    required="is_multi_slots and service_tracking == 'event'" />
                <field
                    name="event_ticket_id"
                    domain="[                         ('event_id', '=', event_id), ('product_id','=',product_id),                          '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)                     ]"
                    options="{'no_open': True, 'no_create': True}"
                    invisible="service_tracking != 'event' or not event_id"
                    required="service_tracking == 'event' and event_id" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='product_template_id']"
                position="after">
                <field
                    name="event_id"
                    placeholder="All Events"
                    domain="[                         ('event_ticket_ids.product_id','=', product_id),                         ('date_end','&gt;=',time.strftime('%Y-%m-%d 00:00:00')),                         '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)                     ]"
                    options="{'no_open': True, 'no_create': True}"
                    column_invisible="True"
                    required="service_tracking == 'event'" />
                <field
                    name="event_slot_id"
                    domain="[('event_id','=', event_id)]"
                    options="{'no_open': True, 'no_create': True}"
                    column_invisible="True"
                    required="is_multi_slots and service_tracking == 'event'" />
                <field
                    name="event_ticket_id"
                    domain="[                         ('event_id', '=', event_id), ('product_id','=',product_id),                          '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)                     ]"
                    options="{'no_open': True, 'no_create': True}"
                    column_invisible="True"
                    required="service_tracking == 'event' and event_id" />
            </xpath>
        </field>
    </record>

</odoo>
