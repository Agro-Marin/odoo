<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Multicompay rules-->
    <record id="repair_order_rule" model="ir.rule">
        <field name="name">repair order multi-company</field>
        <field
            name="model_id"
            model="ir.model"
            search="[('model','=','repair.order')]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
