<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="70" />
        <field name="arch" type="xml">
            <block name="work_organization_setting_container" position="after">
                <field name="company_country_code" invisible="1" />
                <block
                    title="French Time Off Localization"
                    invisible="company_country_code != 'FR'">
                    <setting
                        help="Set the time off type used as the company Paid Time Off to compute part-timers leave duration"
                        company_dependent="1">
                        <field
                            name="l10n_fr_reference_leave_type"
                            domain="[('company_id', 'in', [company_id, False])]"
                            context="{'default_company_id': company_id}"
                            required="company_country_code == 'FR'"
                            class="o_light_label" />
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
