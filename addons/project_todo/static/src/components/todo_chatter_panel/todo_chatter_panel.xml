<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

    <div t-name="project_todo.TodoChatterPanel" t-ref="root">
        <chatter t-if="state.displayChatter" class="o_FormRenderer_chatterContainer">
            <!-- No hasParentReloadOn* here, deliberately. Each of those makes
                 the chatter call saveRecord() then record.load(), which commits
                 the form on the user's behalf and throws away whatever they were
                 part-way through typing. The To-Do form shows no message,
                 follower or attachment data, so it has nothing to refresh. -->
            <Chatter
                threadModel="'project.task'"
                threadId="props.record.resId"
                record="props.record"
                saveRecord="props.record.save.bind(props.record, { reload: false })"
            />
        </chatter>
    </div>

</templates>
