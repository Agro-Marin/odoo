<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record model="ir.rule" id="resource_calendar_leaves_rule_group_user_create">
        <field name="name">resource.calendar.leaves: employee reads own or global</field>
        <field name="model_id" ref="model_resource_calendar_leaves" />
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="domain_force">['|', ('resource_id', '=', False), ('resource_id.user_id', 'in', [False, user.id])]</field>
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!--
        An employee may only manage the time off of the resource that IS them.
        The previous `('resource_id.user_id', 'in', [False, user.id])` was
        copied from the read rule above, where the `False` legitimately covers
        company-wide time off.  Here the first clause already excluded global
        records, so the `False` matched every resource with no user account —
        machines, rooms, vehicles and unlinked employee resources — letting any
        internal user create, edit and delete their time off.  That data drives
        MRP scheduling, appointment availability and the planning gantt.
    -->
    <record model="ir.rule" id="resource_calendar_leaves_rule_group_user_modify">
        <field name="name">resource.calendar.leaves: employee modifies own</field>
        <field name="model_id" ref="model_resource_calendar_leaves" />
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="domain_force">[('resource_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False" />
    </record>

    <!--
        Managers keep full write access.  Narrowing the rule above without
        widening this one would have locked everyone below group_system out of
        machine and room time off, since group rules are OR-ed and this was the
        only other write path.
    -->
    <record model="ir.rule" id="resource_calendar_leaves_rule_group_admin_modify">
        <field name="name">resource.calendar.leaves: admin modifies any</field>
        <field name="model_id" ref="model_resource_calendar_leaves" />
        <field name="groups" eval="[Command.link(ref('base.group_erp_manager'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False" />
    </record>

    <record id="resource_resource_multi_company" model="ir.rule">
        <field name="name">resource.resource multi-company</field>
        <field name="model_id" ref="model_resource_resource" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record model="ir.rule" id="resource_calendar_leaves_rule_multi_company">
        <field name="name">resource.calendar.leaves: multi-company rule</field>
        <field name="model_id" ref="model_resource_calendar_leaves" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!--
        NOT DONE ON PURPOSE: a multi-company rule on `resource.calendar` and
        `resource.calendar.attendance`.

        These are the only company-owned models in this module without one
        (`resource.resource`, the time off and the reservations all have one),
        so any internal user can read every company's working hours and
        enumerate their attendance lines. That is a real read leak, and the
        obvious `[('company_id', 'in', company_ids + [False])]` was tried and
        reverted: working schedules are read as *reference data* well outside
        the reader's own company. `hr_holidays` computes a leave's duration
        through `resource.mixin._list_work_time_per_day` as the acting user, so
        the rule made an employee unable to read their own working calendar and
        `hr_holidays` `test_get_mandatory_days` failed with an AccessError on
        `resource.calendar`.

        Closing this therefore needs a decision, not a rule: either the
        schedule-computation entry points in this module read the calendar
        definition with `sudo()` (authorisation belonging to the consumer
        record, not to the timetable it is measured against), or every
        cross-company reader is audited one by one. Both are larger than a
        security-file change and neither should be smuggled in as one.
    -->

    <record model="ir.rule" id="resource_reservation_rule_multi_company">
        <field name="name">resource.reservation: multi-company rule</field>
        <field name="model_id" ref="model_resource_reservation" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>