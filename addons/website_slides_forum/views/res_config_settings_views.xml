<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.website.slides.forum</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_slides.res_config_settings_view_form" />
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='website_slide_install_website_slides_forum']"
                position="inside">
                <div class="mt8">
                    <button
                        name="%(website_slides_forum.forum_forum_action_channel)d"
                        type="action"
                        string="Manage Forums"
                        icon="oi-arrow-right"
                        class="btn-link" />
                </div>
            </xpath>
        </field>
    </record>

</odoo>
