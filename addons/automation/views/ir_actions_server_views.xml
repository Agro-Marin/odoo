<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ir_actions_server_tree_workflow" model="ir.ui.view">
        <field name="name">ir.actions.server.tree.workflow</field>
        <field name="model">ir.actions.server</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Workflow Actions">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="state" string="Type" optional="hide" />
                <field name="automation_rule_id" column_invisible="1" />
                <field name="edge_in_ids" widget="many2many_tags" readonly="1" optional="show"
                    string="Waits For" />
                <field name="edge_out_ids" widget="many2many_tags" readonly="1" optional="hide"
                    string="Enables" />
            </list>
        </field>
    </record>

    <record id="view_server_action_form" model="ir.ui.view">
        <field name="name">Server Actions</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_automation"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bolt"
                    invisible="not automation_rule_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Automation</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_ir_actions_server_form_workflow_dag" model="ir.ui.view">
        <field name="name">ir.actions.server.form.workflow.dag</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Dependencies"
                    name="dependencies"
                    invisible="usage != 'automation' or not automation_rule_id"
                    groups="base.group_user">

                    <group>
                        <group string="Step Type">
                            <field name="node_type" />
                            <label for="wait_delay" invisible="node_type != 'wait'" />
                            <div invisible="node_type != 'wait'">
                                <field name="wait_delay" class="oe_inline" /> 
                                <field name="wait_unit" class="oe_inline" nolabel="1" />
                            </div>
                            <field name="approval_user_ids" widget="many2many_tags"
                                   invisible="node_type != 'approval'"
                                   required="node_type == 'approval'" />
                            <field name="approval_note"
                                   invisible="node_type != 'approval'" />
                            <field name="subflow_automation_id"
                                   invisible="node_type != 'subflow'"
                                   required="node_type == 'subflow'"
                                   options="{'no_create': True}" />
                        </group>

                        <group string="Dependency Info" colspan="2">
                            <field name="edge_in_ids" nolabel="1" colspan="2"
                                   context="{'default_target_node_id': id}">
                                <list editable="bottom">
                                    <field name="source_node_id"
                                        domain="[('automation_rule_id', '=', parent.automation_rule_id), ('id', '!=', parent.id)]"
                                        options="{'no_create': True}" />
                                    <field name="condition" />
                                    <field name="condition_expr"
                                        column_invisible="parent.usage != 'automation'"
                                        readonly="condition != 'expression'"
                                        required="condition == 'expression'" />
                                    <field name="label" optional="hide" />
                                </list>
                            </field>
                            <div class="text-muted small mt-1" colspan="2">
                                <i class="fa-solid fa-info-circle" />
                                This action executes once EVERY edge above is satisfied.
                            </div>

                            <field name="edge_out_ids" nolabel="1" colspan="2" readonly="1">
                                <list string="Enables">
                                    <field name="target_node_id" />
                                    <field name="condition" />
                                </list>
                            </field>
                        </group>
                    </group>

                    <separator string="How Dependencies Work" class="mt-4" />
                    <div class="alert alert-info" role="alert">
                        <ul class="mb-0">
                            <li><strong>No incoming edge:</strong> Action starts immediately (root action)</li>
                            <li><strong>One edge:</strong> Waits for that edge's condition to hold</li>
                            <li><strong>Several edges:</strong> Waits for ALL of them (AND join)</li>
                            <li><strong>On Error:</strong> lets a step handle the failure of another, instead of the run aborting</li>
                            <li><strong>Execution state</strong> is tracked per-run in <code>automation.runtime.line</code></li>
                        </ul>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="edge_in_ids">
                        <i class="fa-solid fa-triangle-exclamation" title="Warning" />
                        This is a <strong>root action</strong> — it starts as soon as the workflow runs.
                    </div>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
