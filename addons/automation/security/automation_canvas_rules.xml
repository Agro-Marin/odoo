<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Personal UI state: a reader sees their own viewport and nobody else's,
        including a reader who may configure every automation in the database.
    -->
    <record id="automation_canvas_viewport_own_rule" model="ir.rule">
        <field name="name">Workflow Canvas Viewport: own rows only</field>
        <field name="model_id" ref="model_automation_canvas_viewport" />
        <field name="global" eval="True" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

</odoo>
