<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="automation_runtime_company_rule" model="ir.rule">
        <field name="name">Automation Runtime: multi-company</field>
        <field name="model_id" ref="model_automation_runtime" />
        <field name="global" eval="True" />
        <field
            name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="automation_runtime_line_company_rule" model="ir.rule">
        <field name="name">Automation Runtime Line: multi-company</field>
        <field name="model_id" ref="model_automation_runtime_line" />
        <field name="global" eval="True" />
        <field
            name="domain_force">['|', ('runtime_id.company_id', '=', False),
                  ('runtime_id.company_id', 'in', company_ids)]</field>
    </record>

</odoo>
