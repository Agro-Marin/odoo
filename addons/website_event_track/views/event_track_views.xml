<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_visitor_action_from_track" model="ir.actions.act_window">
        <field name="name">Visitors Wishlist</field>
        <field name="res_model">website.visitor</field>
        <field name="view_mode">kanban,list,form,graph</field>
        <field name="domain">[('event_track_wishlisted_ids', 'in', [active_id])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Wait for visitors to add this track to their list of favorites
            </p>
        </field>
    </record>

    <record id="event_track_view_form_quick_create" model="ir.ui.view">
        <field name="name">event.track.view.form.quick.create</field>
        <field name="model">event.track</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field
                        name="event_id"
                        placeholder="All Events"
                        invisible="context.get('default_event_id', False)" />
                    <field name="name" placeholder="e.g. Inspiring Business Talk" />
                    <field name="date" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_event_track_kanban" model="ir.ui.view">
        <field name="name">event.track.kanban</field>
        <field name="model">event.track</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                highlight_color="color"
                quick_create_view="website_event_track.event_track_view_form_quick_create">
                <field name="website_url" />
                <templates>
                    <progressbar
                        field="kanban_state"
                        colors="{&quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}" />
                    <t t-name="menu" groups="base.group_user">
                        <a role="menuitem" t-att-href="record.website_url.value" class="dropdown-item">View Track</a>
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit Track</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <field name="color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-medium fs-5" />
                        <div t-if="duration" class="d-flex"><field name="duration" widget="float_time" />hours</div>
                        <field
                            name="tag_ids"
                            widget="many2many_tags"
                            options="{'color_field': 'color'}" />
                        <footer class="pt-0">
                            <div class="d-flex align-items-center">
                                <field name="priority" widget="priority" />
                                <field
                                    name="activity_ids"
                                    widget="kanban_activity"
                                    class="ms-1" />
                            </div>
                            <div class="d-flex ms-auto align-items-center">
                                <field
                                    name="kanban_state"
                                    widget="state_selection"
                                    groups="base.group_user" />
                                <div t-att-title="record.partner_id.value">
                                    <field
                                        name="partner_id"
                                        widget="image"
                                        options="{'preview_image': 'avatar_128'}"
                                        class="o_avatar rounded ms-1" />
                                </div>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_event_track_calendar" model="ir.ui.view">
        <field name="name">event.track.calendar</field>
        <field name="model">event.track</field>
        <field name="priority" eval="2" />
        <field name="arch" type="xml">
            <calendar
                string="Event Tracks"
                color="location_id"
                date_start="date"
                date_stop="date_end"
                event_limit="5">
                <field name="location_id" filters="1" />
                <field name="event_id" />
                <field name="partner_id" avatar_field="avatar_128" />
                <field name="user_id" avatar_field="avatar_128" />
            </calendar>
        </field>
    </record>

    <record id="view_event_track_search" model="ir.ui.view">
        <field name="name">event.track.search</field>
        <field name="model">event.track</field>
        <field name="arch" type="xml">
            <search string="Event Tracks">
                <field name="name" />
                <field name="tag_ids" />
                <field
                    name="partner_id"
                    string="Speaker"
                    filter_domain="[                     '|', '|', '|', '|',                     ('partner_id', 'ilike', self), ('partner_name', 'ilike', self),                     ('contact_email', 'ilike', self), ('partner_email', 'ilike', self), ('partner_company_name', 'ilike', self)]" />
                <field name="location_id" />
                <field name="event_id" />
                <field name="stage_id" />
                <filter
                    name="my_tracks"
                    string="My Tracks"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter
                    name="filter_published"
                    string="Published"
                    domain="[('website_published', '=', True)]" />
                <separator />
                <filter
                    name="message_needaction"
                    string="Unread Messages"
                    domain="[('message_needaction', '=', True)]"
                    groups="mail.group_mail_notification_type_inbox" />
                <separator />
                <filter
                    name="filter_wishlisted_by_default"
                    string="Always Wishlisted"
                    domain="[('wishlisted_by_default', '=', True)]" />
                <separator />
                <filter name="filter_date" date="date" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <separator />
                <filter
                    name="filter_activities_my"
                    string="My Activities"
                    domain="[('activity_user_id', '=', uid)]"
                    invisible="1" />
                <separator invisible="1" />
                <filter
                    name="activities_overdue"
                    string="Late Activities"
                    help="Show all records whose next activity date is past"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                    invisible="1" />
                <filter
                    name="activities_today"
                    string="Today Activities"
                    domain="[('my_activity_date_deadline', '=', 'today')]"
                    invisible="1" />
                <filter
                    name="activities_upcoming_all"
                    string="Future Activities"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                    invisible="1" />
                <group>
                    <filter
                        name="responsible"
                        string="Responsible"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="stage"
                        string="Stage"
                        context="{'group_by': 'stage_id'}" />
                    <filter name="date" string="Date" context="{'group_by': 'date'}" />
                    <filter
                        name="event"
                        string="Event"
                        context="{'group_by': 'event_id'}" />
                    <filter
                        name="location"
                        string="Location"
                        context="{'group_by': 'location_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_event_track_form" model="ir.ui.view">
        <field name="name">event.track.form</field>
        <field name="model">event.track</field>
        <field name="arch" type="xml">
            <form string="Event Track">
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': '1'}" />
                </header>
                <sheet string="Track">
                    <div class="oe_button_box" name="button_box">
                        <field name="website_url" invisible="1" />
                        <field name="wishlist_visitor_count" invisible="1" />
                        <button
                            name="%(website_event_track.website_visitor_action_from_track)d"
                            type="action"
                            icon="fa-bell"
                            groups="event.group_event_user"
                            invisible="wishlist_visitor_count == 0"
                            class="oe_stat_button">
                            <field
                                name="wishlist_visitor_count"
                                string="Wishlisted By"
                                widget="statinfo" />
                        </button>
                        <field name="is_published" widget="website_redirect_button" />
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="d-flex gap-4 mb-3">
                        <div class="flex-grow-1">
                            <label for="name" />
                            <h1>
                                <field
                                    name="name"
                                    placeholder="e.g. Inspiring Business Talk"
                                    class="w-sm-75" />
                            </h1>
                        </div>
                        <field name="website_image" widget="image" class="oe_avatar" />
                        <field name="kanban_state" widget="state_selection" />
                    </div>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="location_id" />
                            <field name="duration" widget="float_time" />
                            <field name="active" invisible="1" />
                            <field name="wishlisted_by_default" />
                        </group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                domain="[('share', '=', False)]" />
                            <field name="event_id" placeholder="All Events" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}" />
                            <field name="color" widget="color_picker" />
                        </group>
                    </group>
                    <notebook>
                        <page name="speaker" string="Speaker">
                            <group
                                string="Contact Details"
                                class="display-flex justify-content-between">
                                <group>
                                    <field
                                        name="partner_id"
                                        context="{'default_email': contact_email}" />
                                    <field name="contact_email" readonly="partner_id" />
                                    <field
                                        name="contact_phone_ids"
                                        widget="many2many_tags"
                                        readonly="partner_id"
                                        class="o_force_ltr" />
                                </group>
                            </group>
                            <group
                                string="Speaker Bio"
                                class="display-flex justify-content-between">
                                <group>
                                    <field name="partner_name" />
                                    <field name="partner_email" />
                                    <field
                                        name="phone_ids"
                                        widget="many2many_tags"
                                        class="o_force_ltr" />
                                    <field name="partner_function" />
                                    <field name="partner_company_name" />
                                </group>
                                <group>
                                    <field
                                        name="image"
                                        widget="image"
                                        nolabel="1"
                                        class="oe_avatar" />
                                </group>
                            </group>
                            <group>
                                <field
                                    name="partner_biography"
                                    string="Biography"
                                    placeholder="e.g. &quot;John Doe was born in...&quot;" />
                            </group>
                        </page>
                        <page name="description" string="Description">
                            <field
                                name="description"
                                placeholder="e.g. &quot;This talk will be about...&quot;" />
                        </page>
                        <page name="interactivity" string="Interactivity">
                            <group>
                                <group name="event_track_cta_group">
                                    <field name="website_cta" />
                                    <field
                                        name="website_cta_title"
                                        placeholder="e.g. Get Yours Now!"
                                        invisible="not website_cta"
                                        required="website_cta" />
                                    <field
                                        name="website_cta_url"
                                        placeholder="e.g. http://www.example.com"
                                        invisible="not website_cta"
                                        required="website_cta" />
                                    <label
                                        for="website_cta_delay"
                                        invisible="not website_cta" />
                                    <div invisible="not website_cta">
                                        <field name="website_cta_delay" required="website_cta" class="oe_inline" /> minutes after Track start
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True" />
            </form>
        </field>
    </record>

    <record id="view_event_track_tree" model="ir.ui.view">
        <field name="name">event.track.list</field>
        <field name="model">event.track</field>
        <field name="arch" type="xml">
            <list string="Event Track" multi_edit="1">
                <field name="name" />
                <field name="active" column_invisible="True" />
                <field name="partner_name" string="Speaker Name" />
                <field name="partner_id" optional="hide" />
                <field name="partner_email" optional="hide" />
                <field name="phone_ids" widget="many2many_tags" optional="hide" />
                <field
                    name="event_id"
                    column_invisible="context.get('default_event_id')" />
                <field name="wishlisted_by_default" optional="hide" />
                <field name="wishlist_visitor_count" optional="hide" />
                <field name="stage_id" />
                <field name="color" string="Color" widget="color_picker" />
                <field
                    name="activity_exception_decoration"
                    widget="activity_exception" />
                <field name="location_id" />
            </list>
        </field>
    </record>

    <record id="view_event_track_graph" model="ir.ui.view">
        <field name="name">event.track.graph</field>
        <field name="model">event.track</field>
        <field name="arch" type="xml">
            <graph string="Tracks" sample="1">
                <field name="location_id" />
                <field name="duration" operator="+" />
                <field name="website_cta_delay" invisible="1" />
                <field name="color" invisible="1" />
            </graph>
        </field>
    </record>

    <record id="action_event_track" model="ir.actions.act_window">
        <field name="name">Event Tracks</field>
        <field name="res_model">event.track</field>
        <field name="view_mode">kanban,list,form,calendar,graph,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Track
            </p><p>
                Tracks define your event schedule. They can be talks, workshops or any similar activity.
            </p>
        </field>
    </record>

    <record id="action_event_track_from_event" model="ir.actions.act_window">
        <field name="name">Event Tracks</field>
        <field name="res_model">event.track</field>
        <field name="view_mode">kanban,list,form,calendar,graph,activity</field>
        <field
            name="context">{'search_default_event_id': active_id, 'default_event_id': active_id}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Track
            </p><p>
                Tracks define your event schedule. They can be talks, workshops or any similar activity.
            </p>
        </field>
    </record>

    <record id="event_track_action_from_visitor" model="ir.actions.act_window">
        <field name="name">Wishlisted Tracks</field>
        <field name="res_model">event.track</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('wishlist_visitor_ids', 'in', [active_id])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No track favorited by this visitor
            </p>
        </field>
    </record>

</odoo>
