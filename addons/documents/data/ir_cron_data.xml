<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.cron" forcecreate="True" id="ir_cron_documents_access_tracking">
        <field name="name">Documents: Access Tracking</field>
        <field name="model_id" ref="model_documents_access_tracking" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_tracking()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
    </record>
    <record model="ir.cron" forcecreate="True" id="ir_cron_url_preview">
        <field name="name">Documents: Fetch URL previews</field>
        <field name="model_id" ref="model_documents_document" />
        <field name="state">code</field>
        <field name="code">model._cron_update_url_preview()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
