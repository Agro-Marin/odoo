<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="document_inbox_folder_mail_alias" model="mail.alias" forcecreate="0">
        <field name="alias_name">inbox</field>
        <field name="alias_model_id" ref="documents.model_documents_document" />
        <!-- alias_parent_model_id is required alongside alias_parent_thread_id:
             without it, "Open Parent Document" stays hidden and
             mail_thread._alias_get_error / open_parent_document() resolve to an
             empty recordset instead of the Inbox folder. -->
        <field name="alias_parent_model_id" ref="documents.model_documents_document" />
        <field name="alias_parent_thread_id" ref="documents.document_inbox_folder" />
        <field name="alias_defaults" eval="{'folder_id': ref('documents.document_inbox_folder')}" />
    </record>

    <record id="documents.document_inbox_folder" model="documents.document" forcecreate="0">
        <field name="alias_id" ref="documents.document_inbox_folder_mail_alias" />
    </record>

</odoo>