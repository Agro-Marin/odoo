<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_group_view_list" model="ir.ui.view">
        <field name="name">mail.group.view.list</field>
        <field name="model">mail.group</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" width="100%" />
                <field name="member_count" string="#Members" width="100%" />
                <field
                    name="mail_group_message_count"
                    string="#Messages"
                    width="100%" />
                <field
                    name="mail_group_message_moderation_count"
                    string="#To Review"
                    width="100%" />
            </list>
        </field>
    </record>

    <record id="mail_group_view_kanban" model="ir.ui.view">
        <field name="name">mail.group.view.kanban</field>
        <field name="model">mail.group</field>
        <field name="arch" type="xml">
            <kanban string="Mail Groups" sample="1">
                <field name="is_member" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="image_128" widget="image" alt="Group" />
                        </aside>
                        <main class="ms-2 d-flex flex-column">
                            <widget
                                name="web_ribbon"
                                title="Closed"
                                invisible="not is_closed"
                                bg_color="text-bg-danger" />
                            <span class="fw-bold fs-5">#<field name="name" /></span>
                            <field
                                name="description"
                                class="text-truncate text-nowrap d-block" />
                            <div class="d-flex flex-row mt-2">
                                <a
                                    class="text-truncate"
                                    t-if="record.mail_group_message_moderation_count.raw_value"
                                    name="%(mail_group.mail_group_message_action)d"
                                    type="action"
                                    context="{'search_default_mail_group_id': id, 'search_default_moderation_status': 'pending_moderation'}">
                                    <field name="mail_group_message_moderation_count" />
                                    messages to review
                                </a>
                                <div class="text-end ms-auto">
                                    <button name="action_join" type="object" invisible="is_member or is_closed" class="btn btn-primary ms-auto">Join
                                    </button>
                                    <button name="action_leave" type="object" invisible="not is_member" class="btn btn-secondary ms-auto">Leave
                                    </button>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mail_group_view_form" model="ir.ui.view">
        <field name="name">mail.group.view.form</field>
        <field name="model">mail.group</field>
        <field name="arch" type="xml">
            <form string="Mail Group">
                <header>
                    <button
                        name="action_join"
                        type="object"
                        string="Join"
                        invisible="is_member or is_closed"
                        class="btn btn-primary" />
                    <button
                        name="action_leave"
                        type="object"
                        string="Leave"
                        invisible="not is_member"
                        class="btn btn-secondary" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Closed"
                        invisible="not is_closed"
                        bg_color="text-bg-danger" />
                    <div
                        class="oe_button_box"
                        name="button_box"
                        groups="base.group_user"
                        invisible="not can_manage_group">
                        <button
                            name="%(mail_group.mail_group_member_action)d"
                            type="action"
                            help="Members of this group"
                            icon="fa-users"
                            context="{'search_default_mail_group_id': id}"
                            class="oe_stat_button">
                            <field
                                name="member_count"
                                string="Members"
                                widget="statinfo" />
                        </button>
                        <button
                            name="%(mail_group.mail_group_message_action)d"
                            type="action"
                            help="All messages of this group"
                            icon="fa-envelope"
                            context="{'search_default_mail_group_id': id}"
                            class="oe_stat_button">
                            <field
                                name="mail_group_message_count"
                                string="Emails"
                                widget="statinfo" />
                            </button>
                            <button
                                name="%(mail_group.mail_group_message_action)d"
                                type="action"
                                help="Emails waiting an action for this group"
                                icon="fa-regular fa-comment-dots"
                                context="{'search_default_mail_group_id': id, 'search_default_moderation_status': 'pending_moderation'}"
                                invisible="not (moderation and mail_group_message_moderation_count != 0)"
                                class="oe_stat_button">
                                <field
                                    name="mail_group_message_moderation_count"
                                    string="To Review"
                                    widget="statinfo" />
                            </button>
                            <button
                                name="%(mail_group.mail_group_moderation_action)d"
                                type="action"
                                help="Moderated emails in this group"
                                icon="fa-gavel"
                                context="{'search_default_mail_group_id': id}"
                                invisible="not (moderation and moderation_rule_count != 0)"
                                class="oe_stat_button">
                                <field
                                    name="moderation_rule_count"
                                    string="Moderations"
                                    widget="statinfo" />
                            </button>
                    </div>
                    <field
                        name="image_128"
                        widget="image"
                        options="{'size': [90, 90]}"
                        class="oe_avatar" />
                    <div class="oe_title mb24">
                        <label for="name" string="Group Name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. &quot;Newsletter&quot;"
                                default_focus="1"
                                class="oe_inline" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <label for="alias_name" string="Email Alias" />
                            <div class="oe_inline" name="alias_def">
                                <field
                                    name="alias_id"
                                    string="Email Alias"
                                    required="0"
                                    class="oe_read_only oe_inline" />
                                <div
                                    class="oe_inline"
                                    name="edit_alias"
                                    style="display: inline;">
                                    <div class="oe_edit_only" dir="ltr">
                                        <field name="alias_name" placeholder="alias" class="oe_inline" />@
                                        <field
                                            name="alias_domain_id"
                                            placeholder="e.g. mycompany.com"
                                            options="{'no_create': True, 'no_open': True}"
                                            class="oe_inline" />
                                    </div>
                                    <button
                                        name="%(web.action_general_configuration)d"
                                        type="action"
                                        string="Choose or configure a custom domain"
                                        icon="oi-arrow-right"
                                        invisible="alias_domain_id"
                                        class="p-0 btn-link" />
                                </div>
                            </div>
                            <field
                                name="description"
                                placeholder="e.g. &quot;This group is about ...&quot;" />
                            <field name="moderation" />
                            <td class="o_td_label">
                                <label
                                    for="moderator_ids"
                                    string="Moderators"
                                    invisible="not moderation" />
                                <label
                                    for="moderator_ids"
                                    string="Responsibles"
                                    invisible="moderation" />
                            </td>
                            <field
                                name="moderator_ids"
                                placeholder="Select users"
                                widget="many2many_avatar_user"
                                nolabel="1"
                                class="oe_inline" />
                            <field name="is_moderator" invisible="1" />
                            <field name="can_manage_group" invisible="1" />
                            <field name="is_member" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="privacy" string="Privacy">
                            <group>
                                <group>
                                    <field name="access_mode" widget="radio" />
                                    <field
                                        name="access_group_id"
                                        invisible="access_mode != 'groups'"
                                        required="access_mode == 'groups'" />
                                    <field name="alias_contact" invisible="1" />
                                </group>
                            </group>
                        </page>
                        <page
                            name="moderation"
                            string="Notify Members"
                            invisible="not moderation">
                            <group>
                                <field name="moderation_notify" />
                                <field
                                    name="moderation_notify_msg"
                                    invisible="not moderation_notify"
                                    required="moderation_notify" />
                            </group>
                        </page>
                        <page name="guidelines" string="Guidelines">
                            <group>
                                <field name="moderation_guidelines" />
                                <field
                                    name="moderation_guidelines_msg"
                                    placeholder="e.g.&quot;Please be polite and ...&quot;"
                                    required="moderation_guidelines" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_group_view_search" model="ir.ui.view">
        <field name="name">mail.group.view.search</field>
        <field name="model">mail.group</field>
        <field name="arch" type="xml">
            <search string="Search Mail group">
                <field name="name" />
                <field name="alias_email" />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <filter
                    name="moderation"
                    string="Moderated"
                    domain="[('moderation', '=', True)]" />
                <group>
                    <filter
                        name="Moderation"
                        string="Moderation"
                        context="{'group_by':'moderation'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="mail_group_action" model="ir.actions.act_window">
        <field name="name">Mail Groups</field>
        <field name="res_model">mail.group</field>
        <field name="path">mail-groups</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Mail Group</p>
            <p>Mailing groups are communities that like to discuss a specific topic together.</p>
        </field>
    </record>

</odoo>
