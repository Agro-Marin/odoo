<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!--
            `company_id` is computed from the record the proposal points at. Without
            this rule it is stored and read by nothing, and a queue built from one
            company's records is visible from every other one. `data_cleaning`
            carries the same rule for its own twin of this model.
        -->
        <record id="data_recycle_record_multi_company" model="ir.rule">
            <field name="name">Data Recycle Record multi company rule</field>
            <field name="model_id" ref="model_data_recycle_record" />
            <field name="global" eval="True" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>

</odoo>
