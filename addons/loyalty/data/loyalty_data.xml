<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Basic product for gift card program -->
        <record id="gift_card_product_50" model="product.product">
            <field name="name">Gift Card</field>
            <field name="list_price">50</field>
            <field name="type">service</field>
            <field name="purchase_ok" eval="False" />
            <field
                name="categ_id"
                eval="ref('product.product_category_services', raise_if_not_found=False)" />
            <field
                name="image_1920"
                type="base64"
                file="loyalty/static/img/gift_card.png" />
        </record>
        <!-- Basic product for eWallet programs -->
        <record id="ewallet_product_50" model="product.product">
            <field name="name">Top-up eWallet</field>
            <field name="list_price">50</field>
            <field name="type">service</field>
            <field name="purchase_ok" eval="False" />
            <field
                name="categ_id"
                eval="ref('product.product_category_services', raise_if_not_found=False)" />
        </record>
        <!--
            Off by default: the reward's discounted products are handed to the
            client as a domain rather than resolved here with one search per
            reward. See `loyalty.reward._expands_discount_products`.
        -->
        <record
            forcecreate="0"
            id="config_compute_all_discount_product_ids"
            model="ir.config_parameter">
            <field name="key">loyalty.compute_all_discount_product_ids</field>
            <field name="value">False</field>
        </record>
    </data>

    <!--
        Gift Cards.

        Its rule and reward are not declared here: they are exactly what
        `_program_type_default_values()['gift_card']` builds, and `create` applies
        them. Declaring them again produced a second rule and a second reward,
        which `pos_loyalty` refuses to open a session with.
    -->
    <record id="gift_card_program" model="loyalty.program">
        <field name="name">Gift Cards</field>
        <field name="program_type">gift_card</field>
        <field name="applies_on">future</field>
        <field name="trigger">auto</field>
        <field name="portal_visible">True</field>
        <field name="portal_point_name">$</field>
        <field name="mail_template_id" ref="loyalty.mail_template_gift_card" />
    </record>

</odoo>
