<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- tags internal -->
    <record id="documents_tag_hr" model="document.tag" forcecreate="0">
        <field name="name">HR</field>
        <field name="sequence">9</field>
    </record>

    <record id="documents_tag_legal" model="document.tag" forcecreate="0">
        <field name="name">Legal</field>
        <field name="sequence">9</field>
    </record>

    <record id="documents_tag_contracts" model="document.tag" forcecreate="0">
        <field name="name">Contracts</field>
        <field name="sequence">10</field>
    </record>

    <!-- tags finance -->
    <record id="documents_tag_year_current" model="document.tag" forcecreate="0">
        <field name="name" eval="str(datetime.now().year)" />
        <field name="sequence">10</field>
    </record>

    <record id="documents_tag_year_previous" model="document.tag" forcecreate="0">
        <field name="name" eval="str(datetime.now().year-1)" />
        <field name="sequence">11</field>
    </record>

</odoo>
