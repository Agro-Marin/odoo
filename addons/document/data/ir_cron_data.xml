<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_documents_access_tracking" model="ir.cron" forcecreate="True">
        <field name="name">Documents: Access Tracking</field>
        <field name="model_id" ref="model_document_access_tracking" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_tracking()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">month</field>
    </record>

    <record id="ir_cron_url_preview" model="ir.cron" forcecreate="True">
        <field name="name">Documents: Fetch URL previews</field>
        <field name="model_id" ref="model_document_document" />
        <field name="state">code</field>
        <field name="code">model._cron_update_url_preview()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
    </record>

    <record id="ir_cron_document_expiration_refresh" model="ir.cron" forcecreate="True">
        <field name="name">Documents: Refresh expiration state</field>
        <field name="model_id" ref="model_document_document" />
        <field name="state">code</field>
        <field name="code">model._cron_refresh_expiration_state()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
    </record>

</odoo>
