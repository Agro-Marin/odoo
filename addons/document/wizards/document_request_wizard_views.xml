<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_request_form_view" model="ir.ui.view">
        <field name="name">Request File</field>
        <field name="model">document.request_wizard</field>
        <field name="priority" eval="6" />
        <field name="arch" type="xml">
            <form class="o_document_request_wizard">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Document Name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Missing Expense"
                                required="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="requestee_id"
                                string="Request To"
                                widget="many2one_avatar"
                                required="1" />
                            <field name="partner_id" groups="base.group_no_one" />
                            <label for="activity_date_deadline_range" />
                            <div class="o_row">
                                <field name="activity_date_deadline_range" />
                                <field
                                    name="activity_date_deadline_range_type"
                                    required="1" />
                            </div>
                            <field name="activity_type_id" groups="base.group_no_one" />
                            <field
                                name="res_model"
                                groups="base.group_no_one"
                                readonly="1" />
                            <field
                                name="res_id"
                                groups="base.group_no_one"
                                readonly="1" />
                        </group>
                        <group>
                            <field
                                name="folder_id"
                                widget="documents_folder_many2one"
                                options="{'no_create_edit': True, 'no_create': True, 'no_open': True}" />
                            <field name="tag_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <label for="activity_note" />
                    <field
                        name="activity_note"
                        placeholder="Extra comments..."
                        class="embedded-editor-height-4" />
                    <footer>
                        <button
                            name="request_document"
                            type="object"
                            string="Request"
                            class="btn btn-primary"
                            data-hotkey="q" />
                        <button
                            special="cancel"
                            string="Discard"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_request_form" model="ir.actions.act_window">
        <field name="name">Request a file</field>
        <field name="res_model">document.request_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="context">{'form_view_ref': 'document.documents_request_form_view'}</field>
    </record>

</odoo>
