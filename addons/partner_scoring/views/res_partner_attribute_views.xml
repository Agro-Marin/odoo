<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_attribute_view_list" model="ir.ui.view">
        <field name="name">res.partner.attribute.list</field>
        <field name="model">res.partner.attribute</field>
        <field name="arch" type="xml">
            <list string="Contact Attributes">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="value_type" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="res_partner_attribute_view_form" model="ir.ui.view">
        <field name="name">res.partner.attribute.form</field>
        <field name="model">res.partner.attribute</field>
        <field name="arch" type="xml">
            <form string="Contact Attribute">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Customer type" />
                        </h1>
                    </div>
                    <group>
                        <field name="value_type" />
                        <field name="sequence" />
                        <field
                            name="aggregation_mode"
                            groups="partner_scoring.group_partner_scoring_manager" />
                        <field name="active" invisible="1" />
                    </group>
                    <notebook>
                        <page name="values" string="Values">
                            <field name="value_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field
                                        name="score_value"
                                        groups="partner_scoring.group_partner_scoring_manager" />
                                    <field
                                        name="color"
                                        widget="color_picker"
                                        optional="hide" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_attribute_view_search" model="ir.ui.view">
        <field name="name">res.partner.attribute.search</field>
        <field name="model">res.partner.attribute</field>
        <field name="arch" type="xml">
            <search string="Contact Attributes">
                <field name="name" />
                <group>
                    <filter
                        name="group_by_value_type"
                        string="Value Type"
                        context="{'group_by': 'value_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="res_partner_attribute_action" model="ir.actions.act_window">
        <field name="name">Contact Attributes</field>
        <field name="res_model">res.partner.attribute</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an attribute</p>
            <p>
                Contact attributes (EAV) define the dimensions of a contact's
                commercial profile -- customer type, price sensitivity, social
                networks and so on. Each attribute carries its own set of values.
            </p>
        </field>
    </record>

</odoo>
