<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_metrics_rule" model="ir.rule">
        <field name="name">Approval Metrics: multi-company</field>
        <field
            name="model_id"
            model="ir.model"
            search="[('model','=','approval.metrics')]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="approver_performance_rule" model="ir.rule">
        <field name="name">Approver Performance: multi-company</field>
        <field
            name="model_id"
            model="ir.model"
            search="[('model','=','approver.performance')]" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
