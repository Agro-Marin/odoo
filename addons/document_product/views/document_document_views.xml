<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- documents search view -->
    <record id="document_view_search_inherit_documents_product" model="ir.ui.view">
        <field name="name">document.view.search.inherit.documents_product</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.document_view_search" />
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="product_template_id" />
                <field name="product_id" />
            </field>
        </field>
    </record>

</odoo>
