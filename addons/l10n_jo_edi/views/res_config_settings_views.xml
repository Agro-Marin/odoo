<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath
                    expr="//field[@name='tax_calculation_rounding_method']"
                    position="attributes">
                    <attribute
                        name="readonly"
                        add="country_code == 'JO'"
                        separator="or" />
                </xpath>

                <xpath expr="//block[@id='invoicing_settings']" position="after">
                    <block
                        id="l10n_jo_co_settings"
                        title="Electronic Invoicing (Jordan)"
                        invisible="country_code != 'JO'">
                        <setting
                            string="JoFotara Credentials"
                            help="Configure your Production credentials here">
                            <div class="content-group">
                                <div class="row">
                                    <label
                                        for="l10n_jo_edi_sequence_income_source"
                                        string="Activity Number"
                                        class="o_light_label col-lg-4" />
                                    <field name="l10n_jo_edi_sequence_income_source" />
                                </div>
                                <div class="row">
                                    <label
                                        for="l10n_jo_edi_secret_key"
                                        string="Secret Key"
                                        class="col-lg-4 o_light_label" />
                                    <field name="l10n_jo_edi_secret_key" />
                                </div>
                                <div class="row">
                                    <label
                                        for="l10n_jo_edi_client_identifier"
                                        string="Client ID"
                                        class="col-lg-4 o_light_label" />
                                    <field name="l10n_jo_edi_client_identifier" />
                                </div>
                                <div class="row">
                                    <label
                                        for="l10n_jo_edi_taxpayer_type"
                                        string="Taxpayer Type"
                                        class="col-lg-4 o_light_label" />
                                    <field name="l10n_jo_edi_taxpayer_type" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_jo_edi_demo_mode"
                            help="Activate this mode to test the electronic invoicing flows with internal validations only"
                            groups="base.group_no_one">
                            <field name="l10n_jo_edi_demo_mode" string="Demo Mode" />
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
