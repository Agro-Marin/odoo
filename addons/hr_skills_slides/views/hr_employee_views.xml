<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.resume.slides</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="priority" eval="45" />
        <field name="arch" type="xml">
            <button name="action_view_versions" position="before">
                <field
                    name="has_subscribed_courses"
                    groups="website_slides.group_website_slides_officer"
                    invisible="1" />
                <button
                    name="action_view_courses"
                    type="object"
                    icon="fa-graduation-cap"
                    groups="website_slides.group_website_slides_officer"
                    invisible="not user_id or not has_subscribed_courses"
                    class="oe_stat_button">
                    <field
                        name="courses_completion_text"
                        string="Courses"
                        widget="statinfo" />
                </button>
            </button>
        </field>
    </record>

    <record id="hr_employee_resume_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.resume.slides</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_skills.hr_employee_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='external_url']" position="after">
                <field name="course_url" />
            </xpath>
        </field>
    </record>

</odoo>
