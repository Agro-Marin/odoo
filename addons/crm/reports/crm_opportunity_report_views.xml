                    groups="!crm.group_use_recurring_revenues"
                    invisible="1" />
            </graph>
        </field>
    </record>

    <!-- Opportunities by user and team Search View -->
    <record id="crm_opportunity_report_view_search" model="ir.ui.view">
        <field name="name">crm.lead.search</field>
        <field name="model">crm.lead</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search string="Opportunities Analysis">
                <filter
                    name="my"
                    string="My Pipeline"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter
                    name="filter_opportunity"
                    string="Opportunities"
                    help="Show only opportunities"
                    domain="[('type','=','opportunity')]"
                    groups="crm.group_use_lead" />
                <filter
                    name="filter_lead"
                    string="Leads"
                    help="Show only leads"
                    domain="[('type','=', 'lead')]"
                    groups="crm.group_use_lead" />
                <separator />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="filter_inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]" />
                <filter
                    name="filter_won_status_won"
                    string="Won"
                    domain="[('won_status', '=', 'won')]" />
                <filter
                    name="filter_won_status_lost"
                    string="Lost"
                    domain="[('won_status', '=', 'lost')]" />
                <field name="team_id" context="{'invisible_team': False}" />
                <field name="user_id" string="Salesperson" />
                <separator />
                <filter
                    name="filter_create_date"
                    date="create_date"
                    default_period="year" />
                <filter
                    name="filter_date_deadline"
                    string="Expected Closing"
                    date="date_deadline" />
                <filter
                    name="date_closed_filter"
                    string="Date Closed"
                    date="date_closed" />
                <group>
                    <field
                        name="partner_id"
                        filter_domain="[('partner_id','child_of',self)]" />
                    <field
                        name="stage_id"
                        domain="['|', ('team_ids', '=', False), ('team_ids', 'in', 'team_id')]" />
                    <field name="campaign_id" />
                    <field name="medium_id" />
                    <field name="source_id" />
                    <field
                        name="company_id"
                        options="{'no_create': True}"
                        groups="base.group_multi_company" />
                    <newline />
                    <field name="create_date" />
                    <field name="date_open" />
                    <field name="date_closed" />
                </group>
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="salesperson"
                        string="Salesperson"
                        context="{'group_by':'user_id'}" />
                    <filter
                        name="saleschannel"
                        string="Sales Team"
                        context="{'group_by':'team_id'}" />
                    <filter name="city" string="City" context="{'group_by':'city'}" />
                    <filter
                        name="country"
                        string="Country"
                        context="{'group_by':'country_id'}" />
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by':'company_id'}"
                        groups="base.group_multi_company" />
                    <filter
                        name="stage"
                        string="Stage"
                        context="{'group_by':'stage_id'}" />
                    <filter
                        name="campaign"
                        string="Campaign"
                        context="{'group_by':'campaign_id'}" />
                    <filter
                        name="medium"
                        string="Medium"
                        context="{'group_by':'medium_id'}" />
                    <filter
                        name="source"
                        string="Source"
                        context="{'group_by':'source_id'}" />
                    <separator orientation="vertical" />
                    <filter
                        name="month"
                        string="Creation Date"
                        context="{'group_by':'create_date:month'}" />
                    <filter
                        name="conversion_date"
                        string="Conversion Date"
                        help="Conversion Date from Lead to Opportunity"
                        context="{'group_by':'date_conversion:month'}"
                        groups="crm.group_use_lead" />
                    <filter
                        name="date_deadline"
                        string="Expected Closing"
                        context="{'group_by':'date_deadline:month'}" />
                    <filter
                        name="date_closed_groupby"
                        string="Closed Date"
                        context="{'group_by':'date_closed'}" />
                    <filter
                        name="lostreason"
                        string="Lost Reason"
                        context="{'group_by':'lost_reason_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="crm_lead_view_tree_reporting" model="ir.ui.view">
        <field name="name">crm.lead.list.lead.reporting</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads" />
        <field name="mode">primary</field>
        <field name="priority">24</field>
        <field name="arch" type="xml">
            <xpath expr="field[@name='city']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="field[@name='probability']" position="before">
                <field name="type" optional="show" groups="crm.group_use_lead" />
                <field name="stage_id" optional="show" />
            </xpath>
            <xpath expr="field[@name='probability']" position="after">
                <field name="lost_reason_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="crm_opportunity_report_action" model="ir.actions.act_window">
        <field name="name">Pipeline Analysis</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="crm.crm_opportunity_report_view_search" />
        <field
            name="context">{'search_default_filter_opportunity': True, 'search_default_current': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data found!
            </p><p>
                Use this menu to have an overview of your Pipeline.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('crm_opportunity_report_view_graph')}), Command.create({'view_mode': 'pivot', 'view_id': ref('crm_opportunity_report_view_pivot')}), Command.create({'view_mode': 'list', 'view_id': ref('crm_lead_view_tree_opportunity_reporting')})]" />
    </record>

    <record id="crm_opportunity_report_action_lead" model="ir.actions.act_window">
        <field name="name">Leads Analysis</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="crm.crm_opportunity_report_view_search" />
        <field
            name="context">{
                'search_default_filter_active': 1,
                'search_default_filter_inactive': 1,
                'search_default_filter_create_date': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data found!
            </p><p>
                This analysis shows you how many leads have been created per month.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('crm_opportunity_report_view_graph_lead')}), Command.create({'view_mode': 'pivot', 'view_id': ref('crm_opportunity_report_view_pivot_lead')}), Command.create({'view_mode': 'form', 'view_id': ref('crm_lead_view_form')}), Command.create({'view_mode': 'list', 'view_id': ref('crm_lead_view_tree_reporting')})]" />
    </record>

</odoo>
