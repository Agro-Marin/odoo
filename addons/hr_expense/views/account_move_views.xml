<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_move_form_inherit_expense" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                        name="action_view_expense"
                        type="object"
                        icon="fa-regular fa-file-lines"
                        invisible="nb_expenses == 0"
                        class="oe_stat_button">
                        <field name="nb_expenses" string="Expenses" widget="statinfo" />
                    </button>
                </xpath>
            </field>
        </record>
        <record id="view_move_list_expense" model="ir.ui.view">
            <field name="name">account.move.hr.expense.list</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list
                    sample="1"
                    decoration-info="state == 'draft'"
                    decoration-muted="state == 'cancel'"
                    js_class="account_tree">
                    <field name="made_sequence_gap" column_invisible="True" />
                    <field
                        name="name"
                        placeholder="/"
                        widget="char_with_placeholder_field"
                        decoration-bf="1"
                        decoration-danger="made_sequence_gap and state == 'posted'" />
                    <field
                        name="partner_id"
                        string="Partner"
                        optional="show"
                        readonly="True" />
                    <field
                        name="date"
                        string="Accounting Date"
                        optional="hide"
                        readonly="state in ['cancel', 'posted']" />
                    <field
                        name="invoice_date_due"
                        widget="remaining_days"
                        optional="show"
                        invisible="payment_state in ('paid', 'in_payment', 'reversed') or state == 'cancel'" />
                    <field
                        name="invoice_origin"
                        string="Source Document"
                        optional="hide" />
                    <field name="payment_reference" optional="hide" />
                    <field name="ref" optional="hide" />
                    <field name="activity_ids" widget="list_activity" optional="hide" />
                    <field
                        name="company_id"
                        optional="hide"
                        options="{'no_create': True}"
                        groups="base.group_multi_company" />
                    <field
                        name="company_id"
                        groups="!base.group_multi_company"
                        column_invisible="True" />
                    <field
                        name="amount_untaxed_in_currency_signed"
                        string="Tax Excluded"
                        optional="show"
                        sum="Total" />
                    <field
                        name="amount_tax_signed"
                        string="Tax"
                        optional="hide"
                        sum="Total" />
                    <field
                        name="amount_total_in_currency_signed"
                        string="Total"
                        optional="show"
                        sum="Total"
                        groups="base.group_multi_currency"
                        decoration-bf="1"
                        decoration-warning="abnormal_amount_warning" />
                    <field
                        name="amount_total_in_currency_signed"
                        string="Total"
                        optional="hide"
                        sum="Total"
                        groups="!base.group_multi_currency"
                        decoration-bf="1"
                        decoration-warning="abnormal_amount_warning" />
                    <field
                        name="amount_residual_signed"
                        string="Amount Due"
                        optional="hide"
                        sum="Amount Due" />
                    <field
                        name="currency_id"
                        optional="hide"
                        readonly="state in ['cancel', 'posted']" />
                    <field name="company_currency_id" column_invisible="True" />
                    <field name="checked" widget="boolean_toggle" optional="hide" />
                    <field
                        name="display_state"
                        string="Status"
                        widget="badge"
                        optional="show"
                        invisible="payment_state == 'invoicing_legacy' or move_type == 'entry'"
                        decoration-danger="display_state == 'cancel'"
                        decoration-info="display_state == 'draft'"
                        decoration-muted="display_state in ('posted', 'sent', 'partial')"
                        decoration-success="display_state in ('in_payment', 'paid', 'reversed')" />
                </list>
            </field>
        </record>
    </data>

</odoo>
