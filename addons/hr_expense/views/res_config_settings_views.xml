<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.expense</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="priority" eval="85" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app
                        name="hr_expense"
                        string="Expenses"
                        groups="hr_expense.group_hr_expense_manager"
                        data-string="Expenses">
                        <block name="expenses_setting_container" title="Expenses">
                            <setting
                                id="create_expense_setting"
                                string="Incoming Emails"
                                title="Send an email to this email alias with the receipt in attachment to create an expense in one click. If the first word of the mail subject contains the category's internal reference or the category name, the corresponding category will automatically be set. Type the expense amount in the mail subject to set it on the expense too."
                                help="Create expenses from incoming emails">
                                <field name="hr_expense_use_mailgateway" />
                                <div
                                    class="content-group"
                                    invisible="not hr_expense_use_mailgateway or not alias_domain_id">
                                    <div
                                        class="mt16 d-flex align-items-start"
                                        dir="ltr">
                                        <label
                                            for="hr_expense_alias_prefix"
                                            string="Alias"
                                            class="o_light_label" />
                                        <field
                                            name="hr_expense_alias_prefix"
                                            placeholder="alias"
                                            class="oe_inline ps-2" />
                                        <span>@</span>
                                        <field
                                            name="hr_expense_alias_domain_id"
                                            placeholder="e.g. mycompany.com"
                                            options="{'no_create': True, 'no_open': True}"
                                            class="oe_inline" />
                                    </div>
                                </div>
                                <div
                                    class="content-group"
                                    invisible="not hr_expense_use_mailgateway or alias_domain_id">
                                    <div class="mt16">
                                        <a href="/odoo/settings#email-alias-setting" class="btn-link" role="button"><i class="oi oi-arrow-right" /> Setup your alias domain</a>
                                    </div>
                                </div>
                            </setting>
                            <setting
                                id="hr_payroll_accountant"
                                string="Reimburse in Payslip"
                                help="Refund employees via their payslips.">
                                <field
                                    name="module_hr_payroll_expense"
                                    widget="upgrade_boolean" />
                            </setting>
                            <setting
                                id="expense_extract_settings"
                                string="Expense Digitalization (OCR)"
                                title="use OCR to fill data from a picture of the bill"
                                help="Digitalize your receipts with OCR and Artificial Intelligence"
                                company_dependent="1">
                                <field name="module_extract_hr_expense" />
                            </setting>
                            <setting
                                id="expense_cards_stripe_issuing"
                                string="Expense Card"
                                help="Create prepaid virtual and physical cards for both one-time and recurring expenses, integrated into Odoo through Stripe Issuing."
                                company_dependent="True">
                                <field
                                    name="module_hr_expense_stripe"
                                    widget="upgrade_boolean" />
                                <div
                                    class="content-group"
                                    invisible="not module_hr_expense_stripe"
                                    name="expenses_stripe_issuing_container">
                                    <div class="text-warning mt16 mb4">
                                        Save this page and come back here to set up the feature.
                                    </div>
                                </div>
                            </setting>
                        </block>
                        <block title="Accounting">
                            <setting
                                string="Employee Expense Journal"
                                help="Default accounting journal for expenses paid by employees."
                                company_dependent="1">
                                <field name="expense_journal_id" />
                            </setting>
                            <setting
                                string="Payment methods"
                                help="Payment method allowed for expenses paid by company."
                                company_dependent="1">
                                <field
                                    name="company_expense_allowed_payment_channel_ids"
                                    placeholder="All payment methods allowed"
                                    widget="many2many_tags"
                                    options="{'no_create': True}" />
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
        <record id="action_hr_expense_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'hr_expense', 'bin_size': False}</field>
        </record>
        <menuitem
            id="menu_hr_expense_global_settings"
            name="Settings"
            parent="menu_hr_expense_configuration"
            action="action_hr_expense_configuration"
            sequence="0"
            groups="base.group_system" />
    </data>

</odoo>
