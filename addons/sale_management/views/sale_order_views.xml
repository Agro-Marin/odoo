<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_quote" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale_management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//div[@name='delivery_address_row']" position="after">
                <field
                    name="sale_order_template_id"
                    options="{'no_create': True}"
                    readonly="state in ['cancel', 'done']"
                    groups="sale_management.group_sale_order_template" />
            </xpath>

            <xpath expr="//form//div[@name='invoice_lines']" position="before">
                <group>
                    <field
                        name="is_optional"
                        invisible="display_type not in ['line_section', 'line_subsection']"
                        readonly="1" />
                </group>
            </xpath>

            <xpath expr="//list/field[@name='linked_virtual_id']" position="after">
                <field name="is_optional" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <record id="action_create_quotation_template" model="ir.actions.server">
        <field name="name">Save as Template</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field
            name="code">if records:
    action = records.action_create_quotation_template()</field>
        <!--
            Creating the template needs write access on sale.order.template and
            its lines, which security/ir.model.access.csv grants to the sale
            manager only. A salesman is read-only there, so without this
            restriction the button would be offered and then raise AccessError.
        -->
        <field
            name="group_ids"
            eval="[Command.link(ref('sales_team.group_sale_manager'))]" />
    </record>

</odoo>
