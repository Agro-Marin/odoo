<templates xml:space="preserve">
    <t t-name="html_editor.ImageAlignSelector">
        <Dropdown menuClass="'o-we-toolbar-dropdown'" menuRef="menuRef">
            <button t-att-title="props.title" class="btn btn-light" name="image_align">
                <span t-attf-class="oi {{ state.displayIcon }}"/>
            </button>
            <t t-set-slot="content">
                <div data-prevent-closing-overlay="true">
                    <t t-foreach="items" t-as="item" t-key="item_index">
                        <DropdownItem
                            tag="'button'"
                            attrs="{ title: item.title }"
                            class="{
                                'btn btn-light oi user-select-none': true,
                                [item.icon]: true,
                                active: item.icon === state.displayIcon,
                            }"
                            onSelected="() => this.onSelected(item)"
                        />
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
