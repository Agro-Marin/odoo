<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_type_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='configuration']//label[@for='support_document']"
                position="after">
                <label
                    for="l10n_in_is_sandwich_leave"
                    string="Sandwich Leaves"
                    invisible="country_code and country_code != 'IN'"
                    class="me-4" />
                <label
                    for="l10n_in_is_limited_to_optional_days"
                    string="Limited to Optional Holidays"
                    invisible="country_code and country_code != 'IN'"
                    class="me-4" />
            </xpath>
            <xpath
                expr="//group[@name='configuration']//field[@name='support_document']"
                position="after">
                <field
                    name="l10n_in_is_sandwich_leave"
                    nolabel="1"
                    invisible="country_code and country_code != 'IN'"
                    class="mb-2" />
                <field
                    name="l10n_in_is_limited_to_optional_days"
                    nolabel="1"
                    invisible="country_code and country_code != 'IN'"
                    class="mb-2" />
            </xpath>
        </field>
    </record>

</odoo>
