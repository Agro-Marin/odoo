<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_activity_schedule_view_form" model="ir.ui.view">
        <field name="name">Activity schedule</field>
        <field name="model">mail.activity.schedule</field>
        <field name="arch" type="xml">
            <form>
                <field name="activity_category" invisible="1" />
                <field name="chaining_type" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="has_error" invisible="1" />
                <field name="has_warning" invisible="1" />
                <field name="plan_has_user_on_demand" invisible="1" />
                <field name="res_ids" invisible="1" />
                <field name="plan_available_ids" invisible="1" />
                <sheet class="o_mail_activity_schedule_wizard">
                    <field
                        name="plan_id"
                        widget="selection_badge"
                        options="{'no_open': True, 'no_create': True}"
                        invisible="not plan_available_ids" />
                    <br />
                    <field
                        name="activity_type_id"
                        widget="selection_badge_icons"
                        required="not plan_id"
                        iconField="icon" />
                    <group invisible="not plan_id">
                        <group>
                            <field
                                name="plan_date"
                                string="Due Date"
                                placeholder="Default deadline for the activities..." />
                            <field
                                name="plan_on_demand_user_id"
                                string="Responsible"
                                widget="many2one_avatar_user"
                                invisible="not plan_has_user_on_demand" />
                        </group>
                        <group>
                            <label
                                for="plan_schedule_line_ids"
                                string="Plan Summary"
                                colspan="2"
                                class="o_form_label mb-n2" />
                            <field
                                name="plan_schedule_line_ids"
                                colspan="2"
                                nolabel="1"
                                class="text-muted mt-n2 small">
                                <list
                                    edit="0"
                                    class="o_mail_activity_schedule_summary"
                                    no_open="1">
                                    <field
                                        name="responsible_user_id"
                                        widget="many2one_avatar_user"
                                        width="22px"
                                        nolabel="1" />
                                    <field name="line_description" nolabel="1" />
                                    <field name="line_date_deadline" nolabel="1" />
                                </list>
                            </field>
                        </group>
                    </group>
                    <group invisible="not activity_type_id">
                        <group name="summary_group" colspan="2">
                            <label for="summary" class="o_form_label fs-3" />
                            <field
                                name="summary"
                                string="Summary"
                                placeholder="e.g. Discuss Proposal"
                                nolabel="1"
                                class="fs-3 w-100" />
                        </group>
                        <group>
                            <field name="date_deadline" string="Due Date" />
                            <field
                                name="activity_user_id"
                                placeholder="Unassigned"
                                widget="many2one_avatar_user" />
                            <field
                                name="res_model"
                                string="Link to"
                                widget="activity_model_selector"
                                invisible="id or context.get('active_model')"
                                required="activity_user_id != context.get('uid')" />
                        </group>
                        <field
                            name="note"
                            placeholder="Log a note..."
                            options="{'embedded_components': false}"
                            class="oe-bordered-editor embedded-editor-height-4" />
                    </group>
                    <div
                        role="alert"
                        class="alert alert-danger mb8"
                        invisible="not has_error">
                        <field name="error" />
                    </div>
                    <div
                        role="alert"
                        class="alert alert-warning mb8"
                        invisible="not has_warning">
                        <field name="warning" />
                    </div>
                </sheet>
                <footer invisible="plan_id">
                    <button
                        name="action_schedule_activities"
                        type="object"
                        string="Save"
                        invisible="has_error"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        name="action_schedule_activities_done"
                        type="object"
                        string="Mark Done"
                        context="{'mail_activity_quick_update': True}"
                        invisible="has_error or chaining_type == 'trigger'"
                        class="btn-secondary"
                        data-hotkey="w" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
                <footer invisible="not plan_id">
                    <button
                        name="action_schedule_plan"
                        type="object"
                        string="Schedule"
                        invisible="has_error"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
