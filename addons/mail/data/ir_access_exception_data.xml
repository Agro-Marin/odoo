<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="ir_cron_access_exception_reminder" model="ir.cron">
            <field
                name="name">Access Exceptions: Remind Reviewers Before They Lapse</field>
            <field name="model_id" ref="base.model_ir_access_exception" />
            <field name="state">code</field>
            <field name="code">model._cron_remind_lapsing()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="repeat_interval">1</field>
            <field name="repeat_unit">day</field>
        </record>
    </data>

    <record id="view_ir_access_exception_form" model="ir.ui.view">
        <field name="model">ir.access.exception</field>
        <field name="inherit_id" ref="base.view_ir_access_exception_form" />
        <field name="arch" type="xml">
            <sheet position="after">
                <chatter />
            </sheet>
        </field>
    </record>

</odoo>
