<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread.startMessage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Thread-avatar')]" position="attributes">
            <attribute name="t-att-class">{
                'o-mail-Thread-avatarChatWindow': env.inChatWindow,
                'cursor-pointer': correspondentPartner,
            }</attribute>
            <attribute name="t-on-click">onClickCorrespondentAvatar</attribute>
        </xpath>
    </t>
</templates>
