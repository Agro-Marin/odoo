<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_template_form" model="ir.ui.view">
        <field name="name">email.template.form</field>
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <form string="Templates" class="o_mail_template_form_view">
                <header>
                    <field name="ref_ir_act_window" invisible="1" />
                    <field name="template_fs" invisible="1" />
                    <field name="is_template_editor" invisible="1" />
                    <button
                        name="action_view_mail_preview"
                        type="object"
                        string="Preview"
                        class="btn-primary"
                        target="new" />
                    <button
                        name="%(mail_template_reset_action)d"
                        type="action"
                        string="Reset Template"
                        groups="mail.group_mail_template_editor"
                        invisible="not template_fs" />
                    <t groups="base.group_no_one">
                        <button
                            name="create_action"
                            type="object"
                            string="Add Context Action"
                            help="Display an option on related documents to open a composition wizard with this template"
                            groups="base.group_system"
                            invisible="ref_ir_act_window"
                            class="btn btn-secondary" />
                        <button
                            name="unlink_action"
                            type="object"
                            string="Remove Context Action"
                            help="Remove the contextual action to use this template on related documents"
                            invisible="not ref_ir_act_window"
                            class="btn btn-secondary" />
                    </t>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                string="Template Name"
                                placeholder="e.g. &quot;Welcome email&quot;"
                                required="1"
                                class="w-100" />
                        </h1>
                        <group>
                            <field
                                name="model_id"
                                placeholder="e.g. Contact"
                                options="{'no_create': True}"
                                groups="!base.group_no_one"
                                invisible="context.get('default_model')"
                                required="1" />
                            <field
                                name="model_id"
                                placeholder="e.g. Contact"
                                options="{'no_create': True}"
                                groups="base.group_no_one"
                                required="1" />
                            <field
                                name="subject"
                                placeholder="e.g. &quot;Welcome to MyCompany&quot; or &quot;Nice to meet you, {{ object.name }}&quot;"
                                options="{'dynamic_placeholder': true}" />
                            <field name="model" invisible="1" />
                        </group>
                    </div>
                    <notebook>
                        <page name="content" string="Body">
                            <field name="can_write" invisible="1" />
                            <field
                                name="body_html"
                                placeholder="Write your message here..."
                                widget="html_mail"
                                options="{'codeview': true, 'dynamic_placeholder': true, 'allowVideo': false}"
                                readonly="not can_write and id"
                                class="oe-bordered-editor" />
                            <div invisible="not can_write" class="fst-italic text-muted">Tip: Write
                                /field to insert dynamic content!</div>
                        </page>
                        <page
                            name="email_configuration"
                            string="Settings"
                            groups="base.group_no_one">
                            <group col="2">
                                <group>
                                    <separator string="Sender &amp; Recipients" />
                                    <field
                                        name="email_from"
                                        placeholder="Sender's email" />
                                    <field name="use_default_to" />
                                    <field
                                        name="email_to"
                                        placeholder="Comma-separated recipient addresses"
                                        invisible="use_default_to" />
                                    <field
                                        name="partner_to"
                                        placeholder="Comma-separated ids of recipient partners"
                                        invisible="use_default_to" />
                                    <field
                                        name="email_cc"
                                        placeholder="Comma-separated carbon copy of recipients addresses"
                                        invisible="use_default_to" />
                                    <field
                                        name="reply_to"
                                        placeholder="Capture replies in the chatter" />
                                </group>
                                <group>
                                    <separator string="Technical" />
                                    <field
                                        name="lang"
                                        placeholder="Main partner's language"
                                        options="{'dynamic_placeholder': true}" />
                                    <field name="has_mail_server" invisible="1" />
                                    <field
                                        name="mail_server_id"
                                        placeholder="By order of server priority"
                                        invisible="not has_mail_server" />
                                    <field name="auto_delete" />
                                    <field
                                        name="scheduled_date"
                                        string="Scheduled Send Date"
                                        placeholder="Send Instantly"
                                        options="{'dynamic_placeholder': true}" />
                                </group>
                            </group>
                        </page>
                        <page name="email_settings" string="Options">
                            <group col="2">
                                <group>
                                    <field name="has_dynamic_reports" invisible="1" />
                                    <field
                                        name="attachment_ids"
                                        widget="many2many_binary" />
                                    <field
                                        name="report_template_ids"
                                        placeholder="None"
                                        widget="many2many_tags"
                                        domain="[('model','=',model)]"
                                        options="{'no_create': True}"
                                        invisible="not has_dynamic_reports" />
                                </group>
                                <group>
                                    <field
                                        name="user_id"
                                        placeholder="Shared with all users"
                                        widget="many2one_avatar_user"
                                        invisible="not is_template_editor" />
                                    <field
                                        name="description"
                                        placeholder="Describe when this template should be used" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="email_template_tree" model="ir.ui.view">
        <field name="name">email.template.list</field>
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <list string="Templates">
                <field name="mail_server_id" column_invisible="True" />
                <field name="name" />
                <field name="model_id" groups="base.group_no_one" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="description" />
                <field name="subject" optional="hide" />
                <field name="email_from" optional="hide" />
                <field name="email_to" optional="hide" />
                <field name="partner_to" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_email_template_search" model="ir.ui.view">
        <field name="name">email.template.search</field>
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <search string="Templates">
                <field
                    name="name"
                    string="Templates"
                    filter_domain="['|', '|', ('name','ilike',self), ('subject','ilike',self), ('email_to','ilike',self)]" />
                <field name="lang" />
                <field name="model" filter_domain="[('model', '=', raw_value)]" />
                <field name="model_id" />
                <filter
                    name="my_templates"
                    string="My Templates"
                    domain="[('user_id', '=', uid)]" />
                <filter
                    name="base_templates"
                    string="Base Templates"
                    domain="[('template_category', '=', 'base_template')]" />
                <filter
                    name="custom_templates"
                    string="Custom Templates"
                    domain="[('template_category', '=', 'custom_template')]" />
                <group>
                    <filter
                        name="smtpserver"
                        string="SMTP Server"
                        context="{'group_by':'mail_server_id'}" />
                    <filter
                        name="group_by_model_id"
                        string="Model"
                        context="{'group_by':'model_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_email_template_tree_all" model="ir.actions.act_window">
        <field name="name">Email Templates</field>
        <field name="res_model">mail.template</field>
        <field name="path">email-templates</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="email_template_tree" />
        <field name="search_view_id" ref="view_email_template_search" />
        <field name="context">{'search_default_base_templates': 1}</field>
    </record>

</odoo>
