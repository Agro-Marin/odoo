<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_scheduled_message_view_form" model="ir.ui.view">
        <field name="name">mail.scheduled.message.view.form</field>
        <field name="model">mail.scheduled.message</field>
        <field name="arch" type="xml">
            <form string="Scheduled Message" js_class="mail_composer_form">
                <sheet>
                    <group>
                        <field name="composition_comment_option" invisible="1" />
                        <label for="partner_ids" string="To" invisible="is_note" />
                        <div invisible="is_note" class="d-flex gap-3">
                            <field name="res_id" invisible="1" />
                            <field name="model" invisible="1" />
                            <field
                                name="partner_ids"
                                placeholder="Add contacts to notify..."
                                widget="many2many_tags_email"
                                context="{'force_email': True, 'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"
                                options="{'edit_tags': True}"
                                class="w-auto flex-grow-1" />
                        </div>
                        <field name="subject" required="True" />
                    </group>
                    <div>
                        <field
                            name="body"
                            placeholder="Write your message here..."
                            widget="html_composer_message"
                            force_save="1" />
                        <field
                            name="attachment_ids"
                            widget="mail_composer_attachment_list" />
                    </div>
                </sheet>
                <footer>
                    <button
                        special="save"
                        string="Save"
                        invisible="not scheduled_date"
                        class="btn-primary"
                        data-hotkey="S" />
                    <button
                        name="post_message"
                        type="object"
                        string="Send Now"
                        invisible="is_note"
                        data-hotkey="q" />
                    <button
                        name="post_message"
                        type="object"
                        string="Log Now"
                        invisible="not is_note"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                    <field
                        name="attachment_ids"
                        widget="mail_composer_attachment_selector" />
                    <field name="scheduled_date" widget="datetime_scheduled_date" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
