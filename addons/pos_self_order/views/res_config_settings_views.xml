<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_menu" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.pos_self_order.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block position="after" id="restaurant_section">
                <block id="self_ordering_section" title="Mobile self-order &amp; Kiosk">
                    <setting string="QR menu &amp; Kiosk activation" help="Let your customers order using their mobile or a kiosk.">a
                        <div class="content-group row">
                            <label
                                for="pos_self_ordering_mode"
                                string="Self Ordering"
                                class="col-lg-4" />
                            <field
                                name="pos_self_ordering_mode"
                                invisible="not pos_config_id" />
                        </div>
                        <div
                            class="d-flex flex-column align-items-start w-50"
                            invisible="pos_self_ordering_mode == 'nothing'">
                            <button
                                name="preview_self_order_app"
                                type="object"
                                string="Preview Web interface"
                                icon="oi-arrow-right"
                                class="btn-link p-0" />
                            <button
                                name="custom_link_action"
                                type="object"
                                string="Home buttons"
                                icon="oi-arrow-right"
                                class="btn-link p-0" />
                            <button
                                name="generate_qr_codes_page"
                                type="object"
                                string="Print QR Codes"
                                icon="oi-arrow-right"
                                invisible="not pos_self_ordering_mode in ['consultation', 'mobile']"
                                class="btn-link p-0" />
                            <button
                                name="generate_qr_codes_zip"
                                type="object"
                                string="Download QR Codes"
                                icon="oi-arrow-right"
                                invisible="not pos_self_ordering_mode in ['consultation', 'mobile']"
                                class="btn-link p-0" />
                            <button
                                name="get_pos_qr_stands"
                                type="object"
                                string="Free Metal / Wood Stands"
                                icon="oi-arrow-right"
                                invisible="not pos_self_ordering_mode in ['consultation', 'mobile']"
                                class="btn-link p-0" />
                            <button
                                name="update_access_tokens"
                                type="object"
                                string="Reset QR Codes"
                                icon="oi-arrow-right"
                                groups="base.group_no_one"
                                invisible="not pos_self_ordering_mode in ['consultation', 'mobile']"
                                class="btn-link p-0" />
                        </div>
                        <div
                            class="content-group row mt-4"
                            invisible="not pos_self_ordering_mode in ['kiosk', 'mobile']">
                            <label
                                for="pos_self_ordering_service_mode"
                                string="Service at"
                                class="col-lg-4" />
                            <field
                                name="pos_self_ordering_service_mode"
                                readonly="not pos_module_pos_restaurant and pos_self_ordering_mode != 'kiosk'" />
                        </div>
                        <div
                            class="content-group row"
                            groups="base.group_no_one"
                            invisible="pos_self_ordering_mode == 'nothing'">
                            <label
                                for="pos_self_ordering_default_user_id"
                                string="Default User"
                                class="col-lg-4" />
                            <field name="pos_self_ordering_default_user_id" />
                        </div>
                        <div
                            id="self-payment-after"
                            class="content-group row"
                            invisible="not pos_self_ordering_mode in ['kiosk', 'mobile']">
                            <label
                                for="pos_self_ordering_pay_after"
                                string="Pay after"
                                class="col-lg-4" />
                            <field
                                name="pos_self_ordering_pay_after"
                                widget="upgrade_selection"
                                readonly="pos_self_ordering_mode == 'kiosk' or (pos_self_ordering_service_mode == 'counter' and pos_self_ordering_mode == 'mobile')" />
                        </div>
                    </setting>
                    <setting
                        string="Splash screens"
                        help="Personalize your splash screen by adding one or multiple images to create a slideshow"
                        invisible="pos_self_ordering_mode == 'nothing'">
                        <field
                            name="pos_self_ordering_image_home_ids"
                            widget="many2many_binary"
                            class="w-100" />
                    </setting>
                    <setting
                        string="Language"
                        help="Available interface languages"
                        invisible="pos_self_ordering_mode == 'nothing'">
                        <div class="content-group mt-3">
                            <div class="row">
                                <label
                                    for="pos_self_ordering_default_language_id"
                                    string="Default"
                                    class="col-lg-3" />
                                <field
                                    name="pos_self_ordering_default_language_id"
                                    options="{'no_create': True}" />
                            </div>
                            <div class="row">
                                <label
                                    for="pos_self_ordering_available_language_ids"
                                    string="Available"
                                    class="col-lg-3" />
                                <field
                                    name="pos_self_ordering_available_language_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}" />
                            </div>
                        </div>
                        <div>
                            <button
                                name="%(base.action_view_base_language_install)d"
                                type="action"
                                string="Add Languages"
                                icon="oi-arrow-right"
                                class="btn-link" />
                        </div>
                    </setting>
                    <setting
                        string="Background"
                        help="Personalize the Kiosk background"
                        invisible="pos_self_ordering_mode == 'nothing'">
                        <field
                            name="pos_self_ordering_image_background_ids"
                            widget="many2many_binary"
                            options="{'accepted_file_extensions': 'image/*', 'number_of_files': 1}"
                            class="w-100" />
                    </setting>
                </block>
            </block>

            <block position="attributes" id="pos_interface_section">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </block>

            <setting position="attributes" id="customer_display">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="manual_discount">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="price_control">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <field name="pos_available_pricelist_ids" position="attributes">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </field>

            <xpath
                expr="//label[@for='pos_available_pricelist_ids']"
                position="attributes">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </xpath>

            <setting position="attributes" id="margin_and_cost">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="flexible_taxes">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="multiple_prices_setting">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="is_restaurant">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="set_maximum_difference">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="order_edit_tracking">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="pos-avatax">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="pos_global_discount">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="pos_pricer">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="pos-loyalty">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="basic_receipt">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="iface_orderline_notes">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="ship_later">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>

            <setting position="attributes" id="barcode_scanner">
                <attribute name="invisible">is_kiosk_mode</attribute>
            </setting>
        </field>
    </record>

</odoo>
