<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_kind_view_list" model="ir.ui.view">
        <field name="name">resource.asset.kind.list</field>
        <field name="model">resource.asset.kind</field>
        <field name="arch" type="xml">
            <list string="Asset Kinds" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="scheduled" />
                <field name="identifier_type_ids" widget="many2many_tags" />
                <field name="asset_count" />
            </list>
        </field>
    </record>

    <record id="action_resource_asset_kind" model="ir.actions.act_window">
        <field name="name">Asset Kinds</field>
        <field name="res_model">resource.asset.kind</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
