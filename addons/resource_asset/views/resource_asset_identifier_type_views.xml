<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_identifier_type_view_list" model="ir.ui.view">
        <field name="name">resource.asset.identifier.type.list</field>
        <field name="model">resource.asset.identifier.type</field>
        <field name="arch" type="xml">
            <list string="Identifier Types" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="pattern" />
                <field name="unique_scope" />
                <field name="kind_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="action_resource_asset_identifier_type" model="ir.actions.act_window">
        <field name="name">Identifier Types</field>
        <field name="res_model">resource.asset.identifier.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
