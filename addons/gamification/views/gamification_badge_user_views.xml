<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="badge_user_kanban_view" model="ir.ui.view">
            <field name="name">Badge User Kanban View</field>
            <field name="model">gamification.badge.user</field>
            <field name="arch" type="xml">
                <kanban type="object" action="action_view_badge">
                    <field name="create_date" />
                    <templates>
                        <t t-name="card" class="row g-0">
                            <div class="g-0 row ps-2">
                                <div class="col">
                                    <field
                                        name="badge_name"
                                        type="open"
                                        class="fw-bold fs-5" />
                                    <div>
                                        Granted on <t t-out="luxon.DateTime.fromISO(record.create_date.raw_value).toFormat('D')" />
                                        <div class="d-flex align-items-center">
                                            By
                                            <field
                                                name="create_uid"
                                                widget="many2one_avatar_user"
                                                options="{'no_open': True}"
                                                class="m-0 mx-1 oe_inline" />
                                            <field
                                                name="create_uid"
                                                options="{'no_open': True}" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <field
                                        name="badge_id"
                                        widget="image"
                                        options="{'preview_image': 'image_1024'}"
                                        t-att-alt="record.badge_name.value" />
                                </div>
                                <field
                                    name="comment"
                                    class="mt-1 o_line_clamp o_line_clamp_5 text-muted" />
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>

</odoo>
