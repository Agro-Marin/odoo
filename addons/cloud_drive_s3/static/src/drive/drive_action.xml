<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="cloud_drive_s3.CloudDriveManager">
        <div
            class="o_cloud_drive d-flex flex-column h-100 position-relative"
            t-on-dragenter.prevent="onExtDragEnter"
            t-on-dragover.prevent="onExtDragOver"
            t-on-dragleave.prevent="onExtDragLeave"
            t-on-drop.prevent="onExtDrop"
        >

            <div t-if="state.extDragging" class="o_cd_dropzone">
                <div class="o_cd_dropzone_msg">
                    <i class="fa fa-cloud-upload fa-2x mb-2" />
                    <div>Drop files to upload here</div>
                </div>
            </div>

            <div
                class="o_cd_toolbar d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-bottom"
            >
                <ol class="breadcrumb m-0">
                    <t t-foreach="breadcrumbs" t-as="crumb" t-key="crumb.path">
                        <li
                            class="breadcrumb-item"
                            t-on-dragover.prevent="onExtDragOver"
                            t-on-drop.prevent.stop="() => this.onItemDrop(crumb)"
                        >
                            <a
                                href="#"
                                t-on-click.prevent="() => this.load(crumb.path)"
                            >
                                <i t-if="crumb.home" class="fa fa-home" />
                                <t t-else="" t-esc="crumb.name" />
                            </a>
                        </li>
                    </t>
                </ol>
                <div class="d-flex align-items-center gap-2">
                    <span t-if="state.uploading" class="text-muted small me-1">
                        <i class="fa fa-spin fa-circle-o-notch me-1" />Uploading…
                    </span>
                    <div class="btn-group btn-group-sm o_cd_viewtoggle" role="group">
                        <button
                            t-attf-class="btn btn-outline-secondary {{state.view === 'list' ? 'active' : ''}}"
                            title="List"
                            t-on-click="() => this.setView('list')"
                        >
                            <i class="fa fa-list" />
                        </button>
                        <button
                            t-attf-class="btn btn-outline-secondary {{state.view === 'grid' ? 'active' : ''}}"
                            title="Grid"
                            t-on-click="() => this.setView('grid')"
                        >
                            <i class="fa fa-th" />
                        </button>
                    </div>
                    <button
                        t-if="state.isAdmin"
                        class="btn btn-light border btn-sm"
                        title="Manage access"
                        t-on-click="openAccess"
                    >
                        <i class="fa fa-users" />
                    </button>
                    <button
                        t-if="state.isAdmin"
                        class="btn btn-light border btn-sm"
                        title="Configuration"
                        t-on-click="openConfiguration"
                    >
                        <i class="fa fa-cog" />
                    </button>
                    <input
                        type="file"
                        multiple="multiple"
                        class="d-none"
                        t-ref="fileInput"
                        t-on-change="onFilesSelected"
                    />
                </div>
            </div>

            <div class="o_cd_filters d-flex align-items-center gap-2 px-3 py-2">
                <div class="o_cd_search">
                    <i class="fa fa-search" />
                    <input
                        type="text"
                        class="form-control form-control-sm"
                        placeholder="Search in this folder"
                        t-model="state.search"
                    />
                    <button
                        t-if="state.search"
                        class="o_cd_search_clear"
                        title="Clear"
                        t-on-click="clearSearch"
                    >
                        <i class="fa fa-times" />
                    </button>
                </div>
                <select
                    class="form-select form-select-sm w-auto"
                    t-model="state.typeFilter"
                >
                    <option value="all">All types</option>
                    <option value="folder">Folders</option>
                    <option value="image">Images</option>
                    <option value="document">Documents</option>
                    <option value="other">Other</option>
                </select>
                <select class="form-select form-select-sm w-auto" t-model="state.sort">
                    <option value="name">Name</option>
                    <option value="size">Size</option>
                    <option value="date">Modified</option>
                </select>
            </div>

            <div
                t-if="state.clipboard"
                class="o_cd_clipboard d-flex align-items-center gap-2 px-3 py-1 small"
            >
                <i class="fa fa-scissors" />
                <span>Moving <b t-esc="state.clipboard.name" /></span>
                <button class="btn btn-sm btn-primary py-0" t-on-click="pasteHere">
                    Paste here
                </button>
                <button class="btn btn-sm btn-link py-0" t-on-click="cancelClipboard">
                    Cancel
                </button>
            </div>

            <div
                class="o_cd_body flex-grow-1 overflow-auto p-3"
                t-on-contextmenu.prevent="(ev) => this.openMenu(ev, 'background', null)"
            >
                <t t-if="state.loading">
                    <div class="text-center text-muted p-5">
                        <i class="fa fa-spin fa-circle-o-notch fa-2x" />
                    </div>
                </t>
                <t t-elif="isEmpty">
                    <div
                        class="o_cd_empty d-flex flex-column align-items-center justify-content-center text-muted"
                    >
                        <i class="fa fa-cloud-upload fa-4x mb-3 opacity-25" />
                        <p class="mb-1 fs-5">Nothing here</p>
                        <p t-if="state.canUpload" class="small mb-0">
                            Drag files here, or use the Upload button.
                        </p>
                    </div>
                </t>

                <t t-elif="state.view === 'grid'">
                    <div t-if="shownFolders.length" class="o_cd_grid">
                        <t t-foreach="shownFolders" t-as="folder" t-key="folder.path">
                            <div
                                t-attf-class="o_cd_card o_cd_folder {{state.dropTarget === folder.path ? 'o_cd_drop' : ''}}"
                                t-att-draggable="state.canUpload ? 'true' : 'false'"
                                t-on-click="() => this.load(folder.path)"
                                t-on-contextmenu.prevent.stop="(ev) => this.openMenu(ev, 'folder', folder)"
                                t-on-dragstart="(ev) => this.onItemDragStart(ev, folder, 'folder')"
                                t-on-dragend="onItemDragEnd"
                                t-on-dragover.prevent="() => this.onFolderDragOver(folder)"
                                t-on-dragleave="() => this.onFolderDragLeave(folder)"
                                t-on-drop.prevent.stop="() => this.onItemDrop(folder)"
                            >
                                <div class="o_cd_card_head">
                                    <i
                                        class="o_cd_head_icon fa fa-folder text-warning"
                                    />
                                    <span
                                        class="o_cd_head_name"
                                        t-att-title="folder.name"
                                        t-esc="folder.name"
                                    />
                                    <button
                                        class="o_cd_head_menu"
                                        t-on-click.stop.prevent="(ev) => this.openMenu(ev, 'folder', folder)"
                                    >
                                        <i class="fa fa-ellipsis-v" />
                                    </button>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div t-if="shownFiles.length" class="o_cd_grid">
                        <t t-foreach="shownFiles" t-as="file" t-key="file.key">
                            <t t-set="ic" t-value="fileIcon(file.name)" />
                            <div
                                class="o_cd_card o_cd_file"
                                draggable="true"
                                t-on-click="() => this.onOpen(file)"
                                t-on-contextmenu.prevent.stop="(ev) => this.openMenu(ev, 'file', file)"
                                t-on-dragstart="(ev) => this.onItemDragStart(ev, file)"
                                t-on-dragend="onItemDragEnd"
                            >
                                <div class="o_cd_card_head">
                                    <i
                                        t-attf-class="o_cd_head_icon fa {{ic.icon}} {{ic.cls}}"
                                    />
                                    <span
                                        class="o_cd_head_name"
                                        t-att-title="file.name"
                                        t-esc="file.name"
                                    />
                                    <button
                                        class="o_cd_head_menu"
                                        t-on-click.stop.prevent="(ev) => this.openMenu(ev, 'file', file)"
                                    >
                                        <i class="fa fa-ellipsis-v" />
                                    </button>
                                </div>
                                <div
                                    t-if="file.is_image and file.preview_url"
                                    class="o_cd_preview"
                                >
                                    <img
                                        class="o_cd_preview_thumb"
                                        loading="lazy"
                                        t-att-src="file.preview_url"
                                        t-att-alt="file.name"
                                        t-on-error="(ev) => this.onThumbError(ev, file)"
                                    />
                                </div>
                                <div t-else="" class="o_cd_preview o_cd_preview_icon">
                                    <i t-attf-class="fa {{ic.icon}} {{ic.cls}}" />
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-else="">
                    <table class="o_cd_list table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th style="width: 120px">Size</th>
                                <th style="width: 180px">Modified</th>
                                <th style="width: 40px" />
                            </tr>
                        </thead>
                        <tbody>
                            <t
                                t-foreach="shownFolders"
                                t-as="folder"
                                t-key="folder.path"
                            >
                                <tr
                                    t-attf-class="{{state.dropTarget === folder.path ? 'o_cd_drop' : ''}}"
                                    t-att-draggable="state.canUpload ? 'true' : 'false'"
                                    t-on-click="() => this.load(folder.path)"
                                    t-on-contextmenu.prevent.stop="(ev) => this.openMenu(ev, 'folder', folder)"
                                    t-on-dragstart="(ev) => this.onItemDragStart(ev, folder, 'folder')"
                                    t-on-dragend="onItemDragEnd"
                                    t-on-dragover.prevent="() => this.onFolderDragOver(folder)"
                                    t-on-dragleave="() => this.onFolderDragLeave(folder)"
                                    t-on-drop.prevent.stop="() => this.onItemDrop(folder)"
                                >
                                    <td>
                                        <i class="fa fa-folder text-warning me-2" />
                                        <t t-esc="folder.name" />
                                    </td>
                                    <td class="text-muted">—</td>
                                    <td class="text-muted">—</td>
                                    <td class="text-end">
                                        <button
                                            class="o_cd_row_menu"
                                            t-on-click.stop.prevent="(ev) => this.openMenu(ev, 'folder', folder)"
                                        >
                                            <i class="fa fa-ellipsis-v" />
                                        </button>
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="shownFiles" t-as="file" t-key="file.key">
                                <t t-set="ic" t-value="fileIcon(file.name)" />
                                <tr
                                    draggable="true"
                                    t-on-click="() => this.onOpen(file)"
                                    t-on-contextmenu.prevent.stop="(ev) => this.openMenu(ev, 'file', file)"
                                    t-on-dragstart="(ev) => this.onItemDragStart(ev, file)"
                                    t-on-dragend="onItemDragEnd"
                                >
                                    <td>
                                        <i
                                            t-attf-class="fa {{ic.icon}} {{ic.cls}} me-2"
                                        />
                                        <t t-esc="file.name" />
                                    </td>
                                    <td
                                        class="text-muted"
                                        t-esc="formatSize(file.size)"
                                    />
                                    <td
                                        class="text-muted"
                                        t-esc="formatDate(file.last_modified)"
                                    />
                                    <td class="text-end">
                                        <button
                                            class="o_cd_row_menu"
                                            t-on-click.stop.prevent="(ev) => this.openMenu(ev, 'file', file)"
                                        >
                                            <i class="fa fa-ellipsis-v" />
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>

            <div
                t-if="state.ctx.open"
                class="o_cd_ctxmenu"
                t-attf-style="left:{{state.ctx.x}}px; top:{{state.ctx.y}}px;"
            >
                <t t-if="state.ctx.kind === 'file'">
                    <button
                        class="o_cd_ctx_item"
                        t-on-click="() => this.onDownload(state.ctx.item)"
                    >
                        <i class="fa fa-download fa-fw me-2" />Download
                    </button>
                    <t t-if="state.canUpload">
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onRename(state.ctx.item)"
                        >
                            <i class="fa fa-pencil fa-fw me-2" />Rename
                        </button>
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onDuplicate(state.ctx.item)"
                        >
                            <i class="fa fa-clone fa-fw me-2" />Duplicate
                        </button>
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onCut(state.ctx.item)"
                        >
                            <i class="fa fa-arrows fa-fw me-2" />Move
                        </button>
                    </t>
                    <button
                        class="o_cd_ctx_item"
                        t-on-click="() => this.onInfo(state.ctx.item)"
                    >
                        <i class="fa fa-info-circle fa-fw me-2" />Information
                    </button>
                    <t t-if="state.isAdmin or state.ctx.item.can_share">
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onShare(state.ctx.item, 'file')"
                        >
                            <i class="fa fa-user-plus fa-fw me-2" />Share
                        </button>
                    </t>
                    <t t-if="state.isAdmin or state.ctx.item.can_share">
                        <div class="o_cd_ctx_sep" />
                        <button
                            class="o_cd_ctx_item text-danger"
                            t-on-click="() => this.onDeleteFile(state.ctx.item)"
                        >
                            <i class="fa fa-trash fa-fw me-2" />Delete
                        </button>
                    </t>
                </t>
                <t t-elif="state.ctx.kind === 'folder'">
                    <button
                        class="o_cd_ctx_item"
                        t-on-click="() => this.load(state.ctx.item.path)"
                    >
                        <i class="fa fa-folder-open-o fa-fw me-2" />Open
                    </button>
                    <t t-if="state.canUpload">
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onRenameFolder(state.ctx.item)"
                        >
                            <i class="fa fa-pencil fa-fw me-2" />Rename
                        </button>
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onDuplicateFolder(state.ctx.item)"
                        >
                            <i class="fa fa-clone fa-fw me-2" />Duplicate
                        </button>
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onCut(state.ctx.item, 'folder')"
                        >
                            <i class="fa fa-arrows fa-fw me-2" />Move
                        </button>
                    </t>
                    <t t-if="state.isAdmin or state.ctx.item.can_share">
                        <button
                            class="o_cd_ctx_item"
                            t-on-click="() => this.onShare(state.ctx.item, 'folder')"
                        >
                            <i class="fa fa-user-plus fa-fw me-2" />Share
                        </button>
                    </t>
                    <t t-if="state.isAdmin or state.ctx.item.can_share">
                        <div class="o_cd_ctx_sep" />
                        <button
                            class="o_cd_ctx_item text-danger"
                            t-on-click="() => this.onDeleteFolder(state.ctx.item)"
                        >
                            <i class="fa fa-trash fa-fw me-2" />Delete
                        </button>
                    </t>
                </t>
                <t t-else="">
                    <button
                        t-if="state.canUpload"
                        class="o_cd_ctx_item"
                        t-on-click="onNewFolder"
                    >
                        <i class="fa fa-folder-o fa-fw me-2" />New folder
                    </button>
                    <button
                        t-if="state.canUpload"
                        class="o_cd_ctx_item"
                        t-on-click="onUploadClick"
                    >
                        <i class="fa fa-upload fa-fw me-2" />Upload
                    </button>
                    <button
                        t-if="state.canUpload and state.clipboard"
                        class="o_cd_ctx_item"
                        t-on-click="pasteHere"
                    >
                        <i class="fa fa-clipboard fa-fw me-2" />Paste here
                    </button>
                    <span
                        t-if="!state.canUpload"
                        class="o_cd_ctx_item text-muted"
                    >No actions available</span>
                </t>
            </div>

            <div t-if="state.info" class="o_cd_modal_backdrop" t-on-click="closeInfo">
                <div class="o_cd_modal" t-on-click.stop="() => {}">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5
                            class="m-0 text-truncate"
                            t-att-title="state.info.name"
                            t-esc="state.info.name"
                        />
                        <button class="btn btn-sm btn-link p-0" t-on-click="closeInfo">
                            <i class="fa fa-times" />
                        </button>
                    </div>
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">Size</td>
                                <td t-esc="formatSize(state.info.size)" />
                            </tr>
                            <tr>
                                <td class="text-muted">Modified</td>
                                <td t-esc="formatDate(state.info.last_modified)" />
                            </tr>
                            <tr>
                                <td class="text-muted">Type</td>
                                <td t-esc="state.info.content_type or '—'" />
                            </tr>
                            <tr>
                                <td class="text-muted">Path</td>
                                <td class="text-break" t-esc="state.info.key" />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div t-if="state.share" class="o_cd_modal_backdrop" t-on-click="shareClose">
                <div class="o_cd_modal o_cd_share" t-on-click.stop="() => {}">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="m-0 text-truncate">
                            <i
                                t-attf-class="fa {{state.share.kind === 'folder' ? 'fa-folder' : 'fa-file-o'}} me-2"
                            />
                            Share "<t t-esc="state.share.name" />"
                        </h5>
                        <button class="btn btn-sm btn-link p-0" t-on-click="shareClose">
                            <i class="fa fa-times" />
                        </button>
                    </div>

                    <div class="o_cd_share_add d-flex gap-2 mb-3 position-relative">
                        <div class="flex-grow-1 position-relative">
                            <input
                                type="text"
                                class="form-control form-control-sm"
                                placeholder="Add people by name…"
                                t-att-value="state.share.query"
                                t-on-input="onShareSearch"
                            />
                            <div
                                t-if="state.share.results.length"
                                class="o_cd_share_results"
                            >
                                <t
                                    t-foreach="state.share.results"
                                    t-as="u"
                                    t-key="u.id"
                                >
                                    <button
                                        class="o_cd_share_result"
                                        t-on-click="() => this.onShareAdd(u)"
                                    >
                                        <i class="fa fa-user-o fa-fw me-2" />
                                        <t t-esc="u.name" />
                                    </button>
                                </t>
                            </div>
                        </div>
                        <select
                            class="form-select form-select-sm w-auto"
                            t-model="state.share.level"
                        >
                            <option value="read">Viewer</option>
                            <option value="upload">Editor</option>
                            <option value="admin">Manager</option>
                        </select>
                    </div>

                    <div class="o_cd_share_list">
                        <t t-if="state.share.loading">
                            <div class="text-center text-muted p-3">
                                <i class="fa fa-spin fa-circle-o-notch" />
                            </div>
                        </t>
                        <t t-elif="!state.share.grants.length">
                            <p
                                class="text-muted small mb-0"
                            >Not shared with anyone yet.</p>
                        </t>
                        <t t-else="">
                            <t
                                t-foreach="state.share.grants"
                                t-as="g"
                                t-key="g.user_id"
                            >
                                <div
                                    class="o_cd_share_row d-flex align-items-center gap-2 py-1"
                                >
                                    <i class="fa fa-user-circle-o fa-lg text-muted" />
                                    <span
                                        class="flex-grow-1 text-truncate"
                                        t-esc="g.name"
                                    />
                                    <select
                                        class="form-select form-select-sm w-auto"
                                        t-att-value="g.access_level"
                                        t-on-change="(ev) => this.onShareLevel(g, ev)"
                                    >
                                        <option value="read">Viewer</option>
                                        <option value="upload">Editor</option>
                                        <option value="admin">Manager</option>
                                    </select>
                                    <button
                                        class="btn btn-sm btn-link text-danger p-0"
                                        title="Remove"
                                        t-on-click="() => this.onShareRemove(g)"
                                    >
                                        <i class="fa fa-times" />
                                    </button>
                                </div>
                            </t>
                        </t>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <button
                            class="btn btn-sm btn-primary"
                            t-on-click="shareClose"
                        >Done</button>
                    </div>
                </div>
            </div>

            <div
                t-if="state.preview"
                class="o_cd_preview_backdrop"
                t-on-click="closePreview"
            >
                <div class="o_cd_preview_dialog" t-on-click.stop="() => {}">
                    <div class="o_cd_preview_bar">
                        <span
                            class="o_cd_preview_title text-truncate"
                            t-att-title="state.preview.name"
                            t-esc="state.preview.name"
                        />
                        <div class="d-flex align-items-center gap-1">
                            <button
                                class="o_cd_preview_btn"
                                title="Download"
                                t-on-click="() => this.onDownload(state.preview.file)"
                            >
                                <i class="fa fa-download" />
                            </button>
                            <button
                                class="o_cd_preview_btn"
                                title="Close"
                                t-on-click="closePreview"
                            >
                                <i class="fa fa-times" />
                            </button>
                        </div>
                    </div>
                    <div class="o_cd_preview_body">
                        <img
                            t-if="state.preview.kind === 'image'"
                            class="o_cd_preview_img"
                            t-att-src="state.preview.url"
                            t-att-alt="state.preview.name"
                        />
                        <iframe
                            t-else=""
                            class="o_cd_preview_frame"
                            t-att-src="state.preview.url"
                            t-att-title="state.preview.name"
                        />
                    </div>
                </div>
            </div>

            <div
                t-if="state.dialog"
                class="o_cd_modal_backdrop"
                t-on-click="dialogCancel"
            >
                <div class="o_cd_modal" t-on-click.stop="() => {}">
                    <h5 class="mb-3" t-esc="state.dialog.title" />
                    <input
                        t-if="state.dialog.mode === 'prompt'"
                        type="text"
                        class="form-control"
                        t-ref="dialogInput"
                        t-model="state.dialog.value"
                        t-att-placeholder="state.dialog.placeholder"
                        t-on-keydown="onDialogKey"
                    />
                    <p t-else="" class="mb-0" t-esc="state.dialog.message" />
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button
                            class="btn btn-sm btn-secondary"
                            t-on-click="dialogCancel"
                        >
                            Cancel
                        </button>
                        <button
                            t-attf-class="btn btn-sm {{state.dialog.danger ? 'btn-danger' : 'btn-primary'}}"
                            t-on-click="dialogOk"
                            t-esc="state.dialog.confirmLabel or 'OK'"
                        />
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
