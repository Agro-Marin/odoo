<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_cloud_drive" model="ir.module.category">
        <field name="name">Cloud</field>
        <field name="description">Access levels for the cloud-only S3 Drive</field>
        <field name="sequence" eval="10" />
    </record>

    <record id="res_groups_privilege_drive" model="res.groups.privilege">
        <field name="name">Cloud</field>
        <field name="category_id" ref="module_category_cloud_drive" />
        <field name="description">Access level for the Cloud file storage</field>
        <field name="placeholder">Set Drive access level...</field>
        <field name="sequence" eval="10" />
    </record>

    <record id="group_drive_read" model="res.groups">
        <field name="name">Cloud User</field>
        <field name="privilege_id" ref="res_groups_privilege_drive" />
        <field name="sequence" eval="10" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
            name="comment">Can open the Cloud drive and access only what has been shared with them.</field>
    </record>

    <record id="group_drive_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_drive" />
        <field name="sequence" eval="20" />
        <field name="implied_ids" eval="[Command.link(ref('group_drive_read'))]" />
        <field
            name="comment">Full access: global bypass of per-folder sharing, delete, configure, and manage shares.</field>
    </record>

</odoo>
