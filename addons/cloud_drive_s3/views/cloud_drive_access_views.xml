<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cloud_drive_access_list" model="ir.ui.view">
        <field name="name">cloud.drive.access.list</field>
        <field name="model">cloud.drive.access</field>
        <field name="arch" type="xml">
            <list string="Cloud Drive Access" editable="bottom">
                <field name="path" placeholder="06 Partners/ACME" />
                <field name="user_id" />
                <field name="access_level" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_cloud_drive_access_form" model="ir.ui.view">
        <field name="name">cloud.drive.access.form</field>
        <field name="model">cloud.drive.access</field>
        <field name="arch" type="xml">
            <form string="Cloud Drive Access">
                <sheet>
                    <group>
                        <field name="path" placeholder="06 Partners/ACME" />
                        <field name="user_id" />
                        <field name="access_level" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cloud_drive_access" model="ir.actions.act_window">
        <field name="name">Cloud Drive Access</field>
        <field name="res_model">cloud.drive.access</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
