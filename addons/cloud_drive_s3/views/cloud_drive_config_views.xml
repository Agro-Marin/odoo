<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cloud_drive_config_form" model="ir.ui.view">
        <field name="name">cloud.drive.config.form</field>
        <field name="model">cloud.drive.config</field>
        <field name="arch" type="xml">
            <form string="Cloud Configuration">
                <sheet>
                    <group>
                        <group string="Bucket">
                            <field name="bucket_name" placeholder="my-drive-bucket" />
                            <field name="region" placeholder="us-east-2" />
                        </group>
                        <group string="IAM Credentials">
                            <field name="keys_set" />
                            <field
                                name="access_key_id"
                                placeholder="Leave empty to keep the stored key" />
                            <field
                                name="secret_access_key"
                                password="1"
                                placeholder="Leave empty to keep the stored key" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_save"
                        type="object"
                        string="Save"
                        class="btn-primary" />
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test connection"
                        class="btn-secondary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cloud_drive_config" model="ir.actions.act_window">
        <field name="name">Cloud Configuration</field>
        <field name="res_model">cloud.drive.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
