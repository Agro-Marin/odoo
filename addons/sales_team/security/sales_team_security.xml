<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="res_groups_privilege_sales" model="res.groups.privilege">
            <field name="name">Sales</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="base.module_category_sales" />
        </record>

        <record id="group_sale_salesman" model="res.groups">
            <field name="name">User: Own Documents Only</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="comment">The user will have access to their own data in the sales application.</field>
        </record>

        <record id="group_sale_salesman_team" model="res.groups">
            <field name="name">User: Team Documents</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field name="implied_ids" eval="[(4, ref('group_sale_salesman'))]" />
            <field name="comment">The user will have access to records of their team members in the sales application.</field>
        </record>

        <record id="group_sale_salesman_all_leads" model="res.groups">
            <field name="name">User: All Documents</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field name="implied_ids" eval="[(4, ref('group_sale_salesman_team'))]" />
            <field name="comment">The user will have access to all records of everyone in the sales application.</field>
        </record>

        <record id="group_sale_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field name="implied_ids"
                eval="[
                    (4, ref('group_sale_salesman_all_leads')),
                    (4, ref('mail.group_mail_canned_response_admin'))
                ]" />
            <field name="user_ids"
                eval="[
                    (4, ref('base.user_root')),
                    (4, ref('base.user_admin'))
                ]" />
            <field name="comment">the user will have an access to the sales configuration as well as statistic reports.</field>
        </record>

    </data>

    <data noupdate="1">

        <!-- A user MODIFIES the teams they belong to (member) or lead (responsible),
             matching the member-OR-responsible heuristic of crm.team._get_default_team_id.
             One rule covers all three salesman levels: group_sale_salesman_team and
             group_sale_salesman_all_leads both imply group_sale_salesman, and the rules
             selected by a user's groups are OR-ed, so a second rule carrying the very
             same domain for the team group added nothing.

             perm_read is False, so this rule does not narrow READS. A team's row
             is a label rendered wherever team_id is: on a sales order, on an
             invoice, on an opportunity. An internal user holding NO Sales group
             already reads every team for exactly that reason (the comment on
             crm_team_member_rule_personal below spells it out); and while this
             rule applied to reads, granting that same account "User: Own
             Documents Only" TOOK ROWS AWAY. Access grew by dropping a group,
             which is the shape test_the_ladder_only_ever_widens already calls a
             defect on crm.team.member.

             It was not cosmetic. web_read fetches a many2one's display_name, so
             a record whose team the reader cannot see does not render a blank
             field: the whole record raises AccessError and will not open. The
             only reason that was rarely hit is that _get_default_team_id used to
             rule-filter its own answer, i.e. it papered over this by storing the
             filer's team instead of the salesperson's. That compensation is
             gone (it made stored data depend on who typed it), so the read grant
             has to be honest.

             What stays scoped: writing a team is group_sale_manager's, by ACL;
             and a team's ROSTER stays personal, on crm.team.member's own rules
             below. crm and sale hang lead counts and invoiced targets off
             crm.team, and those become readable to any internal user holding a
             Sales group; they were already readable to every internal user
             without one, so this makes the exposure uniform rather than new. -->
        <record id="crm_rule_personal_salesteam" model="ir.rule">
            <field name="name">Personal Salesteam</field>
            <field name="model_id" ref="model_crm_team" />
            <field name="domain_force">['|', ('user_id', '=', user.id), ('id', 'in', user.crm_team_ids.ids)]</field>
            <field name="perm_read" eval="False" />
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        </record>

        <record id="crm_rule_all_salesteam" model="ir.rule">
            <field name="name">All Salesteam</field>
            <field name="model_id" ref="model_crm_team" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]" />
        </record>

        <record id="sale_team_comp_rule" model="ir.rule">
            <field name="name">Sales Team multi-company</field>
            <field name="model_id" ref="model_crm_team" />
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Memberships follow their team: without this, crm.team is company-scoped
             while its membership rows are not, so the memberships of another
             company's teams stay readable to every internal user. -->
        <record id="crm_team_member_comp_rule" model="ir.rule">
            <field name="name">Sales Team Member multi-company</field>
            <field name="model_id" ref="model_crm_team_member" />
            <field name="domain_force">[('crm_team_id.company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- The same principle within a company, which the rule above does not
             cover: crm.team is restricted to the teams a salesperson leads or
             belongs to, but its membership rows carried no such rule, so a
             salesperson who cannot open team X could still search up X's roster.
             The name of X stayed hidden (reading crm_team_id's display name
             needs read on crm.team) but the rows, their user_id and the size of
             the team did not.

             The domain repeats crm_rule_personal_salesteam leaf for leaf ("a
             membership is visible exactly when its team is"), but the GROUP is
             deliberately base.group_user and not group_sale_salesman, so the
             two rules do not mirror. Record rules are selected by group and
             OR-ed, so a rule carried by a Sales group binds nobody outside
             Sales: an internal user with no sales group at all matched no rule
             here and read every membership in the database, while granting that
             same account "User: Own Documents Only" narrowed it to its own
             teams. Access grew by dropping a group. Carried by base.group_user
             the domain reaches every internal user, and the ladder above it is
             unchanged: group_sale_salesman implies base.group_user, so a
             salesperson still gets exactly this domain, and
             group_sale_salesman_all_leads still ORs crm_team_member_rule_all
             over it.

             crm.team keeps the wider grant on purpose. Its name is rendered
             outside the Sales app (team_id on an invoice, on a sales order), so
             an accountant who reads one must be able to read the team; the same
             domain applied to base.group_user turns that into an AccessError on
             display_name. Membership rows have no such reader: nothing outside
             this module puts them on screen. -->
        <record id="crm_team_member_rule_personal" model="ir.rule">
            <field name="name">Personal Salesteam Members</field>
            <field name="model_id" ref="model_crm_team_member" />
            <field name="domain_force">['|', ('crm_team_id.user_id', '=', user.id), ('crm_team_id', 'in', user.crm_team_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="crm_team_member_rule_all" model="ir.rule">
            <field name="name">All Salesteam Members</field>
            <field name="model_id" ref="model_crm_team_member" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]" />
        </record>

    </data>

</odoo>