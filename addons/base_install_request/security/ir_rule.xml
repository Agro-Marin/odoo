<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base_module_install_request_own_rule" model="ir.rule">
        <field name="name">An activation request is its requester's</field>
        <field name="model_id" ref="model_base_module_install_request" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="base_module_install_request_system_rule" model="ir.rule">
        <field name="name">An administrator sees every activation request</field>
        <field name="model_id" ref="model_base_module_install_request" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>

</odoo>
