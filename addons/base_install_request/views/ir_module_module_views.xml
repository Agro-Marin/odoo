<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_module_module_view_kanban" model="ir.ui.view">
        <field name="name">ir.module.module.view.kanban.inherit.mail</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban" />
        <field name="arch" type="xml">
            <button name="button_immediate_install" position="after">
                <button name="action_view_install_request" type="object" groups="!base.group_system" invisible="state != 'uninstalled'" class="btn btn-primary btn-sm" t-if="!record.to_buy.raw_value">Request Access</button>
            </button>
        </field>
    </record>

    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(5, 0, 0)]" />
    </record>

</odoo>
