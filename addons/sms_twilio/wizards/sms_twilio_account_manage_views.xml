<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sms_twilio_account_manage_view_form" model="ir.ui.view">
        <field name="name">sms.twilio.account.manage.view.form</field>
        <field name="model">sms.twilio.account.manage</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Twilio SMS Manage Connection">
                <group string="Credentials">
                    <field name="company_id" invisible="1"/>  <!-- Invisible to not be visible -->
                    <label for="sms_twilio_account_sid" />
                    <div class="d-flex align-items-center">
                        <field
                            name="sms_twilio_account_sid"
                            placeholder="ACabcde12345abcde12345abcde12345ab"
                            required="1" />
                        <a
                            target="_blank"
                            class="btn btn-link ms-1 w-25"
                            role="button"
                            href="https://www.odoo.com/documentation/latest/applications/marketing/sms_marketing/twilio.html">
                            Need help ?
                            <i
                                class="fa-solid fa-up-right-from-square"
                                aria-hidden="true" />
                        </a>
                    </div>
                    <field
                        name="sms_twilio_auth_token"
                        placeholder="abcde12345abcde12345abcde12345ab"
                        password="True"
                        required="1" />
                    <label for="test_number" />
                    <div class="d-flex align-items-center">
                        <field name="test_number" placeholder="+1 555-123-4567" />
                        <button
                            name="action_send_test"
                            type="object"
                            string="Send test SMS"
                            icon="fa-send"
                            class="btn btn-link w-25 ms-1" />
                    </div>
                </group>
                <group string="Phone Numbers">
                    <button
                        name="action_reload_numbers"
                        type="object"
                        string="Reload Numbers from Twilio"
                        icon="fa-refresh"
                        colspan="2"
                        class="btn btn-secondary" />
                    <field name="sms_twilio_number_ids" colspan="2" nolabel="1">
                        <list editable="bottom" delete="0">
                            <field name="sequence" widget="handle" />
                            <field name="country_id" />
                            <field name="number" placeholder="+1 555-123-4567" />
                            <button
                                name="action_unlink"
                                type="object"
                                title="Delete"
                                icon="fa-solid fa-trash-can" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_save"
                        type="object"
                        string="Update Account"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
