<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Event Log: Users can only see their company's logs -->
    <record id="rule_api_event_log_company" model="ir.rule">
        <field name="name">Event Log: Company isolation</field>
        <field name="model_id" ref="model_api_event_log" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_comm_user'))]" />
    </record>

    <!-- Outbound Service: All users can read, managers can modify -->
    <record id="rule_api_endpoint_outbound_read" model="ir.rule">
        <field name="name">Outbound Service: Global read</field>
        <field name="model_id" ref="model_api_endpoint_outbound" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_comm_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- Response Cache: Company isolation -->
    <record id="rule_comm_response_cache_company" model="ir.rule">
        <field name="name">Response Cache: Company isolation</field>
        <field name="model_id" ref="model_comm_response_cache" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_comm_user'))]" />
    </record>

</odoo>
