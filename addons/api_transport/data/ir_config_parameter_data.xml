<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Retry Configuration -->
    <record id="config_retry_batch_size" model="ir.config_parameter">
        <field name="key">api_transport.retry_batch_size</field>
        <field name="value">100</field>
    </record>

    <!-- Log Retention -->
    <record id="config_log_retention_days" model="ir.config_parameter">
        <field name="key">api_transport.log_retention_days</field>
        <field name="value">90</field>
    </record>

    <!-- Cache Configuration -->
    <record id="config_max_cache_entries" model="ir.config_parameter">
        <field name="key">api_transport.max_cache_entries</field>
        <field name="value">10000</field>
    </record>

    <!-- Payload Size Limits -->
    <record id="config_max_payload_size_limit" model="ir.config_parameter">
        <field name="key">api_transport.max_payload_size_limit</field>
        <field name="value">104857600</field>
        <!-- 100MB -->
    </record>

    <!-- Duplicate Detection -->
    <record id="config_max_duplicate_window_seconds" model="ir.config_parameter">
        <field name="key">api_transport.max_duplicate_window_seconds</field>
        <field name="value">3600</field>
    </record>

    <!-- Timestamp Verification -->
    <record id="config_timestamp_future_tolerance" model="ir.config_parameter">
        <field name="key">api_transport.timestamp_future_tolerance</field>
        <field name="value">60</field>
    </record>

    <!-- Security: Disable 'none' signature type by default -->
    <record id="config_allow_none_signature" model="ir.config_parameter">
        <field name="key">api_transport.allow_none_signature</field>
        <field name="value">False</field>
    </record>

</odoo>
