<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_server_action_form_endpoint" model="ir.ui.view">
        <field name="name">ir.actions.server.form.endpoint</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="arch" type="xml">
            <field name="webhook_url" position="after">
                <field
                    name="webhook_endpoint_id"
                    options="{'no_create': True}"
                    placeholder="Unauthenticated POST" />
            </field>
        </field>
    </record>

</odoo>
