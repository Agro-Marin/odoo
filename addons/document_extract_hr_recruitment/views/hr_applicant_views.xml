<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_applicant_view_form_document_extract" model="ir.ui.view">
        <field name="name">hr.applicant.form.document.extract</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_extract_document"
                    string="Read the CV"
                    type="object"
                    invisible="not extract_can_be_read" />
                <field name="extract_can_be_read" invisible="1" />
                <field name="extract_state" invisible="1" />
            </header>
        </field>
    </record>

</odoo>
