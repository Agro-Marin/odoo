<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <function
            model="ir.default"
            name="set"
            eval="('product.category', 'property_cost_method', 'standard')" />
        <function
            model="ir.default"
            name="set"
            eval="('product.category', 'property_valuation', 'periodic')" />
        <record id="ir_cron_post_stock_valuation" model="ir.cron" forcecreate="True">
            <field name="name">Stock Account: Inventory Valuation Closing</field>
            <field name="model_id" ref="model_res_company" />
            <field name="state">code</field>
            <field name="code">model._cron_post_stock_valuation()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="repeat_interval">1</field>
            <field name="repeat_unit">day</field>
            <field name="active" eval="True" />
        </record>
    </data>

</odoo>
