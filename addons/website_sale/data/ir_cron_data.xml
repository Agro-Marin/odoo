<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_send_availability_email" model="ir.cron">
        <field
            name="name">eCommerce: send email to customers about their abandoned cart</field>
        <field name="model_id" ref="model_website" />
        <field name="state">code</field>
        <field name="code">model._send_abandoned_cart_email()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">hour</field>
    </record>

</odoo>
