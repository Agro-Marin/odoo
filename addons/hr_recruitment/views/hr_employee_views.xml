<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_hr_recruitment" model="ir.ui.view">
        <field name="name">hr.employee.view.form.recruitment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <button name="action_view_versions" position="before">
                <button name="action_view_applicant"
                        class="oe_stat_button"
                        icon="fa-id-card-o"
                        type="object"
                        groups="hr.group_hr_user"
                        invisible="not applicant_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="applicant_name"/></span>
                        <span class="o_stat_text">Applicant</span>
                    </div>
                </button>
            </button>
        </field>
    </record>

</odoo>
