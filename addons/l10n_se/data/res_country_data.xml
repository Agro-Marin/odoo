<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="se_partner_address_form" model="ir.ui.view">
        <field name="name">se.partner.form.address</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="900" />
        <field name="arch" type="xml">
            <form>
                <div class="o_address_format">
                    <field name="parent_id" invisible="1" />
                    <field name="type" invisible="1" />
                    <field
                        name="street"
                        placeholder="Street"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_street" />
                    <field
                        name="street2"
                        placeholder="Neighborhood"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_street" />
                    <field
                        name="zip"
                        placeholder="ZIP"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_zip" />
                    <field
                        name="city"
                        placeholder="City"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_city" />
                    <field
                        name="state_id"
                        placeholder="State..."
                        options="{&quot;no_open&quot;: True}"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_state" />
                    <field
                        name="country_id"
                        placeholder="Country"
                        options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                        readonly="type == 'contact' and parent_id"
                        class="o_address_country" />
                </div>
            </form>
        </field>
    </record>

    <record id="base.se" model="res.country">
        <field name="address_view_id" ref="se_partner_address_form" />
        <field
            name="address_format"
            eval="'%(street)s\n%(street2)s\n%(zip)s %(city)s %(state_code)s\n%(country_name)s'" />
    </record>

</odoo>
