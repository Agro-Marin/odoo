<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_line_search" model="ir.ui.view">
        <field name="name">sale.order.line.select</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Search Sales Order">
                <filter
                    name="to_invoice"
                    string="To Invoice"
                    help="Sales Order Lines ready to be invoiced"
                    domain="[('qty_to_invoice', '!=', 0)]" />
                <separator />
                <filter
                    name="my_sales_order_lines"
                    string="My Sales Order Lines"
                    help="Sales Order Lines related to a Sales Order of mine"
                    domain="[('user_id','=',uid)]" />
                <field name="order_id" />
                <field name="partner_id" operator="child_of" />
                <field name="product_id" />
                <field name="user_id" />
                <group>
                    <filter
                        name="product"
                        string="Product"
                        context="{'group_by':'product_id'}" />
                    <filter
                        name="order"
                        string="Order"
                        context="{'group_by':'order_id'}" />
                    <filter
                        name="salesperson"
                        string="Salesperson"
                        context="{'group_by':'user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_sale_order_line_list" model="ir.ui.view">
        <field name="name">sale.order.line.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Sales Order Lines" create="false">
                <field name="order_id" />
                <field name="partner_id" />
                <field name="name" />
                <field name="user_id" />
                <field name="product_qty" string="Qty" />
                <field name="qty_transferred" />
                <field name="qty_invoiced" />
                <field name="qty_to_invoice" />
                <field
                    name="product_uom_id"
                    widget="many2one_uom"
                    context="{'product_id': product_id}"
                    groups="uom.group_uom" />
                <field name="price_subtotal" widget="monetary" sum="Total" />
                <field name="currency_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_kanban" model="ir.ui.view">
        <field name="name">sale.order.line.kanban</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <field name="display_name" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sale_order_line_form_readonly" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Sales Order Item" edit="false">
                <field name="display_type" invisible="1" />
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" force_save="1" readonly="1" />
                            <field
                                name="product_id"
                                widget="many2one_barcode"
                                force_save="1"
                                readonly="id and product_readonly"
                                required="not display_type" />
                            <field name="name" />
                            <field name="product_qty" />
                            <field
                                name="qty_transferred"
                                invisible="state != 'done'"
                                readonly="qty_transferred_method != 'manual'" />
                            <field name="qty_invoiced" invisible="state != 'done'" />
                            <field
                                name="product_uom_id"
                                widget="many2one_uom"
                                force_save="1"
                                groups="uom.group_uom"
                                readonly="product_uom_readonly"
                                required="not display_type" />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                            <field name="partner_id" invisible="1" />
                        </group>
                        <group>
                            <field name="price_unit" />
                            <field name="price_unit_auto" invisible="1" />
                            <field
                                name="discount"
                                groups="sale.group_discount_per_so_line" />
                            <field
                                name="price_subtotal"
                                string="Amount"
                                widget="monetary"
                                invisible="company_price_include == 'tax_included'" />
                            <field
                                name="price_total"
                                string="Amount"
                                widget="monetary"
                                invisible="company_price_include == 'tax_excluded'" />
                            <field
                                name="tax_ids"
                                widget="many2many_tax_tags"
                                domain="[('type_tax_use', '=', 'sale'), ('company_ids', 'parent_of', company_id), ('country_id', '=', tax_country_id)]"
                                context="{'search_view_ref': 'account.account_tax_view_search'}"
                                options="{'no_create': True}"
                                readonly="qty_invoiced &gt; 0" />
                            <field name="price_tax" widget="monetary" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_order_line_list_history" model="ir.ui.view">
        <field name="name">sale.history.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list
                type="object"
                default_order="date_confirmed desc, id desc"
                create="false"
                action="action_view_order"
                decoration-info="order_id == context.get('active_id')">
                <field name="currency_id" column_invisible="True" />
                <field name="order_id" widget="many2one" />
                <field name="date_confirmed" />
                <field name="partner_id" string="Customer" />
                <field name="user_id" string="Salesperson" optional="hide" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="product_qty" optional="hide" />
                <field name="product_uom_id" optional="hide" groups="uom.group_uom" />
                <field name="product_uom_qty" />
                <field name="price_unit" optional="hide" />
                <field name="price_unit_product_uom" widget="monetary" />
                <field
                    name="discount"
                    optional="hide"
                    groups="sale.group_discount_per_so_line" />
                <field name="price_subtotal" string="Total Untaxed" widget="monetary" />
                <field name="state" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_sale_history_pivot" model="ir.ui.view">
        <field name="name">sale.history.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="price_total" type="measure" string="Total sold amount" />
                <field name="product_uom_qty" type="measure" string="Total Qty sold" />
            </pivot>
        </field>
    </record>

    <record id="view_sale_history_graph" model="ir.ui.view">
        <field name="name">sale.history.graph</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="date_order" interval="month" />
                <field name="product_uom_qty" type="measure" />
            </graph>
        </field>
    </record>

    <record id="action_sale_history" model="ir.actions.act_window">
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="sale.view_sale_order_line_list_history" />
        <field
            name="context">{
            'search_default_product': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                This product has not been sold yet!
            </p>
        </field>
    </record>

</odoo>
