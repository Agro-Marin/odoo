<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="invoice_to_so_wizard_form" model="ir.ui.view">
        <field name="name">invoice.to.so.wizard.form</field>
        <field name="model">invoice.to.so.wizard</field>
        <field name="arch" type="xml">
            <form string="Add to SO">
                <sheet>
                    <group>
                        <field
                            name="sale_order_id"
                            domain="['|', ('partner_id', '=', partner_id), ('partner_id.commercial_partner_id', '=', partner_id), ('state', 'in', ['done'])]"
                            placeholder="or create new"
                            context="{'show_total_amount': True}" />
                    </group>
                    <footer>
                        <button
                            name="action_add_to_so"
                            type="object"
                            string="Add Products"
                            invisible="not context.get('has_products')" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
