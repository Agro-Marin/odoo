<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_return_read_company_rule" model="ir.rule">
        <field name="name">Account Returns multi-company</field>
        <field name="model_id" ref="model_account_return" />
        <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="account_return_company_rule" model="ir.rule">
        <field name="name">Account Returns multi-company</field>
        <field name="model_id" ref="model_account_return" />
        <field
            name="domain_force">['|', ('tax_unit_id.main_company_id', 'in', company_ids), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="account_return_check_read_company_rule" model="ir.rule">
        <field name="name">Account Returns Check multi-company</field>
        <field name="model_id" ref="model_account_return_check" />
        <field
            name="domain_force">[('return_id.company_ids', 'in', company_ids)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="account_return_check_company_rule" model="ir.rule">
        <field name="name">Account Returns Check multi-company</field>
        <field name="model_id" ref="model_account_return_check" />
        <field
            name="domain_force">['|', ('return_id.tax_unit_id.main_company_id', 'in', company_ids), ('return_id.company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <!--
        account.audit.account.status carries no company of its own; it belongs to the
        audit return that owns it, so it is scoped exactly as account.return.check is.
    -->
    <record id="account_audit_account_status_read_company_rule" model="ir.rule">
        <field name="name">Account Audit Account Status multi-company</field>
        <field name="model_id" ref="model_account_audit_account_status" />
        <field name="domain_force">[('audit_id.company_ids', 'in', company_ids)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="account_audit_account_status_company_rule" model="ir.rule">
        <field name="name">Account Audit Account Status multi-company</field>
        <field name="model_id" ref="model_account_audit_account_status" />
        <field
            name="domain_force">['|', ('audit_id.tax_unit_id.main_company_id', 'in', company_ids), ('audit_id.company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="account_report_budget_company_rule" model="ir.rule">
        <field name="name">Account Report Budget multi-company</field>
        <field name="model_id" ref="model_account_report_budget" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        A budget item has no company of its own, so without this it stays visible from
        companies that cannot see the budget holding it.
    -->
    <record id="account_report_budget_item_company_rule" model="ir.rule">
        <field name="name">Account Report Budget Item multi-company</field>
        <field name="model_id" ref="model_account_report_budget_item" />
        <field name="global" eval="True" />
        <field name="domain_force">[('budget_id.company_id', 'in', company_ids)]</field>
    </record>

    <!--
        A tax unit spans several companies; being in any one of them is what grants
        access to it. Membership alone was granting it to everybody.
    -->
    <record id="account_tax_unit_company_rule" model="ir.rule">
        <field name="name">Tax Unit multi-company</field>
        <field name="model_id" ref="model_account_tax_unit" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_ids', 'in', company_ids)]</field>
    </record>

</odoo>
