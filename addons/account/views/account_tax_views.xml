<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tax_tree" model="ir.ui.view">
        <field name="name">account.tax.list</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <list string="Account Tax" decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="description" optional="show" />
                <field name="type_tax_use" />
                <field
                    name="original_tax_ids"
                    widget="many2many_tax_tags"
                    optional="hide" />
                <field name="tax_scope" />
                <field name="invoice_label" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    groups="base.group_multi_company" />
                <field name="country_id" optional="hide" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_onboarding_tax_tree" model="ir.ui.view">
        <field name="name">account.onboarding.tax.list</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">active desc, type_tax_use desc, amount desc,
                    sequence</attribute>
            </xpath>
        </field>
    </record>

    <record id="tax_repartition_line_tree" model="ir.ui.view">
        <field name="name">account.tax.repartition.line.list</field>
        <field name="model">account.tax.repartition.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1" delete="1">
                <field name="sequence" widget="handle" />
                <field
                    name="factor_percent"
                    widget="account_tax_repartition_line_factor_percent"
                    invisible="repartition_type == 'base'" />
                <field name="repartition_type" />
                <field
                    name="account_id"
                    options="{'no_create': True}"
                    invisible="repartition_type == 'base'" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    domain="tag_ids_domain"
                    options="{'no_create': True}" />
                <field
                    name="use_in_tax_closing"
                    optional="hide"
                    invisible="repartition_type == 'base'" />
                <field name="company_ids" column_invisible="True" />
                <field name="tag_ids_domain" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="account_tax_view_tree" model="ir.ui.view">
        <field name="name">account.invoice.line.tax.search</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <list string="Account Tax">
                <field name="display_name" string="Name" />
                <field name="tax_scope" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="account_tax_fiscal_position_view_tree" model="ir.ui.view">
        <field name="name">account.fiscal.position.tax.list</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.account_tax_view_tree" />
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <field name="display_name" position="before">
                <field name="type_tax_use" />
            </field>
            <field name="display_name" position="after">
                <field name="original_tax_ids" widget="many2many_tax_tags" />
            </field>
        </field>
    </record>

    <record id="view_tax_kanban" model="ir.ui.view">
        <field name="name">account.tax.kanban</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row mb4">
                            <div class="col-6">
                                <field name="name" class="fw-bolder" />
                            </div>
                            <div class="col-6 text-end">
                                <field name="type_tax_use" class="badge rounded-pill" />
                                <field name="tax_scope" class="badge rounded-pill" />
                            </div>
                        </div>
                        <field name="description" class="text-muted" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_account_tax_search" model="ir.ui.view">
        <field name="name">account.tax.search</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <search string="Search Taxes">
                <field name="name" string="Name" />
                <field name="description" />
                <field name="amount" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    groups="base.group_multi_company" />
                <field name="fiscal_position_ids" />
                <filter
                    name="sale"
                    string="Sale"
                    domain="[('type_tax_use','=','sale')]" />
                <filter
                    name="purchase"
                    string="Purchase"
                    domain="[('type_tax_use','=','purchase')]" />
                <separator />
                <filter
                    name="service"
                    string="Services"
                    domain="[('tax_scope','=','service')]" />
                <filter
                    name="goods"
                    string="Goods"
                    domain="[('tax_scope','=','consu')]" />
                <separator />
                <filter
                    name="domestictax"
                    string="Domestic"
                    domain="[('is_domestic', '=', True)]" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    help="Show active taxes"
                    domain="[('active','=',True)]" />
                <filter
                    name="inactive"
                    string="Inactive"
                    help="Show inactive taxes"
                    domain="[('active','=',False)]" />
                <group>
                    <filter
                        name="country"
                        string="Country"
                        context="{'group_by':'country_id'}" />
                    <filter
                        name="taxapp"
                        string="Tax Type"
                        context="{'group_by':'type_tax_use'}" />
                    <filter
                        name="taxscope"
                        string="Tax Scope"
                        context="{'group_by':'tax_scope'}" />
                    <filter
                        name="groupfp"
                        string="Fiscal Position"
                        context="{'group_by': 'fiscal_position_ids'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="account_tax_view_search" model="ir.ui.view">
        <field name="name">account.tax.search.filters</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <search string="Search Taxes">
                <field
                    name="name"
                    string="Tax"
                    filter_domain="['|', '|', ('name', 'ilike', self), ('description', 'ilike', self), ('invoice_label', 'ilike', self)]" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    groups="base.group_multi_company" />
            </search>
        </field>
    </record>

    <record id="view_tax_form" model="ir.ui.view">
        <field name="name">account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="arch" type="xml">
            <form string="Account Tax">
                <field name="company_ids" invisible="1" />
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="amount_type" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="is_used" invisible="1" />
                            <field name="type_tax_use" />
                            <field name="tax_scope" />
                            <label
                                for="amount"
                                invisible="amount_type not in ('fixed', 'percent', 'division')" />
                            <div
                                invisible="amount_type not in ('fixed', 'percent', 'division')">
                                <field name="amount" nolabel="1" class="oe_inline" />
                                <span class="o_form_label oe_inline" invisible="amount_type == 'fixed'">%</span>
                            </div>
                            <field
                                name="fiscal_position_ids"
                                placeholder="all"
                                widget="many2many_tags" />
                            <field
                                name="original_tax_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                invisible="not display_alternative_taxes_field" />
                        </group>
                    </group>
                    <notebook>
                        <page name="definition" string="Definition">
                            <group invisible="amount_type == 'group'">
                                <field name="country_code" invisible="1" />
                                <group
                                    string="Distribution for Invoices"
                                    class="mw-100">
                                    <field
                                        name="invoice_repartition_line_ids"
                                        colspan="2"
                                        nolabel="1" />
                                </group>
                                <group string="Distribution for Refunds" class="mw-100">
                                    <field
                                        name="refund_repartition_line_ids"
                                        colspan="2"
                                        nolabel="1" />
                                </group>
                            </group>
                            <field
                                name="children_tax_ids"
                                domain="[('type_tax_use','in',('none',type_tax_use)), ('amount_type','!=','group')]"
                                invisible="amount_type != 'group' or type_tax_use == 'none'">
                                <list string="Children Taxes">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="amount_type" />
                                    <field name="amount" />
                                </list>
                            </field>
                        </page>
                        <page name="advanced_options" string="Advanced Options">
                            <group>
                                <group>
                                    <field name="invoice_label" />
                                    <field name="description" />
                                    <field
                                        name="tax_group_id"
                                        invisible="amount_type == 'group'"
                                        required="amount_type != 'group'" />
                                    <field
                                        name="analytic"
                                        groups="analytic.group_analytic_accounting"
                                        invisible="amount_type == 'group'" />
                                    <field
                                        name="company_ids"
                                        widget="many2many_tags"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_company" />
                                    <field name="country_id" required="True" />
                                    <field name="invoice_legal_notes" />
                                </group>
                                <group name="advanced_booleans">
                                    <field name="price_include" invisible="1" />
                                    <field
                                        name="price_include_override"
                                        placeholder="Default"
                                        invisible="amount_type == 'group' or has_negative_factor" />
                                    <field
                                        name="include_base_amount"
                                        invisible="amount_type == 'group'" />
                                    <field
                                        name="is_base_affected"
                                        groups="base.group_no_one"
                                        invisible="amount_type == 'group' or price_include" />
                                    <field name="hide_tax_exigibility" invisible="1" />
                                    <field
                                        name="tax_exigibility"
                                        widget="radio"
                                        invisible="amount_type == 'group' or not hide_tax_exigibility" />
                                    <field
                                        name="cash_basis_transition_account_id"
                                        options="{'no_create': True}"
                                        groups="account.group_account_readonly"
                                        invisible="tax_exigibility == 'on_invoice'"
                                        required="tax_exigibility == 'on_payment'" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_tax_form" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="path">taxes</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_tax_tree" />
        <field
            name="context">{'search_default_sale': True, 'search_default_purchase': True,
            'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tax
            </p>
        </field>
    </record>

    <record id="account_tax_group_view_search" model="ir.ui.view">
        <field name="name">account.tax.group.search.filters</field>
        <field name="model">account.tax.group</field>
        <field name="arch" type="xml">
            <search string="Search Group">
                <field name="name" />
                <field name="country_id" />
                <group>
                    <filter
                        name="group_by_country"
                        string="Country"
                        context="{'group_by': 'country_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_tax_group_tree" model="ir.ui.view">
        <field name="name">account.tax.group.list</field>
        <field name="model">account.tax.group</field>
        <field name="arch" type="xml">
            <list string="Account Tax Group" editable="bottom" open_form_view="True">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="country_id" />
                <field name="company_ids" column_invisible="True" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    groups="base.group_multi_company" />
                <field name="country_code" column_invisible="True" />

                <field name="tax_payable_account_id" />
                <field name="tax_receivable_account_id" />
                <field name="advance_tax_payment_account_id" />

                <field name="preceding_subtotal" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_tax_group_form" model="ir.ui.view">
        <field name="name">account.tax.group.form</field>
        <field name="model">account.tax.group</field>
        <field name="arch" type="xml">
            <form string="Account Tax Group">
                <field name="company_ids" invisible="1" />
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="country_id" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                groups="base.group_multi_company" />
                            <field name="sequence" />
                            <field
                                name="pos_receipt_label"
                                string="Label on PoS Receipts"
                                groups="base.group_no_one" />
                        </group>
                        <group>
                            <field
                                name="tax_payable_account_id"
                                domain="[('company_ids', 'in', company_ids)]" />
                            <field
                                name="tax_receivable_account_id"
                                domain="[('company_ids', 'in', company_ids)]" />
                            <field
                                name="advance_tax_payment_account_id"
                                domain="[('company_ids', 'in', company_ids)]" />
                            <field name="preceding_subtotal" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tax_group" model="ir.actions.act_window">
        <field name="name">Tax Groups</field>
        <field name="res_model">account.tax.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tax_group_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tax group
            </p>
        </field>
    </record>

</odoo>
