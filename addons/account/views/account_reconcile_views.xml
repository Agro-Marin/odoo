<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_line_reconcile_search" model="ir.ui.view">
        <field name="name">account.move.line.reconcile.search</field>
        <field name="model">account.move.line</field>
        <field name="priority" eval="300" />
        <field name="arch" type="xml">
            <search string="Search Journal Items to Reconcile">
                <field
                    name="name"
                    string="Journal Item"
                    filter_domain="['|', '|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('account_id', 'ilike', self), ('partner_id', 'ilike', self)]" />
                <field name="name" />
                <field name="ref" />
                <field name="invoice_date" />
                <field name="date" />
                <field
                    name="balance"
                    string="Amount"
                    filter_domain="['|', ('credit', '=', self), ('debit', '=', self)]" />
                <field name="account_id" />
                <field name="account_type" />
                <field name="partner_id" />
                <field name="journal_id" />
                <field
                    name="move_id"
                    string="Journal Entry"
                    filter_domain="['|', '|', ('move_id.name', 'ilike', self), ('move_id.ref', 'ilike', self), ('move_id.partner_id', 'ilike', self)]" />
                <field name="tax_ids" />
                <field name="tax_line_id" string="Originator Tax" />
                <field name="reconcile_model_id" />
                <separator />
                <filter
                    name="reconcilable_account"
                    string="Unreconciled"
                    help="Journal items where the account allows reconciliation no matter the residual amount"
                    domain="[('account_id.reconcile', '=', True), '|', ('matching_number', '=', False), ('matching_number', '=like', 'P%')]" />
                <filter
                    name="unreconciled"
                    string="With residual"
                    help="Journal items where matching number isn't set"
                    domain="[('amount_residual', '!=', 0), ('account_id.reconcile', '=', True)]" />
                <separator />
                <filter
                    name="trade_payable"
                    string="Payable"
                    help="From Trade Payable accounts"
                    domain="[('account_id.account_type', '=', 'liability_payable'), ('account_id.non_trade', '=', False)]" />
                <filter
                    name="trade_receivable"
                    string="Receivable"
                    help="From Trade Receivable accounts"
                    domain="[('account_id.account_type', '=', 'asset_receivable'), ('account_id.non_trade', '=', False)]" />
                <separator />
                <filter
                    name="posted_lines"
                    string="Posted"
                    domain="[('parent_state', '=', 'posted')]" />
                <filter
                    name="unposted_lines"
                    string="Unposted"
                    domain="[('parent_state', '=', 'draft')]" />
                <separator />
                <filter name="date" string="Date" date="date" />
                <filter name="invoice_date" string="Invoice Date" date="invoice_date" />
                <separator />
                <group>
                    <filter
                        name="group_by_move"
                        string="Journal Entry"
                        context="{'group_by': 'move_name'}" />
                    <filter
                        name="group_by_account"
                        string="Account"
                        context="{'group_by': 'account_id'}" />
                    <filter
                        name="group_by_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}" />
                    <filter
                        name="journal"
                        string="Journal"
                        context="{'group_by': 'journal_id'}" />
                    <filter
                        name="groupby_date"
                        string="Date"
                        context="{'group_by': 'date'}" />
                    <filter
                        name="groupby_invoice_date"
                        string="Invoice Date"
                        context="{'group_by': 'invoice_date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_move_line_reconcile_tree" model="ir.ui.view">
        <field name="name">account.move.line.list.reconcile</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list
                string="Journal Items"
                create="false"
                edit="true"
                multi_edit="1"
                sample="1"
                expand="context.get('expand', False)"
                js_class="account_move_line_reconcile_list">
                <header>
                    <button
                        name="action_reconcile"
                        type="object"
                        string="Reconcile"
                        groups="account.group_account_user" />
                </header>
                <field name="move_id" column_invisible="True" />
                <field name="invoice_date" string="Invoice Date" optional="hide" />
                <field name="date" readonly="1" />
                <field name="company_id" column_invisible="True" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                    readonly="1" />
                <field
                    name="journal_id"
                    optional="hide"
                    options="{&quot;no_open&quot;:True}"
                    readonly="1" />
                <field
                    name="move_name"
                    string="Journal Entry"
                    widget="open_move_widget" />
                <field
                    name="account_id"
                    optional="hide"
                    domain="[('company_ids', 'parent_of', company_id)]"
                    options="{'no_open': True, 'no_create': True}"
                    groups="account.group_account_readonly" />
                <field
                    name="partner_id"
                    optional="hide"
                    readonly="move_type != 'entry'" />
                <field name="ref" optional="hide" readonly="False" />
                <field name="product_id" optional="hide" readonly="1" />
                <field name="name" optional="show" />
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    optional="show"
                    options="{'product_field': 'product_id', 'account_field': 'account_id', 'force_applicability': 'optional'}"
                    groups="analytic.group_analytic_accounting" />
                <field
                    name="tax_ids"
                    widget="many2many_tax_tags"
                    optional="hide"
                    readonly="1" />
                <field
                    name="amount_currency"
                    string="In Currency"
                    optional="show"
                    groups="base.group_multi_currency"
                    invisible="is_same_currency"
                    readonly="1" />
                <field
                    name="currency_id"
                    string="Currency"
                    optional="hide"
                    groups="base.group_multi_currency"
                    invisible="is_same_currency"
                    readonly="1" />
                <field name="debit" sum="Total Debit" readonly="1" />
                <field name="credit" sum="Total Credit" readonly="1" />
                <field
                    name="tax_tag_ids"
                    string="Tax Grids"
                    widget="many2many_tags"
                    optional="hide"
                    options="{'no_create': True, 'no_create_edit': True}" />
                <field name="discount_date" string="Discount Date" optional="hide" />
                <field
                    name="discount_amount_currency"
                    string="Discount Amount"
                    optional="hide" />
                <field
                    name="tax_line_id"
                    string="Originator Tax"
                    optional="hide"
                    readonly="1" />
                <field name="date_maturity" optional="hide" readonly="1" />
                <field
                    name="balance"
                    optional="hide"
                    sum="Total Balance"
                    readonly="1" />
                <field
                    name="matching_number"
                    string="Matching"
                    widget="matching_link_widget"
                    optional="show"
                    readonly="1" />
                <field
                    name="amount_residual"
                    string="Residual"
                    optional="show"
                    sum="Total Residual"
                    invisible="not is_account_reconcile"
                    readonly="1" />
                <field
                    name="amount_residual_currency"
                    string="Residual in Currency"
                    optional="hide"
                    sum="Total Residual in Currency"
                    groups="base.group_multi_currency"
                    invisible="is_same_currency or not is_account_reconcile"
                    readonly="1" />
                <field name="move_type" column_invisible="True" />
                <field name="parent_state" column_invisible="True" />
                <field name="account_type" column_invisible="True" />
                <field name="statement_line_id" column_invisible="True" />
                <field name="company_currency_id" column_invisible="True" />
                <field name="is_same_currency" column_invisible="True" />
                <field name="is_account_reconcile" column_invisible="True" />
                <field name="sequence" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="action_open_auto_reconcile_wizard" model="ir.actions.act_window">
        <field name="name">Reconcile automatically</field>
        <field name="res_model">account.auto.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_move_line_posted_unreconciled" model="ir.actions.act_window">
        <field name="name">Journal Items to reconcile</field>
        <field name="res_model">account.move.line</field>
        <field name="path">reconcile</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_move_line_reconcile_tree" />
        <field name="search_view_id" ref="view_account_move_line_reconcile_search" />
        <field
            name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')), ('account_id.reconcile', '=', True), ('full_reconcile_id', '=', False), ('parent_state', '!=', 'cancel')]</field>
        <field
            name="context">{'auto_statement_processing': True, 'journal_type': 'general', 'search_default_posted_lines': True, 'search_default_unreconciled': True, 'search_default_group_by_account': True, 'search_default_group_by_partner': True}</field>
    </record>

    <record
        id="account_accountant_view_account_reconcile_model_search"
        model="ir.ui.view">
        <field name="name">account.reconcile.model.search</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <filter
                    name="created_by_user"
                    string="Created by User"
                    domain="[('created_automatically', '=', False)]" />
                <filter
                    name="created_automatically"
                    string="Created Automatically"
                    domain="[('created_automatically', '=', True)]" />
            </xpath>
        </field>
    </record>

    <record id="account.action_account_reconcile_model" model="ir.actions.act_window">
        <field name="context">{'search_default_created_by_user':1}</field>
    </record>

</odoo>
