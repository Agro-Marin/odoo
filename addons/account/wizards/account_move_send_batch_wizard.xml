<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_send_batch_wizard_form" model="ir.ui.view">
        <field name="name">account.move.send.batch.wizard.form</field>
        <field name="model">account.move.send.batch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_ids" invisible="1" />

                <div class="m-0" id="alerts" invisible="not alerts">
                    <field
                        name="alerts"
                        widget="actionable_errors"
                        class="o_field_html" />
                </div>

                <field
                    name="summary_data"
                    widget="account_batch_sending_summary"
                    invisible="not summary_data" />

                <footer>
                    <button
                        name="action_send_and_print"
                        type="object"
                        string="Send"
                        class="print btn-primary o_mail_send"
                        data-hotkey="q">
                    </button>
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>

            </form>
        </field>
    </record>

</odoo>
