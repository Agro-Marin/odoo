<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="return_submission_wizard_form" model="ir.ui.view">
        <field name="name">account.return.submission.wizard.form</field>
        <field name="model">account.return.submission.wizard</field>
        <field name="arch" type="xml">
            <form string="Submit">
                <sheet>
                    <field name="instructions" readonly="1" />
                </sheet>
                <footer>
                    <button
                        name="action_proceed_with_submission"
                        type="object"
                        string="Mark as Submitted"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
