<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="field_api_key_value" model="credential.category.field">
        <field name="category_id" ref="credential_category_api_key" />
        <field name="code">credential_value</field>
        <field name="name">API Key</field>
        <field name="sequence" eval="10" />
        <field name="placeholder">Enter your API key...</field>
        <field name="requirement_group">secret</field>
    </record>

    <record id="field_api_key_alias" model="credential.category.field">
        <field name="category_id" ref="credential_category_api_key" />
        <field name="code">api_key</field>
        <field name="name">API Key</field>
        <field name="sequence" eval="20" />
        <field name="requirement_group">secret</field>
    </record>

    <record id="field_bearer_token_value" model="credential.category.field">
        <field name="category_id" ref="credential_category_bearer_token" />
        <field name="code">credential_value</field>
        <field name="name">Token</field>
        <field name="sequence" eval="10" />
        <field name="placeholder">Enter your bearer token...</field>
        <field name="requirement_group">secret</field>
    </record>

    <record id="field_bearer_token_alias" model="credential.category.field">
        <field name="category_id" ref="credential_category_bearer_token" />
        <field name="code">bearer_token</field>
        <field name="name">Token</field>
        <field name="sequence" eval="20" />
        <field name="requirement_group">secret</field>
    </record>

    <record id="field_basic_auth_username" model="credential.category.field">
        <field name="category_id" ref="credential_category_basic_auth" />
        <field name="code">username</field>
        <field name="name">Username</field>
        <field name="sequence" eval="10" />
        <field name="placeholder">Enter username...</field>
    </record>

    <record id="field_basic_auth_password" model="credential.category.field">
        <field name="category_id" ref="credential_category_basic_auth" />
        <field name="code">password</field>
        <field name="name">Password</field>
        <field name="sequence" eval="20" />
        <field name="placeholder">Enter password...</field>
    </record>

    <record id="field_oauth2_client_id" model="credential.category.field">
        <field name="category_id" ref="credential_category_oauth2" />
        <field name="code">oauth_client_id</field>
        <field name="name">Client ID</field>
        <field name="sequence" eval="10" />
        <field name="placeholder">Enter client ID (optional)...</field>
        <field name="required" eval="False" />
    </record>

    <record id="field_oauth2_client_secret" model="credential.category.field">
        <field name="category_id" ref="credential_category_oauth2" />
        <field name="code">oauth_client_secret</field>
        <field name="name">Client Secret</field>
        <field name="sequence" eval="20" />
        <field name="placeholder">Enter client secret...</field>
        <field name="requirement_group">token</field>
    </record>

    <record id="field_oauth2_access_token" model="credential.category.field">
        <field name="category_id" ref="credential_category_oauth2" />
        <field name="code">oauth_access_token</field>
        <field name="name">Access Token</field>
        <field name="sequence" eval="30" />
        <field name="placeholder">Enter access token...</field>
        <field name="requirement_group">token</field>
    </record>

    <record id="field_oauth2_refresh_token" model="credential.category.field">
        <field name="category_id" ref="credential_category_oauth2" />
        <field name="code">oauth_refresh_token</field>
        <field name="name">Refresh Token</field>
        <field name="sequence" eval="40" />
        <field name="placeholder">Enter refresh token (optional)...</field>
        <field name="requirement_group">token</field>
    </record>

    <record id="field_aws_iam_key" model="credential.category.field">
        <field name="category_id" ref="credential_category_aws_iam" />
        <field name="code">api_key</field>
        <field name="name">Access Key ID</field>
        <field name="sequence" eval="10" />
        <field name="placeholder">AKIA...</field>
    </record>

    <record id="field_aws_iam_secret" model="credential.category.field">
        <field name="category_id" ref="credential_category_aws_iam" />
        <field name="code">api_secret</field>
        <field name="name">Secret Access Key</field>
        <field name="sequence" eval="20" />
        <field name="placeholder">Enter secret access key...</field>
    </record>

</odoo>
