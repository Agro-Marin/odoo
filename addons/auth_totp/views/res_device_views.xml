<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_device_view_kanban" model="ir.ui.view">
        <field name="name">res.device.kanban.auth_totp</field>
        <field name="model">res.device</field>
        <field name="inherit_id" ref="base.res_device_view_kanban" />
        <field name="arch" type="xml">
            <field name="ip_address" position="before">
                <field name="totp_device_id" invisible="1" />
                <span t-if="record.totp_device_id.raw_value" class="badge text-bg-info align-self-start">Trusted for 2FA</span>
            </field>
        </field>
    </record>

    <record id="res_device_view_form" model="ir.ui.view">
        <field name="name">res.device.form.auth_totp</field>
        <field name="model">res.device</field>
        <field name="inherit_id" ref="base.res_device_view_form" />
        <field name="arch" type="xml">
            <field name="last_activity" position="after">
                <field name="totp_device_id" />
            </field>
        </field>
    </record>

</odoo>
