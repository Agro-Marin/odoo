<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <!--
            `base_import.import` holds the raw bytes of whatever file a user
            uploaded, and its ACL grants read+write to every internal user. It
            is a TransientModel, but that confers no isolation: the ORM has no
            transient-specific access check and no record rule shipped for this
            model, so any internal user could read another user's uploaded file
            (payroll, customer lists, ...) or overwrite an import in progress,
            by guessing the sequential id. Verified end to end over JSON-RPC.

            Ownership is the only sensible boundary here: an import record is
            scratch space belonging to whoever created it.
        -->
        <record id="base_import_import_own_records" model="ir.rule">
            <field name="name">base_import.import: own records only</field>
            <field name="model_id" ref="model_base_import_import" />
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True" />
        </record>
    </data>

</odoo>
