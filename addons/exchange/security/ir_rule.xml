<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_exchange_channel_company" model="ir.rule">
        <field name="name">Exchange Channel: Company isolation</field>
        <field name="model_id" ref="model_exchange_channel" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_exchange_transmission_company" model="ir.rule">
        <field name="name">Exchange Transmission: Company isolation</field>
        <field name="model_id" ref="model_exchange_transmission" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
