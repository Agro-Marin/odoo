<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="exchange_transmission_view_list" model="ir.ui.view">
        <field name="name">exchange.transmission.list</field>
        <field name="model">exchange.transmission</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_created" />
                <field name="subject_id" />
                <field name="channel_id" />
                <field name="protocol" optional="hide" />
                <field name="intent" />
                <field name="document_kind" optional="show" />
                <field name="reference" />
                <field name="retry_count" optional="hide" />
                <field name="date_next_retry" optional="hide" />
                <field
                    name="state"
                    decoration-danger="state == 'rejected'"
                    decoration-muted="state == 'expired'"
                    decoration-success="state == 'accepted'"
                    decoration-warning="state == 'sent'" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="exchange_transmission_view_form" model="ir.ui.view">
        <field name="name">exchange.transmission.form</field>
        <field name="model">exchange.transmission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_send"
                        type="object"
                        string="Send"
                        invisible="is_settled"
                        class="oe_highlight" />
                    <button
                        name="action_read_verdict"
                        type="object"
                        string="Read Verdict"
                        invisible="state != 'sent'" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,queued,sent,accepted" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_view_subject"
                            type="object"
                            string="Subject"
                            icon="fa-file-text-o"
                            class="oe_stat_button" />
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1" /></h1>
                    </div>
                    <group name="main">
                        <group name="what">
                            <field name="subject_id" />
                            <field name="intent" />
                            <field name="document_kind" />
                            <field name="channel_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                        <group name="verdict">
                            <field name="reference" />
                            <field name="date_created" />
                            <field name="date_sent" />
                            <field name="date_settled" invisible="not is_settled" />
                            <field name="is_settled" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="message" string="Counterparty's Answer">
                            <field
                                name="message"
                                placeholder="Nothing said yet."
                                readonly="1" />
                        </page>
                        <page name="payload" string="Payload">
                            <group name="payload">
                                <field name="attachment_id" />
                                <field name="response_attachment_id" />
                            </group>
                        </page>
                        <page name="delivery" string="Delivery">
                            <group name="delivery">
                                <field name="event_log_id" />
                                <field name="retry_count" />
                                <field name="date_next_retry" />
                                <field name="parent_id" />
                                <field name="chain_previous_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="exchange_transmission_view_search" model="ir.ui.view">
        <field name="name">exchange.transmission.search</field>
        <field name="model">exchange.transmission</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference" />
                <field name="channel_id" />
                <field name="subject_id" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('is_settled', '=', False)]" />
                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('state', '=', 'rejected')]" />
                <filter
                    name="sent"
                    string="Awaiting a Verdict"
                    domain="[('state', '=', 'sent')]" />
                <separator />
                <filter
                    name="annul"
                    string="Annulments"
                    domain="[('intent', '=', 'annul')]" />
                <group name="groupby">
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_intent"
                        string="Intent"
                        context="{'group_by': 'intent'}" />
                    <filter
                        name="group_channel"
                        string="Channel"
                        context="{'group_by': 'channel_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="exchange_transmission_action" model="ir.actions.act_window">
        <field name="name">Transmissions</field>
        <field name="res_model">exchange.transmission</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
