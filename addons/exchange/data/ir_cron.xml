<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_send_queued" model="ir.cron">
        <field name="name">Exchange: send what is queued</field>
        <field name="model_id" ref="model_exchange_transmission" />
        <field name="state">code</field>
        <field name="code">model._cron_send_queued()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>

    <record id="cron_read_verdicts" model="ir.cron">
        <field name="name">Exchange: read the verdicts still outstanding</field>
        <field name="model_id" ref="model_exchange_transmission" />
        <field name="state">code</field>
        <field name="code">model._cron_read_verdicts()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>

    <record id="cron_read_inboxes" model="ir.cron">
        <field name="name">Exchange: read the inboxes</field>
        <field name="model_id" ref="model_exchange_channel" />
        <field name="state">code</field>
        <field name="code">model._cron_read_inboxes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

</odoo>
