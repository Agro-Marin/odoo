<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_s3_mirror_pending" model="ir.cron">
        <field name="name">S3: Mirror pending attachments (hybrid mode)</field>
        <field name="model_id" ref="base.model_ir_attachment" />
        <field name="state">code</field>
        <field name="code">model._cron_mirror_pending_to_s3()</field>
        <field name="interval_number" eval="5" />
        <field name="interval_type">minutes</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="active" eval="True" />
    </record>

</odoo>
