<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="certificate_certificate_view_search" model="ir.ui.view">
            <field
                name="name">certificate_certificate_view_search.inherit.l10n_es_edi_verifactu</field>
            <field name="model">certificate.certificate</field>
            <field
                name="inherit_id"
                ref="certificate.certificate_certificate_view_search" />
            <field name="arch" type="xml">
                <filter name="scope_general" position="after">
                    <filter
                        name="scope_verifactu"
                        string="Veri*Factu"
                        help="Veri*Factu certificates"
                        domain="[('scope','=','verifactu')]" />
                </filter>
            </field>
        </record>
        <record
            id="l10n_es_edi_verifactu_certificate_action"
            model="ir.actions.act_window">
            <field name="name">Certificates for Veri*Factu</field>
            <field name="res_model">certificate.certificate</field>
            <field name="view_mode">list,form</field>
            <field
                name="context">{'scope': 'verifactu', 'search_default_scope_verifactu': 1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create the first certificate</p>
            </field>
        </record>
        <record id="certificate_certificate_view_form" model="ir.ui.view">
            <field
                name="name">certificate_certificate_view_form.inherit.l10n_es_edi_verifactu</field>
            <field name="model">certificate.certificate</field>
            <field
                name="inherit_id"
                ref="certificate.certificate_certificate_view_form" />
            <field name="arch" type="xml">
                <field name="scope" position="attributes">
                    <attribute name="invisible">False</attribute>
                </field>
            </field>
        </record>
    </data>

</odoo>
