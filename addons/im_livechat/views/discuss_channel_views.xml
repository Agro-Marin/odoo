            id="discuss_channel_looking_for_help_action"
            model="ir.actions.act_window">
            <field name="name">Looking for Help</field>
            <field name="res_model">discuss.channel</field>
            <field name="view_mode">list,kanban,form</field>
            <field
                name="search_view_id"
