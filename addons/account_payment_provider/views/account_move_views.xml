<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoice_view_form_inherit_payment" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!--
            The user must capture/void the authorized transactions before registering a new payment.
            -->
            <xpath
                expr="//button[@id='account_invoice_payment_btn']"
                position="attributes">
                <attribute
                    name="invisible"
                    add="authorized_transaction_ids"
                    separator="or" />
            </xpath>
            <xpath
                expr="//button[@id='account_invoice_payment_secondary_btn']"
                position="attributes">
                <attribute
                    name="invisible"
                    add="authorized_transaction_ids"
                    separator="or" />
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                <field name="authorized_transaction_ids" invisible="1" />
                <button
                    name="payment_action_capture"
                    type="object"
                    string="Capture Transaction"
                    groups="account.group_account_invoice"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund') or state != 'posted' or not authorized_transaction_ids"
                    class="oe_highlight"
                    data-hotkey="shift+g" />
                <button
                    name="payment_action_void"
                    type="object"
                    string="Void Transaction"
                    confirm="Are you sure you want to void the authorized transaction? This action can't be undone."
                    groups="account.group_account_invoice"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund') or state != 'posted' or not authorized_transaction_ids"
                    data-hotkey="shift+v" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_payment_transactions"
                    type="object"
                    icon="fa-money"
                    groups="account.group_account_invoice"
                    invisible="transaction_count == 0"
                    class="oe_stat_button">
                    <field
                        name="transaction_count"
                        string="Payment Transaction"
                        widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
