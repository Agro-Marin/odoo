<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_smart_escalation" model="ir.cron">
        <field name="name">Smart Approval Escalation</field>
        <field name="model_id" ref="model_approval_request" />
        <field name="state">code</field>
        <field name="code">model.cron_smart_escalation()</field>
        <field name="repeat_interval" eval="4" />
        <field name="repeat_unit">hour</field>
        <field name="priority" eval="5" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_hand_delegated_activities_over" model="ir.cron">
        <field name="name">Approval Delegations: Hand Activities Over</field>
        <field name="model_id" ref="model_approval_approver" />
        <field name="state">code</field>
        <field name="code">model.cron_hand_delegated_activities_over()</field>
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field name="priority" eval="10" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_sync_decider_grants" model="ir.cron">
        <field name="name">Approvals: Keep the Decider Group on Who May Decide</field>
        <field name="model_id" ref="base.model_res_users_grant" />
        <field name="state">code</field>
        <field name="code">model._cron_sync_decider_grants()</field>
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field name="priority" eval="10" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_auto_expire" model="ir.cron">
        <field name="name">Auto-Expire Stale Approval Requests</field>
        <field name="model_id" ref="model_approval_request" />
        <field name="state">code</field>
        <field name="code">model.cron_auto_expire()</field>
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field name="priority" eval="10" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_consent_approval" model="ir.cron">
        <field name="name">Consent-Based Auto-Approval</field>
        <field name="model_id" ref="model_approval_request" />
        <field name="state">code</field>
        <field name="code">model.cron_consent_approval()</field>
        <field name="repeat_interval" eval="4" />
        <field name="repeat_unit">hour</field>
        <field name="priority" eval="8" />
        <field name="active" eval="True" />
    </record>

</odoo>
