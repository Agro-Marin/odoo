<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_refusal_reason_search" model="ir.ui.view">
        <field name="name">approval.refusal.reason.search</field>
        <field name="model">approval.refusal.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="category_ids" />
                <separator />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <separator />
            </search>
        </field>
    </record>

    <record id="view_approval_refusal_reason_list" model="ir.ui.view">
        <field name="name">approval.refusal.reason.list</field>
        <field name="model">approval.refusal.reason</field>
        <field name="arch" type="xml">
            <list string="Refusal Reasons" default_order="sequence,name">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="category_ids" widget="many2many_tags" optional="show" />
                <field name="usage_count" optional="show" />
                <field name="active" widget="boolean_toggle" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_approval_refusal_reason_form" model="ir.ui.view">
        <field name="name">approval.refusal.reason.form</field>
        <field name="model">approval.refusal.reason</field>
        <field name="arch" type="xml">
            <form string="Refusal Reason">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(approval.action_approval_request_all)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-times-circle"
                            invisible="usage_count == 0">
                            <field name="usage_count" string="Used" widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active" />
                    <group>
                        <group>
                            <field
                                name="name"
                                placeholder="e.g., Missing Documentation" />
                            <field name="sequence" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field
                                name="category_ids"
                                widget="many2many_tags"
                                placeholder="Leave empty for all categories" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            placeholder="Detailed explanation of when this reason should be used..." />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_refusal_reason" model="ir.actions.act_window">
        <field name="name">Refusal Reasons</field>
        <field name="res_model">approval.refusal.reason</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first refusal reason
            </p>
            <p>
                Refusal reasons help standardize why approval requests are rejected.
                This improves reporting and helps identify common issues.
            </p>
        </field>
    </record>

</odoo>
