<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.approval</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <!-- Applies before the default priority 16, so the sections exist by
             the time the modules that fill them are applied. -->
        <field name="priority" eval="12" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='anchor_governance']" position="before">
                <page name="partner_approvals" string="Approvals">
                    <!-- One section per kind of document that can be made
                         approvable per partner, in document-flow order. A
                         module fills the section it owns with
                         position="inside" and carries its own visibility on a
                         wrapper of its own, so two modules can share a
                         section without fighting over attributes. -->
                    <div name="approval_sales_documents" />
                    <div name="approval_purchase_documents" />
                    <div name="approval_accounting_documents" />
                </page>
            </xpath>
        </field>
    </record>

</odoo>
