<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_delegate_wizard_form" model="ir.ui.view">
        <field name="name">approval.delegate.wizard.form</field>
        <field name="model">approval.delegate.wizard</field>
        <field name="arch" type="xml">
            <form string="Delegate Approvals">
                <group>
                    <group>
                        <field name="user_id" readonly="1" />
                        <field name="allowed_company_ids" invisible="1" />
                        <field name="delegate_id" />
                    </group>
                    <group>
                        <field name="start_date" />
                        <field name="end_date" />
                    </group>
                </group>
                <group>
                    <field name="apply_to" widget="radio" />
                </group>
                <group string="Preview">
                    <div class="alert alert-info" role="alert">
                        <p>
                            <strong>Approvals to be delegated:</strong>
                        </p>
                        <ul>
                            <li><field name="pending_count" /> pending approval(s)</li>
                            <li><field name="waiting_count" /> waiting approval(s)</li>
                        </ul>
                    </div>
                </group>
                <footer>
                    <button
                        string="Confirm"
                        name="action_confirm"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_approval_delegate_wizard" model="ir.actions.act_window">
        <field name="name">Delegate Approvals</field>
        <field name="res_model">approval.delegate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
