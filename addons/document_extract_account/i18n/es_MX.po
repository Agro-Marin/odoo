#. module: document_extract_account
#: model_terms:ir.ui.view,arch_db:document_extract_account.extract_line_wizard_view_form
msgid ""
"<span>\n"
"                        The accepted lines do not add up to what the document says\n"
"                        its own lines come to before tax. One of the two is wrong.\n"
"                    </span>"
msgstr ""
"<span>\n"
"                        Las líneas aceptadas no suman lo que el documento dice\n"
"                        que suman sus propias líneas antes de impuestos. Una de las dos\n"
"                        está mal.\n"
"                    </span>"

#. module: document_extract_account
#: model_terms:ir.ui.view,arch_db:document_extract_account.extract_line_wizard_view_form
msgid ""
"<span>\n"
"                        These lines were read from the document and have not been\n"
"                        added to the bill. A line decides an account and a tax, and\n"
"                        the bill's total is computed from the lines, so nothing is\n"
"                        added until you say so.\n"
"                    </span>"
msgstr ""
"<span>\n"
"                        Estas líneas se leyeron del documento y no se han agregado\n"
"                        a la factura. Una línea decide una cuenta y un impuesto, y el\n"
"                        total de la factura se calcula a partir de las líneas, así que\n"
"                        no se agrega nada hasta que usted lo indique.\n"
"                    </span>"

#. module: document_extract_account
#: model_terms:ir.ui.view,arch_db:document_extract_account.view_move_form_document_extract
msgid ""
"<span>\n"
"                        This bill's document was read in part. What is missing is\n"
"                        listed in the Extraction tab, and needs a person.\n"
"                    </span>"
msgstr ""
"<span>\n"
"                        El documento de esta factura se leyó en parte. Lo que falta\n"
"                        está en la pestaña Extracción, y necesita a una persona.\n"
"                    </span>"

#. module: document_extract_account
#: model_terms:ir.ui.view,arch_db:document_extract_account.view_move_form_document_extract
