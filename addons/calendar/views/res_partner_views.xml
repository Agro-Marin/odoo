<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add contextual button on partner form view -->
    <record id="view_partners_form" model="ir.ui.view">
        <field name="name">res_partner.view.form.calendar</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="7" />
        <field name="arch" type="xml">
            <data>
                <xpath expr="//div[@name='anchor_buttons_meetings']" position="before">
                    <button
                        name="schedule_meeting"
                        type="object"
                        icon="fa-calendar"
                        context="{'partner_id': id, 'partner_name': name}"
                        class="oe_stat_button">
                        <field
                            name="meeting_count"
                            string="Meetings"
                            widget="statinfo" />
                    </button>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
