<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">APS Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'aps'">
                    <field
                        name="aps_merchant_identifier"
                        string="Merchant Identifier"
                        required="code == 'aps' and state != 'disabled'" />
                    <field
                        name="aps_access_code"
                        string="Access Code"
                        password="True"
                        required="code == 'aps' and state != 'disabled'" />
                    <field
                        name="aps_sha_request"
                        string="SHA Request Phrase"
                        password="True"
                        required="code == 'aps' and state != 'disabled'" />
                    <field
                        name="aps_sha_response"
                        string="SHA Response Phrase"
                        password="True"
                        required="code == 'aps' and state != 'disabled'" />
                </group>
            </group>
        </field>
    </record>

</odoo>
