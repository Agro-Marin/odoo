<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_mrp_production_backorder_form" model="ir.ui.view">
            <field name="name">Create Backorder</field>
            <field name="model">mrp.production.backorder</field>
            <field name="arch" type="xml">
                <form string="Create a Backorder">
                    <group>
                        <p colspan="2">
                            Create a backorder if you expect to process the remaining products later. Do not create a backorder if you will not process the remaining products.
                        </p>
                    </group>
                    <field name="show_backorder_lines" invisible="1" />
                    <field
                        name="mrp_production_backorder_line_ids"
                        invisible="not show_backorder_lines">
                        <list editable="top" create="0" delete="0">
                            <field name="mrp_production_id" force_save="1" />
                            <field name="to_backorder" widget="boolean_toggle" />
                        </list>
                    </field>
                    <footer>
                        <button
                            name="action_backorder"
                            type="object"
                            string="Create backorder"
                            colspan="1"
                            invisible="show_backorder_lines"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            name="action_backorder"
                            type="object"
                            string="Validate"
                            colspan="1"
                            invisible="not show_backorder_lines"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            name="action_close_mo"
                            type="object"
                            string="No Backorder"
                            invisible="show_backorder_lines"
                            data-hotkey="w" />
                        <button
                            special="cancel"
                            string="Discard"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_mrp_production_backorder" model="ir.actions.act_window">
            <field name="name">You produced less than the initial demand</field>
            <field name="res_model">mrp.production.backorder</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>

</odoo>
