<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_mrp_bom">
        <div class="o_mrp_bom_report_page container py-3 py-lg-5 px-0 bg-view">
            <div t-if="data.get('lines')">
                <div class="px-3 mb-5">
                    <h1>BoM Overview</h1>
                    <h3 t-out="data['name']" />
                    <hr t-if="data['bom_code']" />
                    <h6 t-if="data['bom_code']">Reference: <t t-out="data['bom_code']" /></h6>
                </div>
                <t t-set="currency" t-value="data['currency']" />
                <table class="o_mrp_bom_expandable table table-borderless">
                    <thead>
                        <tr>
                            <th name="th_mrp_bom_h">Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end" groups="uom.group_uom" />
                            <th class="text-end">Standard Cost</th>
                            <th class="text-end">Rolled-up Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td name="td_mrp_bom" t-out="data['name']" />
                            <td
                                class="text-end"
                                t-out="data['quantity']"
                                t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit&quot;}" />
                            <td
                                class="text-start"
                                groups="uom.group_uom"
                                t-out="data['uom_name']" />
                            <td />
                            <td
                                class="text-end"
                                t-out="data['bom_cost']"
                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}" />
                        </tr>
                        <t t-call="mrp.report_mrp_bom_pdf_line" />
                    </tbody>
                    <tfoot t-if="data['quantity'] &gt; 1">
                        <tr>
                            <td name="td_mrp_bom_f" class="text-end">
                                <span t-if="data['byproducts']" t-out="data['name']" />
                            </td>
                            <td />
                            <td
                                class="text-start"
                                groups="uom.group_uom"
                                t-out="data['uom_name']" />
                            <td class="text-end"><strong>Unit Cost</strong></td>
                            <td class="text-end"><t t-out="data['bom_cost'] / data['quantity']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}" /></td>
                        </tr>
                        <t
                            t-if="data['byproducts']"
                            t-foreach="data['byproducts']"
                            t-as="byproduct">
                            <tr t-if="byproduct['quantity'] &gt; 0">
                                <td
                                    name="td_mrp_bom_byproducts_f"
                                    class="text-end"
                                    t-out="byproduct['name']" />
                                <td />
                                <td
                                    class="text-start"
                                    groups="uom.group_uom"
                                    t-out="byproduct['uom_name']" />
                                <td class="text-end"><strong>Unit Cost</strong></td>
                                <td class="text-end"><t t-out="byproduct['bom_cost'] / byproduct['quantity']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}" /></td>
                            </tr>
                        </t>
                    </tfoot>
                </table>
            </div>
            <div
                t-else=""
                class="d-flex align-items-center justify-content-center h-50">
                <h4 class="text-muted">No data available.</h4>
            </div>
        </div>
    </template>

    <template id="report_mrp_bom_pdf_line">
        <t t-set="currency" t-value="data['currency']" />
        <t t-foreach="data['lines']" t-as="l">
            <tr>
                <td name="td_mrp_code">
                    <span
                        t-attf-style="padding-left: {{ str(l['level'] * 20) }}px"
                        t-out="l['name']" />
                </td>
                <td class="text-end">
                    <t
                        t-if="l['type'] == 'operation'"
                        t-out="l['quantity']"
                        t-options="{&quot;widget&quot;: &quot;float_time&quot;}" />
                    <t
                        t-else=""
                        t-out="l['quantity']"
                        t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Unit&quot;}" />
                </td>
                <td class="text-start" groups="uom.group_uom">
                    <t t-out="l['uom']" />
                </td>
                <td class="text-end">
                    <t
                        t-if="l.get('standard_cost') is not None"
                        t-out="l['standard_cost']"
                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}" />
                </td>
                <td
                    t-attf-class="text-end {{ 'text-muted' if l['type'] == 'component' else '' }}"
                    t-out="l['bom_cost']"
                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}" />
            </tr>
        </t>
    </template>

    <template id="report_bom_structure">
        <t t-set="data_report_landscape" t-value="True" />
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="data">
                <div class="page">
                    <t t-call="mrp.report_mrp_bom" />
                </div>
                <p class="o_page_break_before"> </p>
            </t>
        </t>
    </template>

</odoo>
