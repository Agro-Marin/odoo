#. module: speech_voice
#. odoo-python
#: code:addons/speech_voice/tools/utterance.py:0
msgid "A voice command lasts at most %(seconds)s seconds."
msgstr "Un comando de voz dura como máximo %(seconds)s segundos."

#. module: speech_voice
#. odoo-python
#: code:addons/speech_voice/tools/utterance.py:0
msgid "No speech engine may hear voice commands here."
msgstr "Aquí ningún motor de voz puede escuchar comandos de voz."

#. module: speech_voice
#. odoo-python
#: code:addons/speech_voice/controllers/main.py:0
msgid "The recording is not readable."
msgstr "La grabación no se puede leer."

#. module: speech_voice
#. odoo-python
#: code:addons/speech_voice/controllers/main.py:0
msgid "Too many voice commands; wait a moment."
msgstr "Demasiados comandos de voz; espere un momento."

#. module: speech_voice
#. odoo-javascript
#: code:addons/speech_voice/static/src/server_engine.js:0
msgid "Transcribing…"
msgstr "Transcribiendo…"

#. module: speech_voice
#. odoo-python
#: code:addons/speech_voice/controllers/main.py:0
msgid "Voice commands are for internal users."
msgstr "Los comandos de voz son para usuarios internos."

#. module: speech_voice
#. odoo-javascript
#: code:addons/speech_voice/static/src/server_engine.js:0
msgid ""
"What you say is sent to this Odoo server and transcribed there, or by the "
"speech service your administrator allowed for voice commands. Neither the "
"audio nor the words are kept."
msgstr ""
"Lo que dice se envía a este servidor de Odoo y se transcribe ahí, o en el "
"servicio de voz que su administrador permitió para comandos de voz. No se "
"guardan ni el audio ni las palabras."
