<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_age_range_view_search" model="ir.ui.view">
        <field name="name">res.partner.age.range.view.search</field>
        <field name="model">res.partner.age.range</field>
        <field name="arch" type="xml">
            <search string="Search Age Range">
                <field name="name" />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="res_partner_age_range_view_tree" model="ir.ui.view">
        <field name="name">Age Range</field>
        <field name="model">res.partner.age.range</field>
        <field name="arch" type="xml">
            <list string="Age Range" editable="bottom">
                <field name="name" />
                <field name="min_value" options="{'thousands_sep': false}" />
                <field name="max_value" options="{'thousands_sep': false}" />
            </list>
        </field>
    </record>

    <record id="res_partner_age_range_view_form" model="ir.ui.view">
        <field name="name">Age Range</field>
        <field name="model">res.partner.age.range</field>
        <field name="arch" type="xml">
            <form string="Age Range">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                    <group string="Birth years">
                        <field name="min_value" options="{'thousands_sep': false}" />
                        <field name="max_value" options="{'thousands_sep': false}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_age_range_action" model="ir.actions.act_window">
        <field name="name">Age Ranges</field>
        <field name="res_model">res.partner.age.range</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="res_partner_age_range_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an age range
            </p>
            <p>
                Ranges are cohorts of birth years, so a contact stays in the same
                one as time passes. Give the newest cohort no upper limit, and a
                contact born today still classifies.
            </p>
        </field>
    </record>

</odoo>
