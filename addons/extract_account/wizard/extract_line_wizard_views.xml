<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="extract_line_wizard_view_form" model="ir.ui.view">
        <field name="name">account.move.extract.line.wizard.form</field>
        <field name="model">account.move.extract.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Lines read from the document">
                <div class="alert alert-info" role="alert">
                    <span>
                        These lines were read from the document and have not been
                        added to the bill. A line decides an account and a tax, and
                        the bill's total is computed from the lines, so nothing is
                        added until you say so.
                    </span>
                </div>
                <div class="alert alert-warning" role="alert" invisible="totals_agree">
                    <span>
                        The accepted lines do not add up to what the document says
                        its own lines come to before tax. One of the two is wrong.
                    </span>
                </div>
                <group>
                    <group>
                        <field name="move_id" readonly="1" />
                        <field name="currency_id" invisible="1" />
                        <field name="read_total" string="Total on the document" />
                        <field
                            name="read_untaxed_total"
                            string="Its lines come to (before tax)" />
                    </group>
                    <group>
                        <field
                            name="proposed_total"
                            string="Accepted lines add up to" />
                        <field name="totals_agree" invisible="1" />
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sequence" widget="handle" />
                        <field name="currency_id" invisible="1" />
                        <field name="accepted" />
                        <field name="description" />
                        <field name="product_id" />
                        <field name="quantity" />
                        <field name="price_unit" />
                        <field name="subtotal" readonly="1" />
                        <field name="read_by" readonly="1" optional="show" />
                        <field name="confidence" readonly="1" optional="hide" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_apply"
                        string="Add the accepted lines"
                        type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
