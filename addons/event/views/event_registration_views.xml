<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- EVENT.REGISTRATION VIEWS -->
        <record id="view_event_registration_tree" model="ir.ui.view">
            <field name="name">event.registration.list</field>
            <field name="model">event.registration</field>
            <field name="arch" type="xml">
                <list
                    string="Registration"
                    default_order="create_date desc"
                    multi_edit="1"
                    sample="1"
                    class="o_event_registration_view_tree"
                    expand="1"
                    js_class="registration_summary_dialog_list">
                    <field name="barcode" column_invisible="True" />
                    <field name="active" column_invisible="True" />
                    <field
                        name="create_date"
                        string="Registration Date"
                        optional="show" />
                    <field name="name" />
                    <field name="partner_id" optional="hide" />
                    <field name="email" optional="show" />
                    <field name="phone_ids" widget="many2many_tags" optional="show" />
                    <field name="company_name" optional="hide" />
                    <field
                        name="event_id"
                        column_invisible="context.get('default_event_id')" />
                    <field
                        name="event_slot_id"
                        domain="[('event_id', '=', event_id)]" />
                    <field
                        name="event_ticket_id"
                        domain="[('event_id', '=', event_id)]" />
                    <field name="activity_ids" widget="list_activity" />
                    <field
                        name="state"
                        widget="badge"
                        decoration-info="state in ('draft', 'open')"
                        decoration-muted="state == 'cancel'"
                        decoration-success="state == 'done'" />
                    <field
                        name="company_id"
                        optional="hide"
                        groups="base.group_multi_company"
                        readonly="state != 'draft'" />
                    <field name="message_needaction" column_invisible="True" />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Registered"
                        icon="fa-check"
                        invisible="not active or state != 'draft'" />
                    <button
                        name="action_set_done"
                        type="object"
                        string="Mark as Attending"
                        icon="fa-level-down"
                        invisible="not active or state != 'open'" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        icon="fa-times"
                        invisible="not active or (state != 'open' and state != 'draft')"
                        class="o_btn_cancel_registration" />
                    <field
                        name="activity_exception_decoration"
                        widget="activity_exception" />
                </list>
            </field>
        </record>
        <record id="view_event_registration_form" model="ir.ui.view">
            <field name="name">event.registration.form</field>
            <field name="model">event.registration</field>
            <field name="arch" type="xml">
                <form string="Event Registration">
                    <field name="active" invisible="1" />
                    <header>
                        <button
                            name="action_send_badge_email"
                            type="object"
                            string="Send by Email"
                            invisible="not active or state != 'open' and state != 'done'"
                            class="oe_highlight" />
                        <button
                            name="action_confirm"
                            type="object"
                            string="Registered"
                            invisible="not active or state != 'draft'"
                            class="oe_highlight" />
                        <button
                            name="action_set_done"
                            type="object"
                            string="Attended"
                            invisible="not active or state != 'open'"
                            class="oe_highlight" />
                        <button
                            name="action_cancel"
                            type="object"
                            string="Cancel Registration"
                            invisible="not active or state == 'cancel'" />
                        <field
                            name="state"
                            widget="statusbar"
                            colspan="2"
                            options="{'clickable': '1'}"
                            readonly="False"
                            statusbar_visible="open,done" />
                    </header>
                    <sheet string="Registration">
                        <div class="oe_button_box" name="button_box" />
                        <widget
                            name="web_ribbon"
                            invisible="active"
                            bg_color="text-bg-danger"
                            text="Archived" />
                        <group>
                            <group name="attendee" string="Attendee">
                                <field name="name" class="o_text_overflow" />
                                <field name="email" />
                                <field
                                    name="phone_ids"
                                    widget="many2many_tags"
                                    class="o_force_ltr" />
                                <field
                                    name="company_name"
                                    placeholder="e.g. &quot;Azure Interior&quot;" />
                            </group>
                            <group name="event" string="Event Information">
                                <field
                                    name="event_id"
                                    context="{'name_with_seats_availability': True}"
                                    options="{'no_create': True}"
                                    class="text-break" />
                                <field
                                    name="event_slot_id"
                                    domain="[('event_id', '=', event_id)]"
                                    context="{'name_with_seats_availability': True}"
                                    options="{'no_open': True, 'no_create': True}"
                                    invisible="not is_multi_slots"
                                    required="is_multi_slots" />
                                <field
                                    name="event_ticket_id"
                                    domain="[('event_id', '=', event_id)]"
                                    context="{'name_with_seats_availability': True, 'is_event_multi_slots': is_multi_slots}"
                                    options="{'no_open': True, 'no_create': True}"
                                    invisible="not event_id" />
                                <field name="barcode" groups="base.group_no_one" />
                                <field name="partner_id" />
                                <field
                                    name="create_date"
                                    string="Registration Date"
                                    groups="base.group_no_one" />
                                <field name="date_closed" groups="base.group_no_one" />
                            </group>
                            <group
                                name="utm_link"
                                string="Marketing"
                                groups="base.group_no_one">
                                <field name="utm_campaign_id" />
                                <field name="utm_medium_id" />
                                <field name="utm_source_id" />
                            </group>
                        </group>
                        <field name="registration_properties" columns="2" />
                        <notebook>
                            <page name="questions" string="Questions">
                                <field name="registration_answer_ids" widget="one2many">
                                    <list editable="bottom">
                                        <field
                                            name="event_id"
                                            column_invisible="True" />
                                        <field
                                            name="question_id"
                                            domain="[('event_ids', 'in', event_id)]"
                                            options="{'no_create': True}" />
                                        <field name="question_type" string="Type" />
                                        <field
                                            name="value_answer_id"
                                            domain="[('question_id', '=', question_id)]"
                                            options="{'no_create': True}"
                                            invisible="question_type != 'simple_choice'" />
                                        <field
                                            name="value_text_box"
                                            invisible="question_type == 'simple_choice'" />
                                    </list>
                                    <kanban
                                        create="false"
                                        delete="false"
                                        class="o_kanban_mobile">
                                        <field name="event_id" />
                                        <field name="question_type" />
                                        <templates>
                                            <t
                                                t-name="card"
                                                class="justify-content-between">
                                                <field
                                                    name="question_id"
                                                    domain="[('event_ids', 'in', event_id)]"
                                                    class="fw-bold fs-5" />
                                                <field
                                                    name="value_answer_id"
                                                    domain="[('question_id', '=', question_id)]"
                                                    options="{'no_create': True}"
                                                    invisible="question_type != 'simple_choice'" />
                                                <field
                                                    name="value_text_box"
                                                    invisible="question_type == 'simple_choice'" />
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_post="True" />
                </form>
            </field>
        </record>
        <record id="event_registration_view_kanban" model="ir.ui.view">
            <field name="name">event.registration.kanban</field>
            <field name="model">event.registration</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <kanban
                    default_order="name, create_date desc"
                    sample="1"
                    class="o_event_attendee_kanban_view"
                    js_class="registration_summary_dialog_kanban">
                    <field name="name" />
                    <field name="state" />
                    <field name="active" />
                    <field name="barcode" />
                    <templates>
                        <t t-name="card" class="row g-0">
                            <widget
                                name="web_ribbon"
                                title="Archived"
                                invisible="active"
                                bg_color="text-bg-danger" />
                            <div class="col-8">
                                <field name="name" class="d-block fw-bold fs-5" />
                                <field
                                    name="state"
                                    widget="badge"
                                    class="position-absolute top-0 end-0 o_event_registration_kanban_badge"
                                    decoration-success="state == 'done'" />
                                <div class="o_kanban_event_registration_event_name">
                                    <field
                                        name="event_id"
                                        invisible="context.get('default_event_id')"
                                        class="text-truncate text-primary" />
                                </div>
                                <span
                                    class="text-truncate"
                                    invisible="not company_name">
                                    <i class="fa-solid fa-building" title="Attendee Company" /> <field name="company_name" />
                                </span>
                                <div id="event_ticket_id">
                                    <field name="registration_properties" />
                                    <div t-if="record.event_slot_id.raw_value">
                                        <i
                                            class="fa-solid fa-calendar-days"
                                            title="Slot" />
                                        <field
                                            name="event_slot_id"
                                            class="fw-bold text-truncate ms-1" />
                                    </div>
                                    <div t-if="record.event_ticket_id.raw_value">
                                        <i
                                            class="fa-solid fa-ticket"
                                            title="Ticket type" />
                                        <field
                                            name="event_ticket_id"
                                            class="fw-bold text-truncate ms-1" />
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_event_registration_calendar" model="ir.ui.view">
            <field name="name">event.registration.calendar</field>
            <field name="model">event.registration</field>
            <field name="priority" eval="2" />
            <field name="arch" type="xml">
                <calendar
                    string="Event Registration"
                    color="event_id"
                    date_start="event_begin_date"
                    date_stop="event_end_date"
                    event_limit="5">
                    <field name="event_id" filters="1" />
                    <field name="name" />
                    <field name="registration_properties" />
                </calendar>
            </field>
        </record>
        <record id="view_event_registration_pivot" model="ir.ui.view">
            <field name="name">event.registration.pivot</field>
            <field name="model">event.registration</field>
            <field name="arch" type="xml">
                <pivot string="Registration" sample="1" display_quantity="1">
                    <field name="event_id" type="row" />
                </pivot>
            </field>
        </record>
        <record id="view_event_registration_graph" model="ir.ui.view">
            <field name="name">event.registration.graph</field>
            <field name="model">event.registration</field>
            <field name="arch" type="xml">
                <graph string="Registration" sample="1">
                    <field name="event_id" />
                </graph>
            </field>
        </record>
        <record id="view_registration_search" model="ir.ui.view">
            <field name="name">event.registration.search</field>
            <field name="model">event.registration</field>
            <field name="arch" type="xml">
                <search string="Event Registration">
                    <field name="id" string="Registration ID" />
                    <field
                        name="name"
                        string="Participant"
                        filter_domain="['|', '|', ('name', 'ilike', self), ('email', 'ilike', self), ('company_name', 'ilike', self)]" />
                    <field name="company_id" />
                    <field name="partner_id" />
                    <field name="event_ticket_id" string="Ticket" />
                    <field name="event_id" />
                    <field name="event_user_id" string="Responsible" invisible="1" />
                    <field name="event_organizer_id" string="Organizer" invisible="1" />
                    <filter
                        name="filter_is_ongoing"
                        string="Ongoing Events"
                        domain="[('event_id.is_ongoing', '=', True)]" />
                    <filter
                        name="taken"
                        string="Taken"
                        domain="[('state', 'in', ['open', 'done'])]" />
                    <separator />
                    <filter
                        name="unconfirmed"
                        string="Unconfirmed"
                        domain="[('state', '=', 'draft')]" />
                    <filter
                        name="confirmed"
                        string="Registered"
                        domain="[('state', '=', 'open')]" />
                    <filter
                        name="attended"
                        string="Attended"
                        domain="[('state', '=', 'done')]" />
                    <separator />
                    <filter
                        name="filter_create_date"
                        string="Registration Date"
                        date="create_date" />
                    <filter
                        name="filter_event_begin_date"
                        string="Event Start Date"
                        date="event_begin_date" />
                    <filter
                        name="filter_date_closed"
                        string="Attended Date"
                        date="date_closed" />
                    <separator />
                    <filter
                        name="filter_activities_my"
                        string="My Activities"
                        domain="[('activity_user_id', '=', uid)]"
                        invisible="1" />
                    <separator invisible="1" />
                    <filter
                        name="activities_overdue"
                        string="Late Activities"
                        help="Show all records whose next activity date is past"
                        domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                        invisible="1" />
                    <filter
                        name="activities_today"
                        string="Today Activities"
                        domain="[('my_activity_date_deadline', '=', 'today')]"
                        invisible="1" />
                    <filter
                        name="activities_upcoming_all"
                        string="Future Activities"
                        domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                        invisible="1" />
                    <filter
                        name="filter_last_month_creation"
                        string="Last 30 days"
                        domain="[('create_date','&gt;', 'today -30d')]" />
                    <separator />
                    <filter
                        name="filter_inactive"
                        string="Archived"
                        domain="[('active', '=', False)]" />
                    <group>
                        <filter
                            name="partner"
                            string="Partner"
                            context="{'group_by':'partner_id'}" />
                        <filter
                            name="group_event"
                            string="Event"
                            context="{'group_by':'event_id'}" />
                        <filter
                            name="group_by_event_slot_id"
                            string="Slot"
                            context="{'group_by': 'event_slot_id'}" />
                        <filter
                            name="group_event_ticket_id"
                            string="Ticket Type"
                            context="{'group_by': 'event_ticket_id'}" />
                        <filter
                            name="status"
                            string="Status"
                            context="{'group_by':'state'}" />
                        <filter
                            name="group_by_create_date_week"
                            string="Registration Date"
                            context="{'group_by': 'create_date:week'}"
                            invisible="context.get('registration_view_hide_group_by_create_date_week')" />
                        <filter
                            name="group_by_create_date_day"
                            string="Registration Date"
                            context="{'group_by': 'create_date:day'}"
                            invisible="not context.get('registration_view_hide_group_by_create_date_week')" />
                        <filter
                            name="group_by_utm_campaign_id"
                            string="Campaign"
                            context="{'group_by': 'utm_campaign_id'}" />
                        <filter
                            name="group_by_utm_medium_id"
                            string="Medium"
                            context="{'group_by': 'utm_medium_id'}" />
                        <filter
                            name="group_by_utm_source_id"
                            string="Source"
                            context="{'group_by': 'utm_source_id'}" />
                        <filter
                            name="group_by_registration_properties"
                            string="Properties"
                            context="{'group_by': 'registration_properties'}" />
                    </group>
                </search>
            </field>
        </record>
        <!-- Search view typically used when coming from a specific event, meaning we don't need event-related fields -->
        <record id="event_registration_view_search_event_specific" model="ir.ui.view">
            <field name="name">event.registration.view.search.event.specific</field>
            <field name="model">event.registration</field>
            <field name="inherit_id" ref="view_registration_search" />
            <field name="mode">primary</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <xpath expr="//search/field[@name='event_id']" position="replace" />
                <xpath
                    expr="//search/filter[@name='filter_is_ongoing']"
                    position="replace" />
                <xpath
                    expr="//search/group/filter[@name='group_event']"
                    position="replace" />
            </field>
        </record>
        <!-- EVENT.REGISTRATION ACTIONS -->
        <record id="act_event_registration_from_event" model="ir.actions.act_window">
            <field name="name">Attendees</field>
            <field name="res_model">event.registration</field>
            <field name="path">attendees</field>
            <field name="view_mode">list,kanban,form,calendar,graph</field>
            <field
                name="search_view_id"
                ref="event_registration_view_search_event_specific" />
            <field name="domain">[('event_id', '=', active_id)]</field>
            <field
                name="context">{
            'default_event_id': active_id,
            'name_with_seats_availability': True,
            'search_default_taken': True,
        }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Attendees yet!
                </p><p>
                    Wait until Attendees register to your Event or create their registrations manually.
                </p>
            </field>
        </record>
        <!--
            We need kanban view to be displayed first while coming from registration desk, so we have created
            new action and changed the view sequence.
        -->
        <record id="event_registration_action_kanban" model="ir.actions.act_window">
            <field name="name">Attendees</field>
            <field name="res_model">event.registration</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('event_id', '=', active_id)]</field>
            <field
                name="context">{'default_event_id': active_id, 'is_registration_desk_view': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Attendees yet!
                </p><p>
                    Wait until Attendees register to your Event or create their registrations manually.
                </p>
            </field>
        </record>
        <record id="event_registration_action" model="ir.actions.act_window">
            <field name="name">Attendees</field>
            <field name="res_model">event.registration</field>
            <field name="view_mode">kanban,list,form</field>
            <field
                name="context">{'search_default_filter_is_ongoing': True, 'is_registration_desk_view': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Attendees expected yet!
                </p><p>
                    Wait until Attendees register to your Event or create their registrations manually.
                </p>
            </field>
        </record>
        <record id="event_registration_action_tree" model="ir.actions.act_window">
            <field name="name">Event registrations</field>
            <field name="res_model">event.registration</field>
            <field name="view_mode">list,kanban,form,calendar,graph</field>
        </record>
        <record id="action_registration" model="ir.actions.act_window">
            <field name="name">Attendees</field>
            <field name="res_model">event.registration</field>
            <field name="view_mode">graph,pivot,kanban,list,form</field>
            <field name="search_view_id" ref="view_registration_search" />
            <field name="domain" />
            <field
                name="context">{
                'search_default_filter_last_month_creation': 1,
                'search_default_taken': 1,
                'search_default_status': 2,
                'search_default_group_by_create_date_day': 3,
                'search_default_group_event': 1,
                'registration_view_hide_group_by_create_date_week': 1,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Attendees yet!
                </p><p>
                    From this dashboard you can report, analyze and detect trends regarding your event registrations.
                </p>
            </field>
        </record>
        <record
            id="event_registration_action_stats_from_event"
            model="ir.actions.act_window">
            <field name="name">Registration statistics</field>
            <field name="res_model">event.registration</field>
            <field name="view_mode">graph,pivot,kanban,list,form</field>
            <field
                name="search_view_id"
                ref="event_registration_view_search_event_specific" />
            <field name="domain">[('event_id', '=', active_id)]</field>
            <field
                name="context">{
                'default_event_id': active_id,
                'search_default_group_by_create_date_day': 1,
                'search_default_status': 2,
                'registration_view_hide_group_by_create_date_week': 1,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Attendees yet!
                </p><p>
                    From this dashboard you can report, analyze and detect trends regarding your event registrations.
                </p>
            </field>
        </record>
        <menuitem
            id="menu_action_registration"
            name="Attendees"
            parent="event.menu_reporting_events"
            action="action_registration"
            sequence="4"
            groups="event.group_event_user" />
    </data>

</odoo>
