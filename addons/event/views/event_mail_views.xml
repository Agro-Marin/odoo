<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- EVENT.MAIL VIEWS -->
        <record id="view_event_mail_form" model="ir.ui.view">
            <field name="name">event.mail.form</field>
            <field name="model">event.mail</field>
            <field name="arch" type="xml">
                <form string="Event Mail Scheduler">
                    <sheet>
                        <group>
                            <group>
                                <field name="event_id" placeholder="All Events" />
                                <field
                                    name="template_ref"
                                    widget="EventMailTemplateReferenceField"
                                    context="{'filter_template_on_event': True, 'default_model': 'event.registration'}"
                                    options="{'no_quick_create': True}" />
                                <field name="mail_state" />
                            </group>
                            <group>
                                <label for="interval_nbr" />
                                <div class="o_row">
                                    <field
                                        name="interval_nbr"
                                        invisible="interval_unit == 'now'" />
                                    <field name="interval_unit" />
                                </div>
                                <field name="interval_type" />
                                <field name="scheduled_date" />
                            </group>
                        </group>
                        <notebook groups="base.group_no_one">
                            <page name="registration_mails" string="Registration Mails">
                                <field name="mail_registration_ids">
                                    <list string="Registration mail" editable="bottom">
                                        <field name="registration_id" />
                                        <field name="scheduled_date" />
                                        <field name="mail_sent" string="Sent" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_event_mail_tree" model="ir.ui.view">
            <field name="name">event.mail.list</field>
            <field name="model">event.mail</field>
            <field name="arch" type="xml">
                <list string="Event Mail Schedulers">
                    <field name="event_id" />
                    <field
                        name="template_ref"
                        widget="EventMailTemplateReferenceField"
                        context="{'filter_template_on_event': True, 'default_model': 'event.registration'}"
                        options="{'no_quick_create': True}" />
                    <field name="scheduled_date" />
                    <field name="mail_count_done" />
                    <field
                        name="mail_state"
                        string=" "
                        widget="event_icon_selection"
                        nolabel="1"
                        options="{'sent': 'fa-solid fa-check', 'scheduled': 'fa-solid fa-hourglass-half', 'running': 'fa-solid fa-cogs', 'cancelled': 'fa-solid fa-times-circle'}" />
                </list>
            </field>
        </record>
        <record id="action_event_mail" model="ir.actions.act_window">
            <field name="name">Events Mail Schedulers</field>
            <field name="res_model">event.mail</field>
            <field name="context">{'create': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nothing Scheduled yet!
                </p><p>
                    Under this technical menu you will find all scheduled communication related to your events.
                </p>
            </field>
        </record>
    </data>

</odoo>
