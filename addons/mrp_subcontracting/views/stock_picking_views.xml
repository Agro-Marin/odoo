<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_form_view" model="ir.ui.view">
        <field name="name">stock.picking.form.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="show_subcontracting_details_visible" invisible="True" />
                <button
                    name="action_show_subcontract_details"
                    type="object"
                    string="Subcontracting Productions"
                    icon="fa-sitemap"
                    invisible="not show_subcontracting_details_visible"
                    class="oe_stat_button" />
            </xpath>
        </field>
    </record>

</odoo>
