<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="l10n_id_efaktur_document_form_view" model="ir.ui.view">
            <field name="name">l10n_id.efaktur_coretax.document.form.view</field>
            <field name="model">l10n_id_efaktur_coretax.document</field>
            <field name="arch" type="xml">
                <form string="E-faktur Document" create="false">
                    <header>
                        <field name="attachment_id" invisible="1" />
                        <button
                            name="action_download"
                            type="object"
                            string="Download"
                            groups="account.group_account_invoice"
                            invisible="not invoice_ids"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            name="action_regenerate"
                            type="object"
                            string="Regenerate File"
                            groups="account.group_account_invoice"
                            invisible="not invoice_ids or not attachment_id"
                            class="btn-secondary"
                            data-hotkey="q" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Draft" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" />
                            </group>
                        </group>
                        <notebook>
                            <page name="invoice_tab" id="invoice_tab" string="Invoices">
                                <field
                                    name="invoice_ids"
                                    widget="many2many"
                                    force_save="1">
                                    <list create="False" edit="False">
                                        <field name="name" />
                                        <field
                                            name="invoice_date"
                                            string="Accounting Date"
                                            optional="show" />
                                        <field
                                            name="amount_untaxed_in_currency_signed"
                                            string="Tax Excluded"
                                            optional="show"
                                            sum="Total" />
                                        <field
                                            name="amount_tax_signed"
                                            string="Tax"
                                            optional="hide"
                                            sum="Total" />
                                        <field
                                            name="amount_total_in_currency_signed"
                                            string="Total"
                                            optional="show"
                                            sum="Total" />
                                        <field name="currency_id" optional="hide" />
                                        <field
                                            name="display_state"
                                            string="Status"
                                            widget="badge"
                                            optional="show" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
        <record id="l10n_id_efaktur_document_list_view" model="ir.ui.view">
            <field name="name">l10n_id.efaktur_coretax.document.list.view</field>
            <field name="model">l10n_id_efaktur_coretax.document</field>
            <field name="arch" type="xml">
                <list string="E-faktur Document" create="false" sample="1">
                    <field name="name" />
                    <field
                        name="invoice_ids"
                        widget="many2many_tags"
                        options="{'no_quick_create': True}" />
                </list>
            </field>
        </record>
        <record id="l10n_id_efaktur_document_filter_view" model="ir.ui.view">
            <field name="name">l10n_id.efaktur_coretax.document.filter.view</field>
            <field name="model">l10n_id_efaktur_coretax.document</field>
            <field name="arch" type="xml">
                <search string="Search Document">
                    <filter
                        name="active"
                        string="Active"
                        domain="[('active', '=', True)]" />
                    <filter
                        name="inactive"
                        string="Inactive"
                        domain="[('active', '=', False)]" />
                </search>
            </field>
        </record>
    </data>

</odoo>
