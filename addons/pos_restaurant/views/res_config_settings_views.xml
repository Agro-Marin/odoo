<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_restaurant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="warning_text_pos_restaurant" position="replace" />
            <block position="inside" id="restaurant_section">
                <setting
                    id="floor_and_table_map"
                    string="Floors &amp; Tables Map"
                    help="Design floors and assign orders to tables"
                    invisible="is_kiosk_mode or not pos_module_pos_restaurant"
                    documentation="/applications/sales/point_of_sale/restaurant/floors_tables.html">
                    <div class="content-group">
                        <div class="mt16">
                            <label
                                for="pos_floor_ids"
                                string="Floors"
                                class="o_light_label me-2" />
                            <field
                                name="pos_floor_ids"
                                widget="many2many_tags"
                                readonly="pos_has_active_session" />
                        </div>
                        <div>
                            <button
                                name="%(pos_restaurant.action_restaurant_floor_form)d"
                                type="action"
                                string="Floors"
                                icon="oi-arrow-right"
                                class="btn-link" />
                        </div>
                    </div>
                </setting>
                <setting
                    id="iface_printbill"
                    string="Early Receipt Printing"
                    help="Allow to print receipt before payment"
                    invisible="not pos_module_pos_restaurant or is_kiosk_mode">
                    <field name="pos_iface_printbill" />
                </setting>
                <setting
                    id="iface_splitbill"
                    help="Split total or order lines"
                    invisible="not pos_module_pos_restaurant or is_kiosk_mode"
                    documentation="/applications/sales/point_of_sale/restaurant/bill_printing.html">
                    <field name="pos_iface_splitbill" string="Allow Bill Splitting" />
                </setting>
            </block>
            <div id="tip_product" position="after">
                <div
                    invisible="not pos_module_pos_restaurant or not pos_iface_tipproduct or country_code == 'BE'">
                    <field name="pos_set_tip_after_payment" class="oe_inline" />
                    <label
                        for="pos_set_tip_after_payment"
                        string="Add tip after payment"
                        class="fw-normal" />
                </div>
            </div>
            <block position="inside" id="pos_interface_section">
                <setting
                    help="Select the table first or after registering the order"
                    invisible="not pos_module_pos_restaurant or is_kiosk_mode">
                    <field name="pos_default_screen" widget="radio" />
                </setting>
            </block>
        </field>
    </record>

</odoo>
