<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <group position="after" id="invoice_send_settings">
                <group
                    string="Purchase Withholding"
                    invisible="'AR' not in fiscal_country_codes or not is_company">
                    <field
                        name="l10n_ar_partner_tax_ids"
                        widget="auto_save_res_partner"
                        colspan="2"
                        nolabel="1">
                        <list editable="top">
                            <field
                                name="tax_id"
                                domain="[('l10n_ar_withholding_payment_type', '=', 'supplier')]"
                                options="{'no_create': True, 'no_open': True}" />
                            <field name="from_date" optional="hide" />
                            <field name="to_date" optional="hide" />
                            <field name="ref" optional="hide" />
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>

</odoo>
