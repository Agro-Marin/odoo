<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hr_employee_change_request_view_form" model="ir.ui.view">
            <field name="name">hr.employee.change.request.form</field>
            <field name="model">hr.employee.change.request</field>
            <field name="arch" type="xml">
                <form string="Change Request">
                    <header>
                        <button
                            name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            groups="hr.group_hr_user"
                            invisible="state != 'pending'" />
                        <button
                            name="action_refuse"
                            string="Refuse"
                            type="object"
                            groups="hr.group_hr_user"
                            invisible="state != 'pending'" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" readonly="1" />
                                <field name="requested_by_uid" readonly="1" />
                            </group>
                            <group>
                                <field
                                    name="reviewed_by_uid"
                                    readonly="1"
                                    invisible="state == 'pending'" />
                                <field
                                    name="reviewed_on"
                                    readonly="1"
                                    invisible="state == 'pending'" />
                                <field
                                    name="refusal_reason"
                                    invisible="state != 'refused'" />
                            </group>
                        </group>
                        <group>
                            <group string="Private Information">
                                <label for="private_street" string="Private Address" />
                                <div class="o_address_format">
                                    <field
                                        name="private_street"
                                        placeholder="Street..."
                                        class="o_address_street"
                                        readonly="state != 'pending'" />
                                    <field
                                        name="private_street2"
                                        placeholder="Street 2..."
                                        class="o_address_street"
                                        readonly="state != 'pending'" />
                                    <field
                                        name="private_city"
                                        placeholder="City"
                                        class="o_address_city"
                                        readonly="state != 'pending'" />
                                    <field
                                        name="private_state_id"
                                        class="o_address_state"
                                        placeholder="State"
                                        options="{'no_open': True, 'no_create': True}"
                                        readonly="state != 'pending'" />
                                    <field
                                        name="private_zip"
                                        placeholder="ZIP"
                                        class="o_address_zip"
                                        readonly="state != 'pending'" />
                                    <field
                                        name="private_country_id"
                                        placeholder="Country"
                                        class="o_address_country"
                                        options="{'no_open': True, 'no_create': True}"
                                        readonly="state != 'pending'" />
                                </div>
                                <field
                                    name="private_email"
                                    readonly="state != 'pending'" />
                                <field
                                    name="private_phone_ids"
                                    widget="many2many_tags"
                                    readonly="state != 'pending'" />
                            </group>
                            <group string="Emergency Contact">
                                <field
                                    name="emergency_contact"
                                    placeholder="e.g. John Doe"
                                    readonly="state != 'pending'" />
                                <field
                                    name="emergency_phone_ids"
                                    widget="many2many_tags"
                                    readonly="state != 'pending'" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="hr_employee_change_request_view_list" model="ir.ui.view">
            <field name="name">hr.employee.change.request.list</field>
            <field name="model">hr.employee.change.request</field>
            <field name="arch" type="xml">
                <list string="Change Requests">
                    <field name="create_date" string="Requested" />
                    <field name="employee_id" />
                    <field name="requested_by_uid" />
                    <field name="reviewed_by_uid" optional="hide" />
                    <field name="state" widget="badge" />
                </list>
            </field>
        </record>
        <record id="hr_employee_change_request_action" model="ir.actions.act_window">
            <field name="name">Information Change Requests</field>
            <field name="res_model">hr.employee.change.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
        </record>
        <record id="hr_employee_change_request_view_search" model="ir.ui.view">
            <field name="name">hr.employee.change.request.search</field>
            <field name="model">hr.employee.change.request</field>
            <field name="arch" type="xml">
                <search string="Change Requests">
                    <field name="employee_id" />
                    <filter
                        name="pending"
                        string="Pending"
                        domain="[('state', '=', 'pending')]" />
                    <group>
                        <filter
                            name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}" />
                    </group>
                </search>
            </field>
        </record>
    </data>

</odoo>
