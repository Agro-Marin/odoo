<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hr_employee_create_version_wizard_view_form" model="ir.ui.view">
            <field name="name">hr.employee.create.version.wizard.view.form</field>
            <field name="model">hr.employee.create.version.wizard</field>
            <field name="arch" type="xml">
                <form string="New Employee Versions">
                    <sheet>
                        <group>
                            <field
                                name="employee_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_open': True}" />
                            <field name="date_version" placeholder="Choose a date" />
                        </group>
                        <div class="text-muted" invisible="not employee_count">
                            A new version will be created for
                            <field
                                name="employee_count"
                                nolabel="1"
                                class="oe_inline" />
                            employee(s), starting on that date.
                        </div>
                    </sheet>
                    <footer>
                        <button
                            name="action_create_versions"
                            string="Create"
                            type="object"
                            class="oe_highlight"
                            data-hotkey="q" />
                        <button
                            string="Discard"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
        <record
            id="hr_employee_create_version_wizard_action"
            model="ir.actions.act_window">
            <field name="name">New Employee Versions</field>
            <field name="res_model">hr.employee.create.version.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="hr.model_hr_employee" />
            <field name="binding_view_types">list</field>
            <field name="group_ids" eval="[(4, ref('hr.group_hr_user'))]" />
        </record>
    </data>

</odoo>
