<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_partner_relationship" model="res.groups.privilege">
        <field name="name">Partner Relationships</field>
        <field name="category_id" ref="base.module_category_sales" />
        <field
            name="description">Recording and analysis of the family, ritual and commercial ties between contacts</field>
        <field name="sequence" eval="10" />
    </record>

    <record id="group_partner_relationship_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence" eval="10" />
        <field name="privilege_id" ref="res_groups_privilege_partner_relationship" />
        <field
            name="comment">Can record and edit the relationships between contacts.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_partner_relationship_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="res_groups_privilege_partner_relationship" />
        <field
            name="comment">Can configure the relationship type catalog, its kinship degrees and its risk weights.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('partner_relationship.group_partner_relationship_user'))]" />
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('partner_relationship.group_partner_relationship_manager'))]" />
    </record>

</odoo>
