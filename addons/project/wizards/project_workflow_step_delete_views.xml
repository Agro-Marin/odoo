<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_workflow_step_delete_wizard" model="ir.ui.view">
        <field name="name">project.workflow.step.delete.wizard.form</field>
        <field name="model">project.workflow.step.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Workflow Step">
                <field name="tasks_count" invisible="1" />
                <field name="steps_active" invisible="1" />
                <div invisible="tasks_count &gt; 0">
                    <p>Are you sure you want to delete these workflow steps?</p>
                </div>
                <div invisible="not steps_active or tasks_count == 0">
                    <p>You cannot delete workflow steps containing tasks. You can either archive them or first delete all of their tasks.</p>
                </div>
                <div invisible="steps_active or tasks_count == 0">
                    <p>You cannot delete workflow steps containing tasks. You should first delete all of their tasks.</p>
                </div>
                <footer>
                    <button
                        name="action_archive"
                        type="object"
                        string="Archive Steps"
                        invisible="not steps_active or tasks_count == 0"
                        class="btn btn-primary"
                        data-hotkey="q" />
                    <button
                        name="action_unlink"
                        type="object"
                        string="Delete"
                        invisible="tasks_count &gt; 0"
                        class="btn btn-primary"
                        data-hotkey="w" />
                    <button special="cancel" string="Discard" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="view_project_workflow_step_delete_confirmation_wizard"
        model="ir.ui.view">
        <field name="name">project.workflow.step.delete.wizard.form</field>
        <field name="model">project.workflow.step.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Workflow Step">
                <div>
                    <p>This will archive the workflow steps and all the tasks they contain from the following projects:</p>
                    <field name="project_ids" readonly="1">
                        <list>
                            <field name="name" />
                        </list>
                    </field>
                    <p>Are you sure you want to continue?</p>
                </div>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn btn-primary"
                        data-hotkey="q" />
                    <button special="cancel" string="Discard" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_project_workflow_step_unarchive_wizard" model="ir.ui.view">
        <field name="name">project.workflow.step.delete.wizard.form</field>
        <field name="model">project.workflow.step.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Workflow Step">
                <div>
                    <p>Would you like to unarchive all of the tasks contained in these workflow steps as well?</p>
                </div>
                <footer>
                    <button
                        name="action_unarchive_task"
                        type="object"
                        string="Confirm"
                        class="btn btn-primary" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
