<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_history_search" model="ir.ui.view">
        <field name="name">project.history.search</field>
        <field name="model">project.history</field>
        <field name="arch" type="xml">
            <search string="Project History">
                <field name="name" />
                <field name="tag_ids" />
                <separator />
                <filter
                    name="over_schedule"
                    string="Over Schedule"
                    domain="[('duration_variance_pct', '&gt;', 0)]" />
                <filter
                    name="over_budget"
                    string="Over Budget"
                    domain="[('hours_variance_pct', '&gt;', 0)]" />
                <separator />
                <filter
                    name="team_small"
                    string="Small Team (1-3)"
                    domain="[('team_size', '&gt;=', 1), ('team_size', '&lt;=', 3)]" />
                <filter
                    name="team_medium"
                    string="Medium Team (4-8)"
                    domain="[('team_size', '&gt;=', 4), ('team_size', '&lt;=', 8)]" />
                <filter
                    name="team_large"
                    string="Large Team (9+)"
                    domain="[('team_size', '&gt;=', 9)]" />
                <group>
                    <filter
                        name="group_tags"
                        string="Tags"
                        context="{'group_by': 'tag_ids'}" />
                    <filter
                        name="group_date"
                        string="Completion Date"
                        context="{'group_by': 'date_completed:quarter'}" />
                    <filter
                        name="group_team_size"
                        string="Team Size"
                        context="{'group_by': 'team_size'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_history_form" model="ir.ui.view">
        <field name="name">project.history.form</field>
        <field name="model">project.history</field>
        <field name="arch" type="xml">
            <form string="Project History" create="0">
                <sheet>
                    <group>
                        <group string="Project">
                            <field name="name" />
                            <field name="project_id" />
                            <field name="date_start" />
                            <field name="date_completed" />
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}" />
                        </group>
                        <group string="Team">
                            <field name="task_count" />
                            <field name="team_size" />
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="planned_duration_days" />
                            <field name="actual_duration_days" />
                            <field
                                name="duration_variance_pct"
                                decoration-danger="duration_variance_pct &gt; 20"
                                decoration-success="duration_variance_pct &lt;= 0"
                                decoration-warning="duration_variance_pct &gt; 0" />
                        </group>
                        <group string="Effort">
                            <field name="planned_hours" widget="float_time" />
                            <field name="actual_hours" widget="float_time" />
                            <field
                                name="hours_variance_pct"
                                decoration-danger="hours_variance_pct &gt; 20"
                                decoration-success="hours_variance_pct &lt;= 0"
                                decoration-warning="hours_variance_pct &gt; 0" />
                        </group>
                    </group>
                    <group>
                        <group string="Performance">
                            <field name="avg_lead_time" widget="float_time" />
                            <field name="avg_cycle_time" widget="float_time" />
                            <field name="deadline_compliance_pct" widget="percentage" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_history_list" model="ir.ui.view">
        <field name="name">project.history.list</field>
        <field name="model">project.history</field>
        <field name="arch" type="xml">
            <list string="Project History" create="0">
                <field name="name" />
                <field name="date_completed" />
                <field name="task_count" />
                <field name="team_size" />
                <field name="planned_duration_days" />
                <field name="actual_duration_days" />
                <field
                    name="duration_variance_pct"
                    decoration-danger="duration_variance_pct &gt; 20"
                    decoration-success="duration_variance_pct &lt;= 0"
                    decoration-warning="duration_variance_pct &gt; 0" />
                <field
                    name="deadline_compliance_pct"
                    widget="percentage"
                    optional="show" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    optional="show"
                    options="{'color_field': 'color'}" />
            </list>
        </field>
    </record>

    <record id="action_project_history" model="ir.actions.act_window">
        <field name="name">Project History</field>
        <field name="res_model">project.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_history_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No project history yet
            </p>
            <p>
                Historical project data accumulates as projects are completed.
                Use it for reference class forecasting on new projects.
            </p>
        </field>
    </record>

</odoo>
