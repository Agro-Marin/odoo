<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_retrospective_search" model="ir.ui.view">
        <field name="name">project.retrospective.search</field>
        <field name="model">project.retrospective</field>
        <field name="arch" type="xml">
            <search string="Retrospectives">
                <field name="name" />
                <field name="project_id" />
                <field name="facilitator_id" />
                <separator />
                <filter
                    name="open_actions"
                    string="Has Open Actions"
                    domain="[('action_ids.state', 'in', ['open', 'in_progress'])]" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <group>
                    <filter
                        name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}" />
                    <filter
                        name="group_date"
                        string="Date"
                        context="{'group_by': 'date:month'}" />
                    <filter
                        name="group_facilitator"
                        string="Facilitator"
                        context="{'group_by': 'facilitator_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_retrospective_form" model="ir.ui.view">
        <field name="name">project.retrospective.form</field>
        <field name="model">project.retrospective</field>
        <field name="arch" type="xml">
            <form string="Retrospective">
                <header>
                    <button
                        name="action_carry_forward"
                        type="object"
                        string="Carry Forward Actions"
                        invisible="not previous_id or state == 'done'"
                        class="oe_highlight" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Sprint 5 Retro" />
                            <field name="project_id" />
                            <field name="date" />
                        </group>
                        <group>
                            <field
                                name="facilitator_id"
                                widget="many2one_avatar_user" />
                            <field
                                name="previous_id"
                                domain="[('project_id', '=', project_id)]" />
                            <field name="open_action_count" />
                        </group>
                    </group>
                    <notebook>
                        <page name="went_well" string="What Went Well">
                            <field
                                name="went_well"
                                placeholder="Practices and decisions worth repeating..." />
                        </page>
                        <page name="to_improve" string="What Needs Improvement">
                            <field
                                name="to_improve"
                                placeholder="Areas where changes would improve outcomes..." />
                        </page>
                        <page name="actions" string="Action Items">
                            <field name="action_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field
                                        name="owner_id"
                                        widget="many2one_avatar_user" />
                                    <field name="category" optional="show" />
                                    <field name="date_due" />
                                    <field name="state" />
                                    <field name="carried_from_id" optional="hide" />
                                    <field name="resolution_note" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="project_retrospective_list" model="ir.ui.view">
        <field name="name">project.retrospective.list</field>
        <field name="model">project.retrospective</field>
        <field name="arch" type="xml">
            <list string="Retrospectives" default_order="date desc">
                <field name="date" />
                <field name="name" />
                <field name="project_id" />
                <field name="facilitator_id" widget="many2one_avatar_user" />
                <field name="action_count" />
                <field
                    name="open_action_count"
                    decoration-danger="open_action_count &gt; 0" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'" />
            </list>
        </field>
    </record>

    <record id="action_project_retrospective" model="ir.actions.act_window">
        <field name="name">Retrospectives</field>
        <field name="res_model">project.retrospective</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_retrospective_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No retrospectives yet
            </p>
            <p>
                Run regular retrospectives to capture lessons learned and
                track improvement actions.
            </p>
        </field>
    </record>

    <record
        id="action_project_retrospective_from_project"
        model="ir.actions.act_window">
        <field name="name">Retrospectives</field>
        <field name="res_model">project.retrospective</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_retrospective_search" />
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>

    <record id="project_retrospective_action_search" model="ir.ui.view">
        <field name="name">project.retrospective.action.search</field>
        <field name="model">project.retrospective.action</field>
        <field name="arch" type="xml">
            <search string="Retrospective Actions">
                <field name="name" />
                <field name="project_id" />
                <field name="owner_id" />
                <separator />
                <filter
                    name="open"
                    string="Open"
                    domain="[('state', 'in', ['open', 'in_progress'])]" />
                <filter
                    name="my_actions"
                    string="My Actions"
                    domain="[('owner_id', '=', uid)]" />
                <group>
                    <filter
                        name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}" />
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'category'}" />
                    <filter
                        name="group_owner"
                        string="Owner"
                        context="{'group_by': 'owner_id'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_retrospective_action_list" model="ir.ui.view">
        <field name="name">project.retrospective.action.list</field>
        <field name="model">project.retrospective.action</field>
        <field name="arch" type="xml">
            <list string="Retrospective Actions" editable="bottom">
                <field name="name" />
                <field name="project_id" />
                <field name="retrospective_id" />
                <field name="owner_id" widget="many2one_avatar_user" />
                <field name="category" optional="show" />
                <field name="date_due" />
                <field name="state" />
                <field name="resolution_note" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_project_retrospective_actions" model="ir.actions.act_window">
        <field name="name">Retrospective Actions</field>
        <field name="res_model">project.retrospective.action</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="project_retrospective_action_search" />
        <field
            name="context">{'search_default_open': 1, 'search_default_group_category': 1, 'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No open retrospective actions
            </p>
        </field>
    </record>

</odoo>
