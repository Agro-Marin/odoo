<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_risk_search" model="ir.ui.view">
        <field name="name">project.risk.search</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <search string="Risks">
                <field name="name" />
                <field name="project_id" />
                <field name="owner_id" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <separator />
                <filter
                    name="critical"
                    string="Critical"
                    domain="[('risk_level', '=', 'critical')]" />
                <filter
                    name="high"
                    string="High"
                    domain="[('risk_level', 'in', ['high', 'critical'])]" />
                <separator />
                <filter
                    name="my_risks"
                    string="My Risks"
                    domain="[('owner_id', '=', uid)]" />
                <group>
                    <filter
                        name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}" />
                    <filter
                        name="group_level"
                        string="Risk Level"
                        context="{'group_by': 'risk_level'}" />
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'category'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_owner"
                        string="Owner"
                        context="{'group_by': 'owner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_risk_form" model="ir.ui.view">
        <field name="name">project.risk.form</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <form string="Risk">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="identified,assessed,mitigated,resolved" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field
                                name="name"
                                placeholder="e.g. Key developer leaves mid-project" />
                            <field name="project_id" />
                            <field
                                name="task_id"
                                domain="[('project_id', '=', project_id)]" />
                            <field name="category" />
                            <field name="owner_id" widget="many2one_avatar_user" />
                        </group>
                        <group>
                            <field name="probability" />
                            <field name="impact" />
                            <field name="risk_score" />
                            <field
                                name="risk_level"
                                widget="badge"
                                decoration-danger="risk_level in ('critical', 'high')"
                                decoration-success="risk_level == 'low'"
                                decoration-warning="risk_level == 'medium'" />
                            <field name="response_strategy" />
                            <field name="date_identified" />
                            <field
                                name="date_resolved"
                                invisible="state != 'resolved'" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field
                                name="description"
                                placeholder="Describe the risk in detail..." />
                        </page>
                        <page name="response_plan" string="Response Plan">
                            <field
                                name="response_plan"
                                placeholder="What actions will be taken to address this risk?" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="project_risk_list" model="ir.ui.view">
        <field name="name">project.risk.list</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <list
                string="Risk Register"
                default_order="risk_score desc"
                decoration-danger="risk_level in ('critical', 'high')"
                decoration-warning="risk_level == 'medium'">
                <field name="name" />
                <field name="project_id" />
                <field name="category" />
                <field name="probability" />
                <field name="impact" />
                <field name="risk_score" />
                <field
                    name="risk_level"
                    widget="badge"
                    decoration-danger="risk_level in ('critical', 'high')"
                    decoration-success="risk_level == 'low'"
                    decoration-warning="risk_level == 'medium'" />
                <field name="response_strategy" optional="show" />
                <field name="owner_id" widget="many2one_avatar_user" optional="show" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="project_risk_pivot" model="ir.ui.view">
        <field name="name">project.risk.pivot</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <pivot string="Risk Matrix">
                <field name="probability" type="row" />
                <field name="impact" type="col" />
            </pivot>
        </field>
    </record>

    <record id="action_project_risk" model="ir.actions.act_window">
        <field name="name">Risk Register</field>
        <field name="res_model">project.risk</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="project_risk_search" />
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No risks identified yet
            </p>
            <p>
                Track project risks with probability × impact scoring
                and response strategies.
            </p>
        </field>
    </record>

    <record id="action_project_risk_from_project" model="ir.actions.act_window">
        <field name="name">Risks</field>
        <field name="res_model">project.risk</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="project_risk_search" />
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field
            name="context">{'default_project_id': active_id, 'search_default_active': 1}</field>
    </record>

</odoo>
