<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_benefit_search" model="ir.ui.view">
        <field name="name">project.benefit.search</field>
        <field name="model">project.benefit</field>
        <field name="arch" type="xml">
            <search string="Benefits">
                <field name="name" />
                <field name="project_id" />
                <field name="accountable_id" />
                <separator />
                <filter
                    name="expected"
                    string="Expected"
                    domain="[('state', '=', 'expected')]" />
                <filter
                    name="tracking"
                    string="Tracking"
                    domain="[('state', '=', 'tracking')]" />
                <filter
                    name="achieved"
                    string="Achieved"
                    domain="[('state', '=', 'achieved')]" />
                <separator />
                <filter
                    name="review_due"
                    string="Review Due"
                    domain="[('date_review', '&lt;=', context_today().strftime('%Y-%m-%d'))]" />
                <group>
                    <filter
                        name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_owner"
                        string="Owner"
                        context="{'group_by': 'accountable_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_benefit_form" model="ir.ui.view">
        <field name="name">project.benefit.form</field>
        <field name="model">project.benefit</field>
        <field name="arch" type="xml">
            <form string="Benefit">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="expected,tracking,achieved" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field
                                name="name"
                                placeholder="e.g. Reduce customer churn by 15%" />
                            <field name="project_id" />
                            <field
                                name="accountable_id"
                                widget="many2one_avatar_user" />
                            <field name="date_review" />
                        </group>
                        <group>
                            <field name="target_value" />
                            <field name="target_unit" placeholder="e.g. %, $, NPS" />
                            <field name="actual_value" />
                            <field name="achievement_pct" widget="progressbar" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field
                                name="description"
                                placeholder="How will this benefit be realized?" />
                        </page>
                        <page name="measurement" string="Measurement">
                            <field
                                name="measurement_method"
                                placeholder="How exactly will this benefit be measured? Be specific." />
                        </page>
                        <page name="notes" string="Review Notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="project_benefit_list" model="ir.ui.view">
        <field name="name">project.benefit.list</field>
        <field name="model">project.benefit</field>
        <field name="arch" type="xml">
            <list string="Benefits">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="project_id" />
                <field name="target_value" />
                <field name="target_unit" />
                <field name="actual_value" />
                <field name="achievement_pct" widget="progressbar" />
                <field
                    name="accountable_id"
                    widget="many2one_avatar_user"
                    optional="show" />
                <field name="date_review" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'expected'"
                    decoration-muted="state == 'not_achieved'"
                    decoration-success="state == 'achieved'"
                    decoration-warning="state == 'tracking'" />
            </list>
        </field>
    </record>

    <record id="action_project_benefit" model="ir.actions.act_window">
        <field name="name">Benefits</field>
        <field name="res_model">project.benefit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_benefit_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No benefits defined yet
            </p>
            <p>
                Track expected business benefits and measure whether
                they are actually realized after project delivery.
            </p>
        </field>
    </record>

    <record id="action_project_benefit_from_project" model="ir.actions.act_window">
        <field name="name">Benefits</field>
        <field name="res_model">project.benefit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>

</odoo>
