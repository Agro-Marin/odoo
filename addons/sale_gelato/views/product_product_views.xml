<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_normal_form" model="ir.ui.view">
        <field name="name">Product Product Normal Form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.view_product_product_form_normal" />
        <field name="arch" type="xml">
            <group name="description" position="after">
                <group
                    string="Gelato"
                    groups="base.group_no_one"
                    invisible="not gelato_product_uid">
                    <field name="gelato_product_uid" string="Product UID" />
                </group>
            </group>
        </field>
    </record>

    <record id="product_product_easy_form" model="ir.ui.view">
        <field name="name">Product Product Easy Form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.view_product_product_form_easy_edit" />
        <field name="arch" type="xml">
            <group name="sales" position="after">
                <group
                    string="Gelato"
                    groups="base.group_no_one"
                    invisible="not gelato_product_uid">
                    <field name="gelato_product_uid" string="Product UID" />
                </group>
            </group>
        </field>
    </record>

</odoo>
