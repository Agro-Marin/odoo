<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--  MAILING !-->
    <record id="view_mail_mass_mailing_search" model="ir.ui.view">
        <field name="name">mailing.mailing.search</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <search string="Mailings">
                <field
                    name="name"
                    string="Mailing"
                    filter_domain="['|', ('name', 'ilike', self), ('subject', 'ilike', self)]" />
                <field
                    name="campaign_id"
                    string="Campaign"
                    groups="mass_mailing.group_mass_mailing_campaign" />
                <filter
                    name="assigned_to_me"
                    string="My Mailings"
                    help="Mailings that are assigned to me"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter
                    name="filter_favorite"
                    string="Favorites"
                    domain="[('is_favorite', '=', True)]" />
                <filter
                    name="filter_my_favorite"
                    string="My Favorites"
                    domain="[('is_user_favorite', '=', True)]" />
                <separator />
                <filter name="filter_sent_date" date="sent_date" />
                <separator />
                <filter
                    name="filter_ab_test"
                    string="A/B Tests"
                    domain="[('ab_testing_enabled', '=', True)]" />
                <filter
                    name="filter_ab_test_to_review"
                    string="A/B Tests to review"
                    domain="[('ab_testing_enabled', '=', True), ('ab_testing_winner_selection', '=', 'manual'), ('ab_testing_completed', '=', False)]" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="sent_by"
                        string="Sent By"
                        context="{'group_by': 'email_from'}" />
                    <filter
                        name="group_by_contact_list_ids"
                        string="Mailing List"
                        context="{'group_by': 'contact_list_ids'}" />
                    <separator />
                    <filter
                        name="sent_date"
                        string="Sent Period"
                        context="{'group_by': 'sent_date'}" />
                </group>
                </search>
        </field>
    </record>

    <record id="view_mail_mass_mailing_tree" model="ir.ui.view">
        <field name="name">mailing.mailing.list</field>
        <field name="model">mailing.mailing</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Mailings" sample="1" class="o_mass_mailing_mailing_tree">
                <field name="calendar_date" string="Date" widget="datetime" />
                <field name="subject" readonly="state in ('sending', 'done')" />
                <field name="mailing_model_id" string="Recipients" optional="hide" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field
                    name="ab_testing_enabled"
                    string="A/B Test"
                    groups="mass_mailing.group_mass_mailing_campaign" />
                <field
                    name="campaign_id"
                    string="Campaign"
                    optional="hide"
                    groups="mass_mailing.group_mass_mailing_campaign" />
                <field name="sent" sum="Total" />
                <field
                    name="received_ratio"
                    string="Delivered (%)"
                    widget="progressbar"
                    avg="Average"
                    class="d-flex align-items-center ps-0 ps-lg-5" />
                <field
                    name="opened_ratio"
                    string="Opened (%)"
                    widget="progressbar"
                    avg="Average"
                    class="d-flex align-items-center ps-0 ps-lg-5" />
                <field
                    name="bounced_ratio"
                    string="Bounced (%)"
                    optional="hide"
                    avg="Average" />
                <field name="clicks_ratio" string="Clicked (%)" avg="Average" />
                <field name="replied_ratio" string="Replied (%)" avg="Average" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state in ['draft', 'in_queue']"
                    decoration-success="state == 'sending' or state == 'done'" />
            </list>
        </field>
    </record>

    <!-- Main form view for inheriting from -->
    <record id="view_mail_mass_mailing_form" model="ir.ui.view">
        <field name="name">mailing.mailing.form</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <form string="Mailing" class="o_mass_mailing_mailing_form">
                <header>
                    <button
                        name="action_launch"
                        type="object"
                        string="Send"
                        confirm="Once you send these emails, they'll be making a grand entrance in all the inboxes, creating quite the buzz!"
                        invisible="state in ('in_queue', 'sending', 'done')"
                        class="oe_highlight"
                        confirm-label="Send to all"
                        confirm-title="Ready to unleash emails?"
                        data-hotkey="q" />
                    <button
                        name="action_schedule"
                        type="object"
                        string="Schedule"
                        invisible="state in ('in_queue', 'sending', 'done')"
                        class="btn-secondary"
                        data-hotkey="v" />
                    <button
                        name="action_duplicate"
                        type="object"
                        string="Duplicate"
                        invisible="state != 'done'"
                        class="btn-secondary"
                        data-hotkey="p" />
                    <button
                        name="action_test"
                        type="object"
                        string="Test"
                        class="btn-secondary"
                        data-hotkey="k" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'in_queue'"
                        class="btn-secondary"
                        data-hotkey="x" />
                    <button
                        name="action_retry_failed"
                        type="object"
                        string="Retry"
                        invisible="state != 'done' or failed == 0"
                        class="oe_highlight"
                        data-hotkey="y" />
                    <button
                        name="action_set_favorite"
                        type="object"
                        string="Add to Templates"
                        invisible="is_favorite"
                        class="btn-secondary" />
                    <button
                        name="action_remove_favorite"
                        type="object"
                        string="Remove from Templates"
                        invisible="not is_favorite"
                        class="btn-secondary" />
                    <field
                        name="state"
                        widget="statusbar"
                        readonly="1"
                        statusbar_visible="draft,in_queue,sending,done" />
                </header>
                <div
                    class="alert alert-info o_mass_mailing_alert_message"
                    role="alert"
                    invisible="state not in ['in_queue', 'done'] and sent == 0 and canceled == 0 and scheduled == 0 and failed == 0 and not warning_message">
                    <div class="o_mails_canceled" invisible="canceled == 0">
                        <button
                            name="action_view_traces_canceled"
                            type="object"
                            class="btn btn-link py-0">
                            <strong>
                                <field name="canceled" class="oe_inline me-2" />
                                <span name="canceled_text">emails have been cancelled and will not be sent.</span>
                            </strong>
                        </button>
                    </div>
                    <div class="o_mails_scheduled" invisible="scheduled == 0">
                        <button
                            name="action_view_traces_scheduled"
                            type="object"
                            class="btn btn-link py-0">
                            <strong>
                                <field name="scheduled" class="oe_inline me-2" />
                                <span name="scheduled_text">emails are in queue and will be sent soon.</span>
                            </strong>
                        </button>
                    </div>
                    <div class="o_mails_process" invisible="process == 0">
                        <button
                            name="action_view_traces_process"
                            type="object"
                            class="btn btn-link py-0">
                            <strong>
                                <field name="process" class="oe_inline me-2" />
                                <span name="process_text">emails are being processed.</span>
                            </strong>
                        </button>
                    </div>
                    <div
                        class="o_mails_sent"
                        invisible="sent == 0 and state in ('draft', 'test', 'in_queue')">
                        <button
                            name="action_view_traces_sent"
                            type="object"
                            class="btn btn-link py-0">
                            <strong>
                                <field name="sent" class="oe_inline me-2" />
                                <span name="sent">emails have been sent.</span>
                            </strong>
                        </button>
                        <strong
                            class="d-block"
                            invisible="mailing_type == 'mail' or not ab_testing_enabled or state != 'done' or sent != 0 or failed != 0 or canceled != 0">
                            <span name="ab_test_text">There wasn't enough recipients given to this mailing. </span>
                        </strong>
                    </div>
                    <div
                        class="o_mails_failed"
                        invisible="state != 'done' or failed == 0">
                        <button
                            name="action_view_traces_failed"
                            type="object"
                            class="btn btn-link py-0">
                            <strong>
                                <field name="failed" class="oe_inline me-2" />
                                <span name="failed_text">emails could not be sent.</span>
                        </strong>
                        </button>
                    </div>

                    <div class="o_mails_in_queue" invisible="state != 'in_queue'">
                        <strong
                            invisible="next_departure_is_past or schedule_type == 'now'">
                            <span name="next_departure_text">This mailing is scheduled for </span>
                            <field name="next_departure" class="oe_inline" />.
                        </strong>
                        <strong
                            invisible="not next_departure_is_past or schedule_type == 'now'"
                            class="d-flex align-items-center">
                            <field name="next_departure_is_past" invisible="1" />
                            <span name="refresh_text">This mailing will be sent as soon as possible.</span>
                            <button
                                name="action_reload"
                                type="object"
                                class="btn btn-link pe-0">
                                <u>Refresh <i class="fa-solid fa-arrows-rotate ms-1" /></u>
                            </button>
                        </strong>
                        <strong
                            invisible="schedule_type != 'now'"
                            class="d-flex align-items-center">
                            <field name="next_departure_is_past" invisible="1" />
                            <field name="schedule_type" invisible="1" />
                            <span name="mailing_schedule_type_now_text">This mailing will be sent as soon as possible.</span>
                            <button
                                name="action_reload"
                                type="object"
                                class="btn btn-link pe-0">
                                <u>Refresh <i class="fa-solid fa-arrows-rotate ms-1" /></u>
                            </button>
                        </strong>
                    </div>
                    <div invisible="not warning_message">
                        <strong><field name="warning_message" /></strong>
                    </div>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_opened"
                            type="object"
                            context="{'search_default_filter_opened': True}"
                            invisible="state in ('draft', 'test')"
                            class="oe_stat_button">
                            <field
                                name="opened_ratio"
                                string="Opened"
                                widget="percentpie" />
                        </button>
                        <button
                            name="action_view_replied"
                            type="object"
                            context="{'search_default_filter_replied': True}"
                            invisible="state in ('draft', 'test')"
                            class="oe_stat_button">
                            <field
                                name="replied_ratio"
                                string="Replied"
                                widget="percentpie" />
                        </button>
                        <button
                            name="action_view_clicked"
                            type="object"
                            context="{'search_default_filter_clicked': True}"
                            invisible="state in ('draft', 'test')"
                            class="oe_stat_button">
                            <field
                                name="clicks_ratio"
                                string="Clicked"
                                widget="percentpie" />
                        </button>
                        <button
                            name="action_view_delivered"
                            id="button_view_delivered"
                            type="object"
                            context="{'search_default_filter_delivered': True}"
                            invisible="state in ('draft', 'test')"
                            class="oe_stat_button">
                            <field
                                name="received_ratio"
                                string="Received"
                                widget="percentpie" />
                        </button>
                        <button
                            name="action_view_bounced"
                            type="object"
                            context="{'search_default_filter_bounced': True}"
                            invisible="state in ('draft', 'test')"
                            class="oe_stat_button">
                            <field
                                name="bounced_ratio"
                                string="Bounced"
                                widget="percentpie" />
                        </button>
                        <button
                            name="action_view_link_trackers"
                            type="object"
                            icon="fa-link"
                            invisible="state != 'done'"
                            class="oe_stat_button">
                            <field
                                name="link_trackers_count"
                                string="Link Trackers"
                                widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <group class="o_mass_mailing_mailing_group">
                        <field name="active" invisible="1" />
                        <field name="create_uid" invisible="1" />
                        <field
                            name="mailing_type"
                            widget="radio"
                            force_save="1"
                            options="{'horizontal': true}"
                            invisible="1"
                            readonly="state != 'draft'" />
                        <field
                            name="subject"
                            placeholder="e.g. New Sale on all T-shirts"
                            widget="char_emojis"
                            options="{'dynamic_placeholder': true}"
                            readonly="state in ('sending', 'done')"
                            class="text-break" />
                        <label for="mailing_model_id" string="Recipients" />
                        <div name="mailing_model_id_container">
                            <div class="row">
                                <div class="col-md-auto">
                                    <field
                                        name="mailing_model_id"
                                        options="{'no_open': True, 'no_create': True}"
                                        readonly="state in ('sending', 'done')" />
                                </div>
                                <div
                                    invisible="not mailing_on_mailing_list"
                                    class="o_mass_mailing_contact_list_ids col-md-auto pt-1">
                                    <label
                                        for="contact_list_ids"
                                        string="Mailing Lists:"
                                        class="oe_edit_only pe-3" />
                                    <div
                                        class="d-inline-flex flex-row align-items-center">
                                        <field
                                            name="contact_list_ids"
                                            placeholder="Select recipients..."
                                            widget="many2many_tags"
                                            context="{'form_view_ref': 'mass_mailing.mailing_list_view_form_simplified'}"
                                            readonly="state in ('sending', 'done')"
                                            class="oe_inline mb-0" />
                                        <button
                                            name="action_view_mailing_contacts"
                                            type="object"
                                            title="Add Mailing Contacts"
                                            icon="fa-user-plus"
                                            invisible="not contact_list_ids or not contact_list_ids or state in ('sending', 'done')"
                                            class="btn btn-secondary py-0 px-1 ms-1" />
                                    </div>
                                </div>
                                <div
                                    invisible="mailing_on_mailing_list"
                                    class="col-md-auto o_mailing_filter_width">
                                    <field
                                        name="mailing_filter_id"
                                        placeholder="Reload a favorite filter"
                                        widget="mailing_filter"
                                        options="{'no_create': 1, 'no_open': 1, 'domain_field': 'mailing_domain', 'model_field': 'mailing_model_id'}"
                                        readonly="state in ('sending', 'done')"
                                        class="o_mailing_filter_readonly_width" />
                                </div>
                                <field name="mailing_filter_count" invisible="1" />
                            </div>

                            <field name="mailing_model_name" invisible="1" />
                            <field name="mailing_on_mailing_list" invisible="1" />
                            <field name="mailing_model_real" invisible="1" />
                            <field
                                name="mailing_domain"
                                widget="domain"
                                options="{'model': 'mailing_model_real', 'foldable': true}"
                                invisible="mailing_on_mailing_list"
                                readonly="state in ('sending', 'done')" />
                        </div>
                    </group>
                    <notebook>
                        <page name="mail_body" string="Mail Body">
                            <div class="position-relative">
                                <field
                                    name="body_arch"
                                    widget="mass_mailing_html"
                                    options="{                                             'inline_field': 'body_html',                                             'dynamic_placeholder': true,                                         }"
                                    readonly="state in ('sending', 'done')"
                                    class="o_mail_body_mailing" />
                                <field name="is_body_empty" invisible="1" />
                            </div>
                        </page>
                        <page name="ab_testing" string="A/B Tests">
                            <group>
                                <group>
                                    <label for="ab_testing_enabled" />
                                    <span class="d-flex">
                                        <field
                                            name="ab_testing_enabled"
                                            force_save="1"
                                            readonly="state != 'draft'" />
                                        <span
                                            class="d-flex"
                                            invisible="not ab_testing_enabled">
                                            on <field name="ab_testing_pc" readonly="state != 'draft'" class="mx-1 text-center" /> %
                                        </span>
                                    </span>
                                    <field
                                        name="ab_testing_winner_selection"
                                        invisible="not ab_testing_enabled or mailing_type != 'mail'"
                                        readonly="state != 'draft'"
                                        required="ab_testing_enabled and mailing_type == 'mail'" />
                                    <field
                                        name="ab_testing_schedule_datetime"
                                        invisible="not ab_testing_enabled or ab_testing_winner_selection == 'manual'"
                                        readonly="not ab_testing_enabled or state != 'draft'"
                                        required="ab_testing_enabled and ab_testing_winner_selection != 'manual'" />
                                    <field name="is_ab_test_sent" invisible="1" />
                                </group>
                                <div>
                                    <field
                                        name="ab_testing_mailings_count"
                                        invisible="1" />
                                    <field name="ab_testing_completed" invisible="1" />
                                    <field name="ab_testing_description" nolabel="1" />
                                    <div
                                        id="mailing_form_ab_buttons"
                                        invisible="ab_testing_mailings_count &lt; 2 or not ab_testing_enabled">
                                        <button
                                            name="action_compare_versions"
                                            type="object"
                                            class="btn btn-link d-block">
                                            <i class="fa-solid fa-chart-column" /> Compare Version
                                        </button>
                                        <button
                                            name="action_duplicate"
                                            type="object"
                                            invisible="ab_testing_completed"
                                            class="btn btn-link d-block">
                                            <i class="fa-solid fa-copy" /> Create an Alternative
                                        </button>
                                        <button
                                            name="action_send_winner_mailing"
                                            type="object"
                                            invisible="not is_ab_test_sent or ab_testing_completed or ab_testing_winner_selection == 'manual'"
                                            class="btn btn-link d-block">
                                            <i class="fa-solid fa-envelope" /><span name="ab_test_auto">
                                                Send Winner Now
                                            </span>
                                        </button>
                                        <button
                                            name="action_select_as_winner"
                                            type="object"
                                            invisible="ab_testing_completed or ab_testing_winner_selection != 'manual'"
                                            class="btn btn-link d-block">
                                            <i class="fa-solid fa-envelope" /> Send this as winner
                                        </button>
                                    </div>
                                    <button
                                        name="action_duplicate"
                                        type="object"
                                        invisible="ab_testing_mailings_count &gt;= 2 or not ab_testing_enabled"
                                        class="btn btn-primary">
                                        Create an Alternative Version
                                    </button>
                                </div>
                            </group>
                        </page>
                        <page name="settings" string="Settings">
                            <group>
                                <group
                                    name="email_content"
                                    string="Email Content"
                                    invisible="mailing_type != 'mail'">
                                    <field
                                        name="preview"
                                        string="Preview Text"
                                        placeholder="e.g. Check it out before it's too late!"
                                        widget="char_emojis"
                                        options="{'dynamic_placeholder': true}"
                                        readonly="state in ('sending', 'done')"
                                        class="o_text_overflow" />
                                    <field
                                        name="email_from"
                                        readonly="state in ('sending', 'done')" />
                                    <label for="reply_to" />
                                    <div name="reply_to_details">
                                        <field
                                            name="reply_to_mode"
                                            widget="radio"
                                            invisible="mailing_model_name in ['mailing.contact', 'res.partner', 'mailing.list']"
                                            readonly="state in ('sending', 'done')" />
                                        <field
                                            name="reply_to"
                                            invisible="reply_to_mode == 'update'"
                                            readonly="state in ('sending', 'done')"
                                            required="reply_to_mode == 'new'" />
                                        <div style="margin-top:-5px">
                                            <small
                                                class="oe_edit_only text-muted mb-2"
                                                style="font-size:74%"
                                                invisible="reply_to_mode == 'update' or mailing_model_name in ['mailing.contact', 'res.partner', 'mailing.list']">
                                                To track replies, this address must belong to this database.
                                            </small>
                                        </div>
                                    </div>
                                    <label for="attachment_ids" />
                                    <div name="attachment_ids_details">
                                        <field
                                            name="attachment_ids"
                                            string="Attach a file"
                                            widget="many2many_binary"
                                            readonly="state in ('sending', 'done')" />
                                    </div>
                                </group>
                                <group string="Tracking">
                                    <field
                                        name="campaign_id"
                                        string="Campaign"
                                        options="{'create_name_field': 'title'}"
                                        groups="mass_mailing.group_mass_mailing_campaign"
                                        readonly="state in ('sending', 'done')" />
                                    <field
                                        name="medium_id"
                                        string="Medium"
                                        groups="base.group_no_one"
                                        readonly="state in ('sending', 'done')"
                                        required="True" />
                                    <field
                                        name="source_id"
                                        string="Source"
                                        groups="base.group_no_one"
                                        readonly="1"
                                        required="False"
                                        class="o_text_overflow" />
                                    <field
                                        name="user_id"
                                        widget="many2one_avatar_user"
                                        domain="[('share', '=', False)]" />
                                </group>
                                <group string="Advanced" groups="base.group_no_one">
                                    <field name="mail_server_available" invisible="1" />
                                    <field
                                        name="name"
                                        string="Name"
                                        readonly="state in ('sending', 'done')"
                                        required="False" />
                                    <field
                                        name="mail_server_id"
                                        invisible="not mail_server_available"
                                        readonly="state in ('sending', 'done')" />
                                    <field
                                        name="keep_archives"
                                        readonly="state in ('sending', 'done')" />
                                    <!-- Not using a dedicated server and being set means generic sending, won't allow disabling it. -->
                                    <field
                                        name="use_exclusion_list"
                                        invisible="not mail_server_id and use_exclusion_list"
                                        readonly="state != 'draft'" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_mail_mass_mailing_kanban" model="ir.ui.view">
        <field name="name">mailing.mailing.kanban</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                sample="1"
                highlight_color="color"
                quick_create="false">
                <field name="mailing_on_mailing_list" />
                <field name="next_departure" />
                <field name="active" />
                <templates>
                    <t t-name="menu" t-if="!selection_mode">
                        <field name="color" widget="kanban_color_picker" />
                        <t t-if="widget.deletable">
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                        <a role="menuitem" type="object" name="action_archive" class="dropdown-item o_kanban_mailing_active" t-if="record.active.raw_value">Archive</a>
                        <a role="menuitem" type="object" name="action_unarchive" class="dropdown-item o_kanban_mailing_active" t-if="!record.active.raw_value">Restore</a>
                    </t>
                    <t t-name="card">
                        <field name="subject" class="my-1 text-truncate fs-3 fw-bold" />
                        <field
                            name="campaign_id"
                            groups="mass_mailing.group_mass_mailing_campaign"
                            invisible="not sent_date"
                            class="fw-bold fs-5" />
                        <div>
                            <i
                                class="fa-solid fa-bullseye me-2"
                                role="img"
                                aria-label="Lead/Opportunity" />
                            <field
                                name="mailing_model_id"
                                invisible="mailing_on_mailing_list" />
                            <span invisible="not mailing_on_mailing_list">Mailing Contact</span>
                        </div>
                        <footer class="pt-0">
                            <div>
                                <span
                                    invisible="not sent_date"
                                    t-attf-title="Sent on #{record.sent_date.value}">
                                    <span
                                        class="fa-solid fa-paper-plane me-2 small my-auto"
                                        aria-label="Sent date" />
                                    <field name="sent_date" />
                                </span>
                                <span
                                    invisible="not schedule_date"
                                    t-attf-title="Scheduled on #{record.schedule_date.value}">
                                    <span
                                        class="fa-solid fa-hourglass-half me-2 small my-auto"
                                        aria-label="Scheduled date" />
                                    <field
                                        name="schedule_date"
                                        readonly="state not in ['draft', 'in_queue']" />
                                </span>
                                <span
                                    invisible="sent_date or schedule_date or state == 'in_queue'">
                                    <field name="total" class="me-1 fw-bold" />
                                    <field
                                        name="mailing_model_id"
                                        invisible="mailing_on_mailing_list" />
                                    <span invisible="not mailing_on_mailing_list">Mailing Contact</span>
                                </span>
                                <span
                                    invisible="schedule_date or state != 'in_queue' or not next_departure"
                                    t-attf-title="Scheduled on #{record.next_departure.value}">
                                    <span
                                        class="fa-solid fa-hourglass me-2 small my-auto"
                                        aria-label="Scheduled date" />
                                    <span>Next Batch</span>
                                </span>
                            </div>
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                class="ms-auto" />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mailing_mailing_view_calendar" model="ir.ui.view">
        <field name="name">mailing.mailing.view.calendar</field>
        <field name="model">mailing.mailing</field>
        <field name="arch" type="xml">
            <calendar
                string="Mailings"
                mode="month"
                color="state"
                date_start="calendar_date"
                hide_time="true"
                quick_create="0">
                <field
                    name="mailing_model_id"
                    string="Recipient"
                    options="{'no_open': True}" />
                <field name="user_id" invisible="1" filters="1" />
                <field name="state" invisible="1" filters="1" />
            </calendar>
        </field>
    </record>

