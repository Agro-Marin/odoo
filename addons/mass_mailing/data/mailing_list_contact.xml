<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="mailing_list_data" model="mailing.list">
            <field name="name">Newsletter</field>
            <field name="is_public">True</field>
        </record>
        <record id="mass_mail_contact_0" model="mailing.contact">
            <field
                name="name"
                eval="obj().env.ref('base.user_admin').name"
                model="res.users" />
            <field
                name="email"
                eval="obj().env.ref('base.user_admin').email"
                model="res.users" />
            <field name="list_ids" eval="[(5, 0, 0)]" />
        </record>
    </data>

</odoo>
