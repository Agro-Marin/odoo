<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="digest_mail_main" inherit_id="digest.digest_mail_main">
            <!-- `inside`, not `after` the last <t>: the previous form counted
                 the footer's <t> children, so adding or removing one of them in
                 `digest` silently moved this link or broke the install. The div
                 is what this appends to. -->
            <xpath expr="//div[hasclass('by_odoo')]" position="inside">
                <t t-if="mailing_report_token">
                    –
                    <a t-attf-href="/mailing/report/unsubscribe?token=#{mailing_report_token}&amp;user_id=#{user_id}"
                       target="_blank" style="text-decoration: none;">
                        <span style="color: #878d97;">Turn off Mailing Reports</span>
                    </a>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
