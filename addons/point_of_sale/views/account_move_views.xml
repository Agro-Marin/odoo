<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_pos_user_form" model="ir.ui.view">
        <field name="name">account.move.pos.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_source_pos_orders"
                    type="object"
                    icon="fa-regular fa-pen-to-square"
                    invisible="pos_order_count == 0 or move_type not in ('out_invoice', 'out_refund')"
                    class="oe_stat_button">
                    <field
                        name="pos_order_count"
                        string="POS Orders"
                        widget="statinfo" />
                </button>
            </xpath>
            <xpath
                expr="//field[@name='tax_cash_basis_origin_move_id']"
                position="before">
                <field
                    name="reversed_pos_order_id"
                    invisible="not reversed_pos_order_id"
                    readonly="True" />
            </xpath>
        </field>
    </record>

</odoo>
