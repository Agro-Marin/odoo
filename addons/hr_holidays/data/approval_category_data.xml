<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_leave" model="approval.category">
        <field name="name">Time Off</field>
        <field name="sequence_code">TIMEOFF</field>
        <field name="company_id" eval="False" />
        <field name="approval_minimum">1</field>
        <field name="notify_sequentially" eval="True" />
        <field name="activity_target">document</field>
    </record>

    <record id="approval_category_leave_step_manager" model="approval.category.step">
        <field name="category_id" ref="approval_category_leave" />
        <field name="activity_type_id" ref="hr_holidays.mail_act_leave_approval" />
        <field name="name">Time Off Approver</field>
        <field name="sequence">10</field>
        <field name="minimum">1</field>
        <field name="subject_model_id" ref="hr_holidays.model_hr_leave" />
        <field name="subject_user_path">employee_id.leave_manager_id</field>
        <field name="group_id" ref="hr_holidays.group_hr_holidays_user" />
        <field
            name="subject_domain">[('validation_type', 'in', ['manager', 'both'])]</field>
    </record>

    <record id="approval_category_leave_step_officer" model="approval.category.step">
        <field name="category_id" ref="approval_category_leave" />
        <field
            name="activity_type_id"
            ref="hr_holidays.mail_act_leave_second_approval" />
        <field name="name">Time Off Officer</field>
        <field name="sequence">20</field>
        <field name="minimum">1</field>
        <field name="subject_model_id" ref="hr_holidays.model_hr_leave" />
        <field name="subject_user_path">holiday_status_id.responsible_ids</field>
        <field name="group_id" ref="hr_holidays.group_hr_holidays_user" />
        <field name="subject_domain">[('validation_type', 'in', ['hr', 'both'])]</field>
    </record>

    <record id="approval_category_allocation" model="approval.category">
        <field name="name">Time Off Allocation</field>
        <field name="sequence_code">ALLOCATION</field>
        <field name="company_id" eval="False" />
        <field name="approval_minimum">1</field>
        <field name="notify_sequentially" eval="True" />
        <field name="activity_target">document</field>
    </record>

    <record
        id="approval_category_allocation_step_manager"
        model="approval.category.step">
        <field name="category_id" ref="approval_category_allocation" />
        <field
            name="activity_type_id"
            ref="hr_holidays.mail_act_leave_allocation_approval" />
        <field name="name">Time Off Approver</field>
        <field name="sequence">10</field>
        <field name="minimum">1</field>
        <field name="subject_model_id" ref="hr_holidays.model_hr_leave_allocation" />
        <field name="subject_user_path">employee_id.leave_manager_id</field>
        <field name="group_id" ref="hr_holidays.group_hr_holidays_user" />
        <field
            name="subject_domain">[('validation_type', 'in', ['manager', 'both'])]</field>
    </record>

    <record
        id="approval_category_allocation_step_officer"
        model="approval.category.step">
        <field name="category_id" ref="approval_category_allocation" />
        <field
            name="activity_type_id"
            ref="hr_holidays.mail_act_leave_allocation_second_approval" />
        <field name="name">Time Off Officer</field>
        <field name="sequence">20</field>
        <field name="minimum">1</field>
        <field name="subject_model_id" ref="hr_holidays.model_hr_leave_allocation" />
        <field name="subject_user_path">holiday_status_id.responsible_ids</field>
        <field name="group_id" ref="hr_holidays.group_hr_holidays_user" />
        <field name="subject_domain">[('validation_type', 'in', ['hr', 'both'])]</field>
    </record>

</odoo>
