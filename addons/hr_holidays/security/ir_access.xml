        <field
            name="domain">[('state', 'in', ['confirm', 'validate1', 'refuse']), '|', ('employee_id', '!=', user.with_company(company_id).employee_id.id), ('validation_type', '=', 'no_validation')]</field>
        <field name="verbs">validate</field>
    </record>

    <record id="access_hr_leave_allocation_validate_administrator" model="ir.access">
