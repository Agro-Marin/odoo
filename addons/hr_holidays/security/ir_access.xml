        <field name="kind">permission</field>
        <field
            name="domain">[('employee_id.leave_manager_id', '=', user.id), ('validation_type', '=', 'both'), ('state', '=', 'confirm'), ('employee_id', '!=', user.with_company(company_id).employee_id.id)]</field>
        <field name="verbs">approve</field>
    </record>

    <record id="access_hr_leave_allocation_validate_officer" model="ir.access">
        <field
            name="name">hr.leave.allocation: a time-off officer validates another's allocation</field>
        <field name="model_id" ref="model_hr_leave_allocation" />
