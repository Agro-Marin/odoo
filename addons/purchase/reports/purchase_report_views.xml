<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_report_search" model="ir.ui.view">
        <field name="name">purchase.report.search</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <search string="Purchase Orders">
                <filter
                    name="quotes"
                    string="Requests for Quotation"
                    domain="[('state', '=', 'draft')]" />
                <filter
                    name="orders"
                    string="Purchase Orders"
                    domain="[('state', '!=', 'draft'), ('state', '!=', 'cancel')]" />
                <filter
                    name="later_than_a_year_ago"
                    string="Confirmation Date Last Year"
                    domain="[('date_confirmed', '&gt;=', 'today -1y')]" />
                <filter name="filter_date_order" date="date_order" />
                <filter
                    name="filter_date_confirmed"
                    date="date_confirmed"
                    default_period="month" />
                <field name="partner_id" />
                <field name="product_id" />
                <group>
                    <field name="user_id" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="date_order" />
                    <field name="date_confirmed" />
                    <field
                        name="product_category_id"
                        filter_domain="[('product_category_id', 'child_of', self)]" />
                </group>
                <group>
                    <filter
                        name="group_partner_id"
                        string="Vendor"
                        context="{'group_by': 'partner_id'}" />
                    <filter
                        name="country_id"
                        string="Vendor Country"
                        context="{'group_by': 'country_id'}" />
                    <filter
                        name="user_id"
                        string="Buyer"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="group_product_id"
                        string="Product"
                        context="{'group_by': 'product_id'}" />
                    <filter
                        name="group_product_category_id"
                        string="Product Category"
                        context="{'group_by': 'product_category_id'}" />
                    <filter
                        name="status"
                        string="Status"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                    <separator />
                    <filter
                        name="order_month"
                        string="Order Date"
                        context="{'group_by': 'date_order:month'}" />
                    <filter
                        name="group_date_confirmed_month"
                        string="Confirmation Date"
                        context="{'group_by': 'date_confirmed:month'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_purchase_report_pivot" model="ir.ui.view">
        <field name="name">product.month.pivot</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Analysis" sample="1" display_quantity="1">
                <field name="product_category_id" type="row" />
                <field name="price_subtotal" type="measure" />
                <field name="price_total" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_purchase_report_graph" model="ir.ui.view">
        <field name="name">product.month.graph</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <graph type="line" string="Purchase Analysis" sample="1">
                <field name="date_confirmed" interval="day" />
                <field name="price_subtotal" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_purchase_report_list" model="ir.ui.view">
        <field name="name">purchase.report.view.list</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <list string="Purchase Analysis">
                <field name="date_order" />
                <field name="partner_id" optional="show" />
                <field name="product_id" optional="show" />
                <field name="product_category_id" optional="show" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field
                    name="product_uom_qty"
                    optional="hide"
                    sum="Sum of Qty Ordered" />
                <field
                    name="qty_transferred"
                    optional="hide"
                    sum="Sum of Qty Received" />
                <field name="qty_invoiced" optional="hide" sum="Sum of Qty Billed" />
                <field name="currency_id" optional="show" column_invisible="True" />
                <field
                    name="price_subtotal"
                    widget="monetary"
                    optional="hide"
                    sum="Sum of Untaxed Total" />
                <field
                    name="price_total"
                    widget="monetary"
                    optional="show"
                    sum="Sum of Total" />
                <field name="state" optional="show" />
            </list>
        </field>
    </record>

    <record id="action_purchase_report_all" model="ir.actions.act_window">
        <field name="name">Purchase Analysis</field>
        <field name="res_model">purchase.report</field>
        <field name="path">purchase-analysis</field>
        <field name="view_mode">graph,pivot</field>
        <field name="view_id" />
        <field name="target">current</field>
        <field
            name="context">{
            'search_default_orders': 1,
            'search_default_filter_date_confirmed': 1
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Purchase Analysis
            </p>
            <p>
                This analysis allows you to easily check and analyse your company purchase history
                and performance.
                You can track your negotiation performance, the delivery performance of your
                vendors, etc
            </p>
        </field>
    </record>

</odoo>
