<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_line_search" model="ir.ui.view">
        <field name="name">purchase.order.line.search</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Order">
                <field name="order_id" />
                <field name="product_id" />
                <field name="partner_id" string="Vendor" />
                <filter
                    name="hide_cancelled"
                    string="Hide cancelled lines"
                    domain="[('state', '!=', 'cancel')]" />
                <filter
                    name="purchase_state"
                    string="Status"
                    domain="[('state', '=', 'done')]" />
                <separator />
                <filter
                    name="filter_date_order"
                    date="date_order"
                    default_period="month" />
                <filter
                    name="order_date_last_year"
                    string="Order Date: Last 365 Days"
                    domain="[                             ('date_order', '&gt;', 'today -1y')                         ]"
                    invisible="1" />
                <group>
                    <filter
                        name="groupby_supplier"
                        string="Vendor"
                        context="{'group_by' : 'partner_id'}" />
                    <filter
                        name="groupby_product"
                        string="Product"
                        context="{'group_by' : 'product_id'}" />
                    <filter
                        name="order_reference"
                        string="Order Reference"
                        context="{'group_by' :'order_id'}" />
                    <separator />
                    <filter
                        name="group_by_date_order"
                        string="Order Date"
                        context="{'group_by': 'date_order'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_purchase_order_line_list" model="ir.ui.view">
        <field name="name">purchase.order.line.list</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Order Lines" create="false">
                <field name="order_id" />
                <field name="name" />
                <field name="partner_id" string="Vendor" />
                <field name="product_id" />
                <field name="price_unit" />
                <field name="product_qty" />
                <field
                    name="product_uom_id"
                    widget="many2one_uom"
                    groups="uom.group_uom" />
                <field name="price_subtotal" widget="monetary" />
                <field name="currency_id" column_invisible="True" />
                <field name="date_commitment" />
            </list>
        </field>
    </record>

    <record id="view_purchase_order_line_list_history" model="ir.ui.view">
        <field name="name">purchase.history.list</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list
                type="object"
                default_order="date_confirmed desc, id desc"
                create="false"
                action="action_view_order"
                decoration-info="order_id == context.get('active_id')">
                <field name="currency_id" column_invisible="True" />
                <field name="order_id" widget="many2one" />
                <field name="date_confirmed" />
                <field name="partner_id" string="Vendor" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="product_qty" optional="hide" />
                <field name="product_uom_id" optional="hide" groups="uom.group_uom" />
                <field name="product_uom_qty" />
                <field name="price_unit" optional="hide" />
                <field name="price_unit_product_uom" widget="monetary" />
                <field name="discount" optional="hide" />
                <field name="price_subtotal" string="Total Untaxed" widget="monetary" />
                <field name="state" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_purchase_history_pivot" model="ir.ui.view">
        <field name="name">purchase.history.pivot</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field
                    name="price_total"
                    type="measure"
                    string="Total purchased amount" />
                <field
                    name="product_uom_qty"
                    type="measure"
                    string="Total Qty purchased" />
            </pivot>
        </field>
    </record>

    <record id="view_purchase_history_graph" model="ir.ui.view">
        <field name="name">purchase.history.graph</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="date_order" interval="month" />
                <field name="product_uom_qty" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_purchase_order_line_form_2" model="ir.ui.view">
        <field name="name">purchase.order.line.form2</field>
        <field name="model">purchase.order.line</field>
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <form string="Purchase Order Line" create="false">
                <sheet>
                    <label for="order_id" />
                    <h1>
                        <field name="order_id" class="oe_inline" />
                        <label for="date_order" string="," invisible="not date_order" />
                        <field name="date_order" class="oe_inline" />
                    </h1>
                    <label for="partner_id" />
                    <h2>
                        <field name="partner_id" />
                    </h2>
                    <group>
                        <group>
                            <field name="product_id" readonly="1" />
                            <label for="product_qty" />
                            <div class="o_row">
                                <field name="product_qty" readonly="1" />
                                <field
                                    name="product_uom_id"
                                    groups="uom.group_uom"
                                    readonly="1" />
                            </div>
                            <field name="price_unit" />
                        </group>
                        <group>
                            <field
                                name="tax_ids"
                                widget="many2many_tax_tags"
                                domain="[('type_tax_use', '=', 'purchase'), ('country_id', '=', tax_country_id)]" />
                            <field name="date_commitment" readonly="1" />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                            <field
                                name="analytic_distribution"
                                widget="analytic_distribution"
                                options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"
                                groups="analytic.group_analytic_accounting" />
                        </group>
                    </group>
                    <field name="name" />
                    <separator string="Manual Invoices" />
                    <field name="invoice_line_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_history" model="ir.actions.act_window">
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="purchase.view_purchase_order_line_list_history" />
        <field
            name="context">{
            'search_default_order_date_last_year': 1,
            'search_default_groupby_product': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase order were made for this product yet!
            </p>
        </field>
    </record>

</odoo>
