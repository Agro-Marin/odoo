<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_invoice_report_search_inherit" model="ir.ui.view">
        <field name="name">account.invoice.report.search</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search" />
        <field name="arch" type="xml">
            <search>
                <field name="l10n_ar_state_id" />
                <filter
                    name="with_document"
                    string="With Document"
                    domain="[('l10n_latam_document_type_id', '!=', False)]" />
                <filter
                    name="filter_accounting_date_this_year"
                    string="Accounting Date: This Year"
                    domain="[('date', '&lt;', '=1m =1d +1y'), ('date', '&gt;=', '=1m =1d')]"
                    invisible="1" />
            </search>
            <filter name="user" position="after">
                <filter
                    name="groupby_l10n_ar_state_id"
                    string="State"
                    context="{'group_by': 'l10n_ar_state_id'}" />
                <filter
                    name="groupby_account_id"
                    string="Account"
                    context="{'group_by':'account_id'}"
                    groups="account.group_account_readonly" />
            </filter>
        </field>
    </record>

    <record
        id="action_iibb_sales_by_state_and_account_pivot"
        model="ir.actions.act_window">
        <field name="name">IIBB - Sales by jurisdiction</field>
        <field name="res_model">account.invoice.report</field>
        <field name="view_mode">pivot</field>
        <field
            name="context">{'search_default_current': 1, 'search_default_customer': 1, 'search_default_with_document': 1, 'search_default_company': 1, 'search_default_groupby_l10n_ar_state_id': 2, 'search_default_groupby_account_id': 3, 'search_default_filter_accounting_date_this_year': 1}</field>
    </record>

    <record
        id="action_iibb_purchases_by_state_and_account_pivot"
        model="ir.actions.act_window">
        <field name="name">IIBB - Purchases by jurisdiction</field>
        <field name="res_model">account.invoice.report</field>
        <field name="view_mode">pivot</field>
        <field
            name="context">{'search_default_current': 1, 'search_default_supplier': 1, 'search_default_with_document': 1, 'search_default_company': 1, 'search_default_groupby_l10n_ar_state_id': 2, 'search_default_groupby_account_id': 3, 'search_default_filter_accounting_date_this_year': 1}</field>
    </record>

</odoo>
