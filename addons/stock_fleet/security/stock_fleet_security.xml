<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_trips" model="res.groups.privilege">
        <field name="name">Trips</field>
        <field name="category_id" ref="base.module_category_supply_chain" />
    </record>

    <record id="group_trip_driver" model="res.groups">
        <field name="name">Driver</field>
        <field name="privilege_id" ref="res_groups_privilege_trips" />
        <field
            name="comment">Drivers: see their own trips, mark each delivery and register the return.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('stock.group_stock_user'))]" />
    </record>

</odoo>
