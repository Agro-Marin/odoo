<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_delivery_failure_form" model="ir.ui.view">
        <field name="name">stock.picking.delivery.failure.form</field>
        <field name="model">stock.picking.delivery.failure</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="picking_id" readonly="1" />
                    <field
                        name="reason"
                        placeholder="Customer absent, refused, wrong address..." />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button special="cancel" string="Discard" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
