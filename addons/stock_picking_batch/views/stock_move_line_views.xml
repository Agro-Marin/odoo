<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_list_detailed_wave" model="ir.ui.view">
        <field name="name">stock_picking_wave.move.line.list.wave</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_list_detailed" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button
                        name="action_view_add_to_wave"
                        type="object"
                        string="Add to Wave" />
                </header>
            </xpath>
            <xpath expr="//field[@name='picking_id']" position="after">
                <field name="batch_id" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
