<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_landed_costs_form" model="ir.ui.view">
        <field name="name">mrp.landed.cost.form</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form" />
        <field name="arch" type="xml">
            <field name="target_model" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="groups">stock.group_stock_manager</attribute>
            </field>
            <div class="oe_title" position="before">
                <div name="button_box">
                    <button
                        class="oe_stat_button"
                        name="action_view_mrp_productions"
                        type="object"
                        icon="fa-wrench"
                        invisible="mrp_production_count == 0"
                        groups="stock.group_stock_manager">
                        <div class="o_field_widget o_stat_info">
                            <field
                                name="mrp_production_count"
                                string="Manufacturing"
                                widget="statinfo" />
                        </div>
                    </button>
                </div>
            </div>
            <field name="picking_ids" position="after">
                <field name="target_model" invisible="1" readonly="state == 'done'" />
                <field
                    name="mrp_production_ids"
                    widget="many2many_tags"
                    options="{'no_create_edit': True}"
                    invisible="target_model != 'manufacturing'"
                    readonly="state == 'done'"
                    domain="[('company_id', '=', company_id), ('move_finished_ids.is_in', '!=', False)]" />
            </field>
        </field>
    </record>

</odoo>
