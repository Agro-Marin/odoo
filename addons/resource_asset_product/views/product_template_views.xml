<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_asset" model="ir.ui.view">
        <field name="name">product.template.form.asset</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_assets"
                    type="object"
                    icon="fa-truck"
                    invisible="not asset_kind_id"
                    class="oe_stat_button">
                    <field name="asset_count" string="Assets" widget="statinfo" />
                </button>
            </div>
            <field name="categ_id" position="after">
                <field name="asset_kind_id" />
            </field>
        </field>
    </record>

</odoo>
