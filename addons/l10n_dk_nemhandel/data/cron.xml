<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_nemhandel_get_new_documents" model="ir.cron">
        <field name="name">Nemhandel: retrieve new documents</field>
        <field name="model_id" ref="model_account_edi_proxy_client_user" />
        <field name="state">code</field>
        <field name="code">model._cron_nemhandel_get_new_documents()</field>
        <field name="repeat_interval">4</field>
        <field name="repeat_unit">hour</field>
    </record>

    <record id="ir_cron_nemhandel_get_message_status" model="ir.cron">
        <field name="name">Nemhandel: update message status</field>
        <field name="model_id" ref="model_account_edi_proxy_client_user" />
        <field name="state">code</field>
        <field name="code">model._cron_nemhandel_get_message_status()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
    </record>

    <record id="ir_cron_nemhandel_webhook_keepalive" model="ir.cron">
        <field name="name">Nemhandel: webhook keep alive</field>
        <field name="model_id" ref="model_account_edi_proxy_client_user" />
        <field name="state">code</field>
        <field name="code">model._cron_nemhandel_webhook_keepalive()</field>
        <field name="repeat_interval">2</field>
        <field name="repeat_unit">week</field>
    </record>

    <record id="ir_cron_nemhandel_get_participant_status" model="ir.cron">
        <field name="name">Nemhandel: update participant status</field>
        <field name="model_id" ref="model_account_edi_proxy_client_user" />
        <field name="state">code</field>
        <field name="code">model._cron_nemhandel_get_participant_status()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">week</field>
    </record>

</odoo>
