<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="web.HomeMenu">
    <div t-ref="root" class="o_home_menu h-100 overflow-auto" t-att-class="{ o_ios_app: state.isIosApp }">
        <div class="container">
            <div class="o_home_menu_search_wrapper position-relative mx-auto mt-4">
                <i class="oi oi-search o_home_menu_search_icon position-absolute top-50 translate-middle-y" aria-hidden="true"/>
                <input t-ref="input" type="search" class="o_home_menu_search form-control form-control-lg" data-allow-hotkeys="true" t-on-input="_onInputSearch" t-on-blur="_onInputBlur" t-on-compositionstart="_onCompositionStart"
                    aria-label="Search apps and menus"
                    placeholder="Search apps and menus..."
                    autocomplete="off"
                />
            </div>
            <div t-if="canEditLayout" class="o_home_menu_toolbar d-flex justify-content-center align-items-center gap-2 mt-2">
                <button t-if="!state.editing" type="button" class="o_home_menu_customize btn btn-link btn-sm" t-on-click="_toggleEditing">
                    <i class="fa fa-pencil me-1" aria-hidden="true"/>Customize
                </button>
                <t t-else="">
                    <span class="o_home_menu_edit_hint text-muted small me-2">Drag a tile to reorder</span>
                    <button t-if="hasCustomLayout" type="button" class="o_home_menu_reset btn btn-link btn-sm" t-on-click="_resetLayout">Reset layout</button>
                    <button t-if="canSetCompanyDefault and hasCustomLayout" type="button" class="o_home_menu_company_default btn btn-link btn-sm" title="Every user of the company without a layout of their own will see this one" t-on-click="_setCompanyDefault">Set as company default</button>
                    <button type="button" class="o_home_menu_done btn btn-primary btn-sm" t-on-click="_toggleEditing">Done</button>
                </t>
            </div>
            <!-- When the subscription has expired, the expiration panel is shown over the whole UI instead of here -->
            <ExpirationPanel t-if="subscription.warningType and !subscription.isWarningHidden and subscription.daysLeft &lt;= 30 and subscription.daysLeft > 0 and !subscription.sysadmin.replace"/>
            <SysAdminPanel t-if="subscription.daysLeft > 0 and subscription.sysadmin.message"/>
            <t t-set="recents" t-value="recentApps"/>
            <nav t-if="recents.length" class="o_home_menu_recent mt-4 mx-0" aria-label="Recent apps">
                <div class="o_home_menu_section_title text-uppercase small fw-bold px-2 mb-1">Recent</div>
                <div class="o_recent_apps row user-select-none mx-0" role="list">
                    <div t-foreach="recents" t-as="app" t-key="app.id" class="col-3 col-md-2 mb-3 px-0" role="listitem">
                        <t t-call="{{ constructor.appTemplate }}">
                            <t t-set="tileId" t-value="'recent_app_' + app_index"/>
                        </t>
                    </div>
                </div>
            </nav>
            <t t-set="pinned" t-value="pinnedApps"/>
            <t t-set="unpinned" t-value="unpinnedApps"/>
            <div t-if="pinned.length or unpinned.length" id="o_apps_listbox" role="list" aria-label="Apps" class="o_apps_listbox user-select-none" t-att-class="{'mt-5': !recents.length, 'mt-3': recents.length, o_home_menu_editing: state.editing}">
                <div t-if="pinned.length" class="o_pinned_apps mb-2">
                    <div class="o_home_menu_section_title text-uppercase small fw-bold px-2 mb-1">Pinned</div>
                    <div class="row mx-0">
                        <div t-foreach="pinned" t-as="app" t-key="app.id" class="col-3 col-md-2 mb-3 px-0" role="listitem">
                            <t t-call="{{ constructor.appTemplate }}">
                                <t t-set="tileId" t-value="'result_app_' + app_index"/>
                                <t t-set="gridIndex" t-value="app_index"/>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="o_apps row mx-0">
                    <div t-foreach="unpinned" t-as="app" t-key="app.id" class="col-3 col-md-2 o_draggable mb-3 px-0" role="listitem">
                        <t t-call="{{ constructor.appTemplate }}">
                            <t t-set="tileId" t-value="'result_app_' + (pinned.length + app_index)"/>
                            <t t-set="gridIndex" t-value="pinned.length + app_index"/>
                        </t>
                    </div>
                </div>
            </div>
            <div t-else="" class="o_no_result">
                No apps available
            </div>
        </div>
    </div>
</t>

<!-- One tile. `gridIndex` set: a listbox option of the main grid, with the
     keyboard selection, the drag id and an alt+n hotkey for the first nine. -->
<t t-name="web.HomeMenu.App">
    <a t-att-id="tileId"
        class="o_app o_menuitem position-relative d-flex flex-column rounded-3 justify-content-start align-items-center w-100 p-1 p-md-2"
        t-att-class="{o_focused: gridIndex !== undefined and state.focusedIndex === gridIndex, o_app_pinned: isPinned(app), o_app_hidden: isHidden(app)}"
        t-att-data-menu-xmlid="gridIndex !== undefined ? app.xmlid : undefined"
        t-att-data-hotkey="gridIndex !== undefined and gridIndex &lt; directJumpHotkeys ? '' + (gridIndex + 1) : undefined"
        t-att-href="app.href"
        t-on-click.prevent="() => this._onAppClick(app)"
        t-on-focus="() => gridIndex !== undefined and this._onAppFocus(gridIndex)"
        >
        <img t-if="app.webIconData" class="o_app_icon rounded-3" alt=""
            t-attf-src="{{app.webIconData}}"
        />
        <div t-else="" class="o_app_icon position-relative d-flex justify-content-center align-items-center p-2 rounded-3 ratio ratio-1x1"
            t-attf-style="background-color: {{app.webIcon.backgroundColor}};"
        >
            <i t-attf-class="{{app.webIcon.iconClass}} position-relative w-auto h-auto" t-attf-style="color: {{app.webIcon.color}};"/>
        </div>
        <div class="o_caption w-100 text-center text-truncate mt-2" t-esc="app.label or app.name"/>
        <t t-set="badge" t-value="badgeFor(app)"/>
        <span t-if="badge and !state.editing" class="o_app_badge badge rounded-pill text-bg-danger position-absolute" t-att-aria-label="badgeLabel(badge)" t-esc="badge > 99 ? '99+' : badge"/>
        <div t-if="state.editing and gridIndex !== undefined and app.xmlid" class="o_app_edit_actions position-absolute top-0 end-0 d-flex gap-1 p-1">
            <button type="button" class="o_app_pin btn btn-sm btn-light border" t-att-title="pinTitle(app)" t-att-aria-label="pinTitle(app)" t-on-click.stop.prevent="() => this._togglePinned(app)">
                <i class="fa fa-thumb-tack" aria-hidden="true"/>
            </button>
            <button type="button" class="o_app_hide btn btn-sm btn-light border" t-att-title="hideTitle(app)" t-att-aria-label="hideTitle(app)" t-on-click.stop.prevent="() => this._toggleHidden(app)">
                <i t-att-class="isHidden(app) ? 'fa fa-eye' : 'fa fa-eye-slash'" aria-hidden="true"/>
            </button>
        </div>
    </a>
</t>

<t t-name="web.HomeMenu.CommandPalette.Footer">
    <span>
        <span class='fw-bolder text-primary'>TIP</span> — open me anywhere with <span t-esc="controlKey" class='fw-bolder text-primary'/> + <span class='fw-bolder text-primary'>K</span>
    </span>
</t>

</templates>
