<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.Dialog">
        <div class="o_dialog" t-att-id="id" t-att-class="{ o_inactive_modal: !data.isActive, o_dialog_closing: data.isClosing }">
            <!-- `aria-modal` follows `isActive`, it is not a constant. It
                 claims everything OUTSIDE this element is inert, so a stack of
                 three dialogs used to have all three claiming it at once — each
                 buried one asserting that the dialog on top of it, the only one
                 the user can reach, was inert. Only the topmost may say so; the
                 rest are then covered by its claim. `web.BottomSheet` already
                 gates the same attribute on whether it really traps focus. -->
            <div role="dialog"
                t-att-aria-modal="data.isActive ? 'true' : undefined"
                t-att-aria-labelledby="props.title ? id + '_title' : undefined"
                class="modal d-block"
                tabindex="-1"
                t-att-class="{ o_technical_modal: props.technical, o_modal_full: isFullscreen, o_inactive_modal: !data.isActive }"
                t-ref="modalRef"
                >
                <div class="modal-dialog modal-dialog-centered" t-attf-class="modal-{{props.size}}">
                    <div class="modal-content" t-att-class="props.contentClass" t-att-style="contentStyle">
                        <header t-if="props.header" class="modal-header">
                            <!-- The slot scope IS the header contract: everything
                                 `web.Dialog.header` needs is published here, so a
                                 component overriding this slot can render a correct
                                 header without reaching into Dialog's internals. -->
                            <t t-slot="header"
                                close="data.close"
                                isFullscreen="isFullscreen"
                                isClosing="data.isClosing"
                                title="props.title"
                                titleId="id + '_title'">
                                <t t-call="web.Dialog.header">
                                    <t t-set="fullscreen" t-value="isFullscreen"/>
                                    <t t-set="onExpand" t-value="props.onExpand"/>
                                    <t t-set="isClosing" t-value="data.isClosing"/>
                                    <t t-set="title" t-value="props.title"/>
                                    <t t-set="titleId" t-value="id + '_title'"/>
                                    <t t-set="dismiss" t-value="() => this.dismiss()"/>
                                </t>
                            </t>
                        </header>
                        <main class="modal-body" t-attf-class="{{ props.bodyClass }} {{ !props.withBodyPadding ? 'p-0': '' }}" t-att-tabindex="this.bodyTabIndex">
                            <t t-slot="default" close="() => this.data.close()" />
                        </main>
                        <footer t-if="props.footer" class="modal-footer d-empty-none justify-content-around justify-content-md-start flex-wrap gap-1 w-100">
                            <t t-slot="footer" close="() => this.data.close()"/>
                        </footer>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!--
        Standalone header, driven ENTIRELY by `t-set` parameters:
        `fullscreen`, `onExpand`, `isClosing`, `title`, `titleId`, `dismiss`.

        It used to read `data.isClosing`, `id` and `props.title` straight off the
        calling component, which is an invisible contract only `web.Dialog`
        itself satisfies. `SelectCreateDialog` overrides the header slot and
        t-calls this template from a plain Component: `data` was undefined there,
        so the whole dialog threw on render (`debug_manager` "can open a view"),
        and `id` was undefined too, pointing Dialog's `aria-labelledby` at a
        `<h4 id="undefined_title">` that never matched.
    -->
    <t t-name="web.Dialog.header">
        <t t-if="fullscreen">
            <button class="btn oi oi-arrow-left" aria-label="Close" tabindex="-1" t-att-disabled="isClosing" t-on-click="dismiss" />
        </t>
        <h4 class="modal-title text-break flex-grow-1"
            t-att-id="titleId"
            t-att-class="{ 'me-auto': fullscreen }">
            <t t-esc="title"/>
        </h4>
        <t t-if="onExpand">
            <button type="button" class="fa-solid fa-up-right-and-down-left-from-center btn opacity-75 opacity-100-hover o_expand_button" aria-label="Expand" tabindex="-1" t-on-click="onExpand"/>
        </t>
        <t t-if="!fullscreen">
            <button type="button" class="btn-close" aria-label="Close" tabindex="-1" t-att-disabled="isClosing" t-on-click="dismiss"></button>
        </t>
    </t>
</templates>
