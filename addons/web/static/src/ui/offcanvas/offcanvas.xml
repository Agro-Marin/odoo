<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.Offcanvas">
        <div t-ref="panel" popover="auto" tabindex="-1"
            t-att-id="props.id"
            t-att-role="props.role or undefined"
            t-att-aria-label="props.ariaLabel"
            t-att-aria-labelledby="props.ariaLabelledBy"
            t-att-class="classObj">
            <t t-slot="default"/>
        </div>
    </t>

</templates>
