<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.BottomSheet">
        <div
            class="o_bottom_sheet"
            t-att-class="{
                'o_bottom_sheet_ready': state.isPositionedReady,
                'o_bottom_sheet_dismissing': state.isDismissing,
                'o_bottom_sheet_snapping': state.isSnappingEnabled,
            }"
            t-attf-style="--BottomSheet-progress: {{state.progress}}"
            t-ref="container"
            >
            <div
                class="o_bottom_sheet_rail"
                t-att-class="{
                        o_bottom_sheet_rail_prevent_overscroll : props.preventDismissOnContentScroll
                    }"
                t-ref="scrollRail"
                >
                <div class="o_bottom_sheet_backdrop" t-on-click="onBackdropClick"/>

                <div class="o_bottom_sheet_dismiss"/>

                <div class="o_bottom_sheet_spacer"/>

                <!--
                    `aria-modal` only when the sheet actually traps focus:
                    `useActiveElement` runs off `setActiveElement`, and callers
                    do turn it off (Dropdown does). Claiming modality while the
                    page behind stays reachable would tell assistive tech the
                    rest of the document is inert when it is not.
                -->
                <div
                    class="o_bottom_sheet_sheet offcanvas position-relative overflow-hidden"
                    role="dialog"
                    t-att-aria-modal="props.setActiveElement ? 'true' : undefined"
                    t-ref="sheet"
                    >

                    <!--
                        A real <button>, replacing a `role="button"` div that
                        carried no accessible name: it was announced as a
                        button and read out as its own (empty) content, so
                        screen-reader users reaching it inside this
                        `aria-modal` subtree got a nameless control.

                        Deliberately still outside the focus trap, which spans
                        the sheet BODY (`useActiveElement("ref")`): putting the
                        handle in it would make it the first tabable element
                        and steal the opening focus from the sheet's content.
                        The keyboard path out of the sheet is `closeOnEscape`,
                        not this control.
                    -->
                    <button
                        type="button"
                        aria-label="Close"
                        class="o_bottom_sheet_handle btn text-center d-flex align-items-center justify-content-center opacity-50 py-2 w-100 border-0"
                        t-on-click.stop="slideOut"
                        >
                        <div class="o_bottom_sheet_handle_bar pt-1 mx-auto rounded-pill d-inline-block px-5 bg-dark"/>
                    </button>

                    <div
                        class="o_bottom_sheet_body offcanvas-body"
                        t-att-id="props.id"
                        t-att-role="props.role"
                        t-att-class="props.class"
                        t-ref="ref"
                        >

                        <t t-if="props.component">
                            <t t-component="props.component" t-props="props.componentProps" close="close"/>
                        </t>

                        <t t-else="">
                            <t t-slot="default" close="close" back="back"/>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
