<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.FlowPort">
        <div class="o_flow_editor_port position-absolute"
            t-att-class="{
                'o_flow_editor_port_input': props.port.direction === 'input',
                'o_flow_editor_port_output': props.port.direction === 'output',
                'o_flow_editor_port_connected': props.connected,
                'o_flow_editor_port_valid': props.validation === 'valid',
                'o_flow_editor_port_invalid': props.validation === 'invalid',
            }"
            t-att-style="style"
            t-att-title="props.port.label"
            t-att-data-node-id="props.nodeId"
            t-att-data-port-id="props.port.id"
            t-att-data-port-direction="props.port.direction"
            t-on-click="onClick"
            t-on-pointerdown="onPointerDown">
            <span t-if="props.port.direction === 'output' and props.port.label"
                class="o_flow_editor_port_label position-absolute">
                <t t-out="props.port.label"/>
            </span>
        </div>
    </t>

</templates>
