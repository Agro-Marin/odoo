<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.TimePicker">
        <div
            class="o_time_picker d-flex align-items-center justify-content-center"
            t-att-class="cssClass"
        >
            <Dropdown
                state="dropdownState"
                menuRef="menuRef"
                manual="true"
                focusToggleOnClosed="false"
                position="'bottom-start'"
                menuClass="'o_time_picker_dropdown pt-0 mt-0'"
                navigationOptions="navigationOptions"
                role="'listbox'"
                menuId="menuId"
                onOpened.bind="onDropdownOpened"
            >
                <input
                    type="text"
                    t-ref="inputRef"
                    class="o_time_picker_input form-control px-0"
                    t-att-class="inputCssClass"
                    t-model="state.inputValue"
                    t-on-input="onInput"
                    t-on-focus="() => this.ensureOpen({ selectAll: true })"
                    t-on-click="() => this.ensureOpen({ selectAll: true })"
                    t-on-change="onChange"
                    t-on-blur="onBlur"
                    t-att-placeholder="getPlaceholder()"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-haspopup="listbox"
                    t-att-aria-expanded="dropdownState.isOpen ? 'true' : 'false'"
                    t-att-aria-controls="menuId"
                    tabindex="-1"
                /><!--
                    tabindex="-1" is load-bearing, not an oversight. The picker
                    is a SECONDARY surface: inside a DateTimeInput popover the
                    field the user types into is the datetime input, and making
                    this one tabbable puts it in the way. Removing it broke
                    `DateTimeInput (datetime)/enter a datetime value` and the
                    arab-locale case outright — the typed value never reached
                    the datetime input at all. The combobox semantics above are
                    what makes the control announceable; reachability is the
                    owning field's job.
                -->
                <t t-set-slot="content">
                    <t t-foreach="suggestions" t-as="value" t-key="value_index">
                        <DropdownItem
                            class="'o_time_picker_option'"
                            role="'option'"
                            t-out="value.toString(props.showSeconds)"
                            onSelected="() => this.onItemSelected(value)"
                            closingMode="'none'"
                        />
                    </t>
                </t>
            </Dropdown>
        </div>
    </t>
</templates>
