<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ViewLayout">
        <div t-att-class="props.className" t-ref="root">
            <Layout className="layoutClassName" display="props.display">

                <t t-set-slot="control-panel-create-button">
                    <t t-if="hasSlot('control-panel-create-button')" t-slot="control-panel-create-button"/>
                </t>

                <t t-set-slot="layout-buttons">
                    <t t-if="hasSlot('layout-buttons')" t-slot="layout-buttons"/>
                </t>

                <t t-set-slot="control-panel-always-buttons">
                    <t t-if="hasSlot('control-panel-always-buttons')" t-slot="control-panel-always-buttons"/>
                </t>

                <t t-set-slot="layout-actions">
                    <SearchBar t-if="props.searchBar" toggler="props.searchBarToggler" autofocus="props.autofocusSearchBar"/>
                    <t t-if="hasSlot('layout-actions')" t-slot="layout-actions"/>
                </t>

                <!-- The button that reveals the search bar on a small screen.
                     A view that renders SearchBar without it gets a search bar
                     it cannot collapse, which is what web_cohort shipped. -->
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-if="props.searchBar and props.searchBarToggler"
                       t-component="props.searchBarToggler.component"
                       t-props="props.searchBarToggler.props"/>
                    <t t-if="hasSlot('control-panel-navigation-additional')" t-slot="control-panel-navigation-additional"/>
                </t>

                <t t-set-slot="control-panel-additional-actions">
                    <t t-if="hasSlot('control-panel-additional-actions')" t-slot="control-panel-additional-actions"/>
                    <CogMenu t-elif="props.cogMenu"/>
                </t>

                <t t-set-slot="default" t-slot-scope="layout">
                    <ActionHelper t-if="props.displayNoContent"
                                  noContentHelp="props.noContentHelp"
                                  showRibbon="props.useSampleModel"/>
                    <t t-slot="default" contentRef="layout.contentRef"/>
                </t>

            </Layout>
        </div>
    </t>

</templates>
