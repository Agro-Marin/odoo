<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem
        id="menu_config"
        name="General Settings"
        parent="base.menu_administration"
        action="action_general_configuration"
        sequence="0"
        groups="base.group_system" />

    <!--
        Beacon views belong under Technical, not as siblings of it: it groups
        its entries into sections (bar the odd action leaf, e.g.
        base_credential_manager's Rate Limit Buckets), and its base.group_no_one
        restriction is what keeps raw browser telemetry behind dev mode.

        "Observability" is this module's own term for the endpoint layer these
        views read (controllers/observability.py) and is the umbrella that
        covers performance metrics and client errors alike, so a third beacon
        needs no naming argument. One word also matches the shape of this
        level, where most sections are single words. The narrower "Real User
        Monitoring" stays in the controller, where it accurately describes what
        the beacons are; "Monitoring" alone is taken by api_gateway for
        server-side monitoring, and "Performance" would mis-name JS Errors.
    -->
    <menuitem
        id="menu_technical_observability"
        name="Observability"
        parent="base.menu_custom"
        sequence="27"
        groups="base.group_system">
        <menuitem
            id="menu_web_js_error"
            name="JS Errors"
            action="action_web_js_error"
            sequence="20" />
        <menuitem
            id="menu_web_cwv_metric"
            name="Core Web Vitals"
            action="action_web_cwv_metric"
            sequence="30" />
    </menuitem>

</odoo>
