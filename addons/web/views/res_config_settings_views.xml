<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.web</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="0" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="is_root_company" invisible="1" />
                <app
                    name="general_settings"
                    string="General Settings"
                    data-string="General Settings"
                    logo="/base/static/description/settings.png">

                    <div id="invite_users">
                        <block name="users_setting_container" title="Users">
                            <setting id="invite_users_setting">
                                <widget name="res_config_invite_users" />
                            </setting>
                            <setting id="active_user_setting">
                                <span
                                    class="fa-solid fa-users fa-lg"
                                    aria-label="Number of active users" />
                                <field
                                    name="active_user_count"
                                    class="w-auto ps-3 fw-bold" />
                                <span
                                    class="o_form_label"
                                    invisible="active_user_count &gt; 1">
                                    Active User
                                </span>
                                <span
                                    class="o_form_label"
                                    invisible="active_user_count &lt;= 1">
                                    Active Users
                                </span>
                                <widget
                                    name="documentation_link"
                                    icon="fa-question-circle"
                                    path="/applications/general/users.html" />
                                <br />
                                <button
                                    name="%(base.action_res_users)d"
                                    type="action"
                                    string="Manage Users"
                                    icon="oi-arrow-right"
                                    class="btn-link o_web_settings_access_rights" />
                            </setting>
                        </block>
                    </div>

                    <div id="languages">
                        <block name="languages_setting_container" title="Languages">
                            <setting id="languages_setting">
                                <div class="w-50">
                                    <field
                                        name="language_count"
                                        class="w-auto ps-1 fw-bold" />
                                    <span
                                        class="o_form_label"
                                        invisible="language_count &gt; 1">
                                        Language
                                    </span>
                                    <span
                                        class="o_form_label"
                                        invisible="language_count &lt;= 1">
                                        Languages
                                    </span>
                                </div>
                                <div class="mt8">
                                    <button
                                        name="%(base.action_view_base_language_install)d"
                                        type="action"
                                        string="Add Languages"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                                <div class="mt8" groups="base.group_no_one">
                                    <button
                                        name="%(base.res_lang_act_window)d"
                                        type="action"
                                        string="Manage Languages"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                            </setting>
                        </block>
                    </div>

                    <div id="companies">
                        <block name="companies_setting_container" title="Companies">
                            <field name="company_id" invisible="1" />
                            <setting id="company_details_settings">
                                <field
                                    name="company_name"
                                    nolabel="1"
                                    class="fw-bold" />
                                <br />
                                <field
                                    name="company_informations"
                                    class="text-muted"
                                    style="width: 90%;" />
                                <br />
                                <button
                                    name="open_company"
                                    type="object"
                                    string="Update Info"
                                    icon="oi-arrow-right"
                                    class="btn-link" />
                            </setting>
                            <setting id="companies_setting">
                                <field
                                    name="company_count"
                                    nolabel="1"
                                    class="w-auto ps-1 fw-bold" />
                                <span
                                    class="o_form_label"
                                    invisible="company_count &gt; 1">
                                    Company
                                </span>
                                <span
                                    class="o_form_label"
                                    invisible="company_count &lt;= 1">
                                    Companies
                                </span>
                                <br />
                                <div class="mt8">
                                    <button
                                        name="%(base.action_res_company_form)d"
                                        type="action"
                                        string="Manage Companies"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                            </setting>
                            <setting
                                id="document_layout_setting"
                                string="Document Layout"
                                help="Choose the layout of your documents"
                                company_dependent="1">
                                <div class="content-group">
                                    <div class="mt16" groups="base.group_no_one">
                                        <label
                                            for="external_report_layout_id"
                                            string="Layout"
                                            class="col-3 col-lg-3 o_light_label" />
                                        <field
                                            name="external_report_layout_id"
                                            domain="[('type','=', 'qweb')]"
                                            class="oe_inline" />
                                    </div>
                                    <button
                                        name="%(web.action_base_document_layout_configurator)d"
                                        type="action"
                                        string="Configure Document Layout"
                                        icon="oi-arrow-right"
                                        class="oe_link" />
                                    <br groups="base.group_no_one" />
                                    <button
                                        name="edit_external_header"
                                        type="object"
                                        string="Edit Layout"
                                        icon="oi-arrow-right"
                                        groups="base.group_no_one"
                                        class="oe_link" />
                                    <br groups="base.group_no_one" />
                                    <button
                                        name="%(web.action_report_externalpreview)d"
                                        type="action"
                                        string="Preview Document"
                                        icon="oi-arrow-right"
                                        groups="base.group_no_one"
                                        class="oe_link" />
                                </div>
                            </setting>
                            <field name="company_id" invisible="1" />
                            <setting
                                id="inter_company"
                                string="Inter-Company Transactions"
                                title="Configure company rules to automatically create SO/PO when one of your company sells/buys to another of your company."
                                help="Create corresponding in/out orders and bills when you sell/buy between your companies"
                                groups="base.group_multi_company"
                                company_dependent="1">
                                <field
                                    name="module_account_inter_company_rules"
                                    widget="upgrade_boolean" />
                                <div
                                    class="content-group"
                                    invisible="not module_account_inter_company_rules"
                                    id="inter_companies_rules">
                                    <div class="mt16 text-warning"><strong>Save</strong> this page
                                        and come back here to set up the feature.</div>
                                </div>
                            </setting>
                        </block>
                    </div>
                    <div id="emails" />

                    <div id="contacts_settings">
                        <block name="contacts_setting_container" title="Contacts">
                            <setting
                                id="sms"
                                string="Send SMS"
                                help="Send texts to your contacts"
                                documentation="/applications/marketing/sms_marketing/pricing/pricing_and_faq.html">
                                <field name="module_sms" invisible="1" />
                            </setting>
                            <setting
                                id="partner_autocomplete"
                                title="When populating your address book, Odoo provides a list of matching companies. When selecting one item, the company data and logo are auto-filled."
                                help="Automatically enrich your contact base with company data">
                                <field name="module_partner_autocomplete" />
                            </setting>
                        </block>
                    </div>

                    <block id="user_default_rights" title="Permissions">
                        <setting
                            id="access_rights"
                            string="Default Access Rights"
                            title="By default, new users get highest access rights for all installed apps. If unchecked, new users will only have basic employee access."
                            help="Set custom access rights for new users">
                            <div class="content-group">
                                <div class="mt8">
                                    <button
                                        name="open_new_user_default_groups"
                                        type="object"
                                        string="Default Access Rights"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            string="API Keys"
                            help="API Keys allow your users to access Odoo with external tools when multi-factor authentication is enabled."
                            groups="base.group_system">
                            <button
                                name="%(base.action_apikeys_admin)d"
                                type="action"
                                string="Manage API Keys"
                                icon="oi-arrow-right"
                                class="btn-link" />
                        </setting>
                        <setting
                            id="allow_import"
                            string="Import &amp; Export"
                            help="Allow users to import data from CSV/XLS/XLSX/ODS files"
                            groups="base.group_no_one"
                            documentation="/applications/general/export_import_data.html">
                            <field name="module_base_import" />
                        </setting>
                        <setting
                            id="feedback_motivate_setting"
                            help="Add fun feedback and motivate your employees"
                            groups="base.group_no_one">
                            <field name="show_effect" />
                        </setting>
                    </block>

                    <block
                        id="pwa_settings"
                        title="Progressive Web App"
                        groups="base.group_no_one">
                        <setting
                            help="This name will be used for the application when Odoo is installed through the browser.">
                            <field name="web_app_name" placeholder="Odoo" />
                        </setting>
                    </block>

                    <block name="integration" title="Integrations">
                        <setting
                            id="mail_pluggin_setting"
                            string="Mail Plugin"
                            help="Integrate with mail client plugins"
                            documentation="/applications/productivity/mail_plugins.html">
                            <field name="module_mail_plugin" />
                        </setting>
                        <setting
                            id="module_auth_oauth"
                            string="OAuth Authentication"
                            help="Use external accounts to log in (Google, Facebook, etc.)">
                            <field name="module_auth_oauth" />
                            <div
                                class="content-group mt16"
                                invisible="not module_auth_oauth"
                                id="msg_module_auth_oauth">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to set up the feature.</div>
                            </div>
                        </setting>
                        <setting
                            id="module_auth_ldap"
                            string="LDAP Authentication"
                            help="Use LDAP credentials to log in"
                            documentation="/applications/general/auth/ldap.html">
                            <field name="module_auth_ldap" />
                            <div
                                class="content-group"
                                invisible="not module_auth_ldap"
                                id="auth_ldap_warning">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to set up the feature.</div>
                            </div>
                        </setting>
                        <setting
                            id="unsplash"
                            help="Find free high-resolution images from Unsplash"
                            documentation="/applications/websites/website/optimize/unsplash.html">
                            <field name="module_web_unsplash" />
                            <div
                                class="content-group"
                                invisible="not module_web_unsplash"
                                id="web_unsplash_warning">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to set up the feature.</div>
                            </div>
                        </setting>
                        <setting
                            id="geocoding"
                            string="Geolocation"
                            help="Geolocate your partners"
                            documentation="/applications/general/integrations/geolocation.html">
                            <field name="module_geocoding" />
                            <div
                                class="content-group"
                                invisible="not module_geocoding"
                                name="geocoding_warning">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to choose your Geo Provider.</div>
                            </div>
                        </setting>
                        <setting
                            id="recaptcha"
                            help="Protect your forms from spam and abuse.">
                            <field name="module_google_recaptcha" />
                            <div
                                class="content-group"
                                invisible="not module_google_recaptcha"
                                id="recaptcha_warning">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to set up reCaptcha.</div>
                            </div>
                        </setting>
                        <setting
                            id="cf-turnstile"
                            help="Protect your forms with CF Turnstile.">
                            <field name="module_website_cf_turnstile" />
                            <div
                                class="content-group"
                                invisible="not module_website_cf_turnstile"
                                id="turnstile_warning">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to set up Cloudflare turnstile.</div>
                            </div>
                        </setting>
                        <setting
                            id="google_address_autocomplete"
                            help="Autocomplete partner addresses with Google Places">
                            <field name="module_google_address_autocomplete" />
                            <div
                                class="content-group"
                                invisible="not module_google_address_autocomplete"
                                id="google_address_autocomplete_warning">
                                <div class="mt16 text-warning"><strong>Save</strong> this page and
                                    come back here to set up Google Places API key</div>
                            </div>
                        </setting>
                    </block>

                    <block
                        name="performance"
                        title="Performance"
                        groups="base.group_no_one">
                        <setting
                            id="profiling_enabled_until"
                            help="Enable the profiling tool. Profiling may impact performance while being active.">
                            <field name="profiling_enabled_until" />
                        </setting>
                    </block>

                    <widget name="res_config_dev_tool" />
                    <div id="about">
                        <block name="about_setting_container" title="About">
                            <widget name="res_config_edition" />
                        </block>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_general_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="path">settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'general_settings', 'bin_size': False}</field>
    </record>

</odoo>
