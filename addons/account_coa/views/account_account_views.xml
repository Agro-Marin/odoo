<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_search" model="ir.ui.view">
        <field name="name">account.account.search</field>
        <field name="model">account.account</field>
        <field name="arch" type="xml">
            <search string="Accounts">
                <field
                    name="name"
                    string="Account"
                    filter_domain="['|', '|', ('name', 'ilike', self), ('code', '=ilike', self + '%'), ('description', 'ilike', self)]" />
                <filter
                    name="receivableacc"
                    string="Receivable"
                    domain="[('account_type','=','asset_receivable')]" />
                <filter
                    name="payableacc"
                    string="Payable"
                    domain="[('account_type','=','liability_payable')]" />
                <filter
                    name="equityacc"
                    string="Equity"
                    domain="[('internal_group','=', 'equity')]" />
                <filter
                    name="assetsacc"
                    string="Assets"
                    domain="[('internal_group','=', 'asset')]" />
                <filter
                    name="liabilityacc"
                    string="Liability"
                    domain="[('internal_group','=', 'liability')]" />
                <filter
                    name="incomeacc"
                    string="Income"
                    domain="[('internal_group','=', 'income')]" />
                <filter
                    name="expensesacc"
                    string="Expenses"
                    domain="[('internal_group','=', 'expense')]" />
                <filter
                    name="type_asset_fixed"
                    string="Fixed Assets"
                    domain="[('account_type', '=', 'asset_fixed')]"
                    invisible="True" />
                <filter
                    name="type_expense"
                    string="Frequent Expenses"
                    domain="[('account_type', '=', 'expense')]"
                    invisible="True" />
                <filter
                    name="type_expense_direct_cost"
                    string="Cost of revenue"
                    domain="[('account_type', '=', 'expense_direct_cost')]"
                    invisible="True" />
                <separator />
                <filter
                    name="inactiveacc"
                    string="Inactive Accounts"
                    domain="[('active', '=', False)]" />
                <separator />
                <field name="account_type" />
                <group>
                    <filter
                        name="accounttype"
                        string="Account Type"
                        context="{'group_by':'account_type'}" />
                </group>
                <searchpanel class="account_root w-auto">
                    <field name="root_id" icon="fa-filter" limit="false" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list</field>
        <field name="model">account.account</field>
        <field name="arch" type="xml">
            <list string="Chart of accounts" create="1" delete="1" multi_edit="1">
                <field name="placeholder_code" column_invisible="1" />
                <field name="internal_group" column_invisible="True" />

                <field
                    name="code"
                    string="Code"
                    widget="char_with_placeholder_field"
                    options="{'placeholder_field': 'placeholder_code'}" />
                <field name="name" />
                <field name="account_type" widget="account_type_selection" />
                <field
                    name="reconcile"
                    widget="boolean_toggle"
                    invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance')" />
                <field name="active" widget="boolean_toggle" optional="hide" />
                <field
                    name="non_trade"
                    widget="boolean_toggle"
                    optional="hide"
                    invisible="account_type not in ('liability_payable', 'asset_receivable')" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    optional="hide"
                    domain="[('applicability', '=', 'accounts')]" />
                <field
                    name="currency_id"
                    options="{'no_create': True}"
                    groups="base.group_multi_currency" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    optional="show"
                    groups="base.group_multi_company"
                    readonly="True" />
            </list>
        </field>
    </record>

    <record id="view_account_account_kanban" model="ir.ui.view">
        <field name="name">account.account.kanban</field>
        <field name="model">account.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <field name="name" class="fw-bolder" />
                            </div>
                            <div class="col-4 text-end">
                                <field name="code" class="badge rounded-pill" />
                            </div>
                        </div>
                        <div>
                            <strong>Type: </strong>
                            <field name="account_type" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form</field>
        <field name="model">account.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div>
                        <h1 style="font-size: 1.9rem;">
                            <div class="row">
                                <div class="col col-md-8">
                                    <label for="name" string="Account Name" />
                                    <div>
                                        <field
                                            name="name"
                                            placeholder="e.g. Current Assets"
                                            style="width:80% !important;" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col col-md-auto">
                                    <label for="code" string="Code" />
                                    <div>
                                        <field name="placeholder_code" invisible="1" />
                                        <field
                                            name="code"
                                            placeholder="e.g. 101000"
                                            options="{'placeholder_field': 'placeholder_code'}"
                                            class="oe_inline" />
                                    </div>
                                </div>
                            </div>
                        </h1>
                    </div>
                    <notebook>
                        <page name="accounting" string="Accounting">
                            <group>
                                <group>
                                    <field
                                        name="account_type"
                                        widget="account_type_selection" />
                                    <field
                                        name="tag_ids"
                                        widget="many2many_tags"
                                        domain="[('applicability', '=', 'accounts')]"
                                        context="{'default_applicability': 'accounts'}"
                                        options="{'no_create_edit': True}" />
                                </group>
                                <group>
                                    <field name="internal_group" invisible="1" />
                                    <field
                                        name="currency_id"
                                        string="Currency"
                                        placeholder="Any currency"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_currency" />
                                    <field name="active" widget="boolean_toggle" />
                                    <field
                                        name="company_ids"
                                        widget="many2many_tags"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_company" />
                                </group>
                            </group>
                        </page>
                        <page name="Description">
                            <field name="description" />
                        </page>
                        <page
                            name="mapping"
                            string="Mapping"
                            groups="base.group_multi_company"
                            invisible="not display_mapping_tab">
                            <field name="code_mapping_ids">
                                <list editable="bottom">
                                    <field name="company_id" force_save="1" />
                                    <field name="code" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_form" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_account_list" />
        <field name="search_view_id" ref="view_account_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new account
            </p>
            <p>
                An account is part of a ledger allowing your company
                to register all kinds of debit and credit transactions.
                Companies present their annual accounts in two main parts: the
                balance sheet and the income statement (profit and loss
                account). The annual accounts of a company are required by law
                to disclose a certain amount of information.
            </p>
        </field>
    </record>

</odoo>
