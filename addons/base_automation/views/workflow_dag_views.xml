<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================================
         Workflow DAG Enhancements for base.automation
         ======================================================================== -->

    <record id="view_base_automation_form_workflow_dag" model="ir.ui.view">
        <field name="name">base.automation.form.workflow.dag</field>
        <field name="model">base.automation</field>
        <field name="inherit_id" ref="base_automation.view_base_automation_form" />
        <field name="arch" type="xml">

            <!-- Helpful info panel for on_hand trigger -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group invisible="trigger != 'on_hand'">
                    <div class="alert alert-info" role="alert">
                        <h5><i class="fa-regular fa-hand" /> Manual Trigger</h5>
                        <p class="mb-1">This automation runs only when manually triggered.</p>
                        <ul class="mb-0">
                            <li>Select the records on the target model, then run this rule from the
                                list view's <strong>Actions</strong> menu</li>
                            <li>Or call <code>action_manual_trigger()</code> with
                                <code>active_model</code> and <code>active_ids</code> in the context</li>
                        </ul>
                        <p class="mb-0 mt-2">
                            <em>Tip: Add <strong>predecessor dependencies</strong> between actions in the
                                Actions tab for multi-step DAG execution. A manual run records every
                                step, with its outcome, under Automation Runtimes.</em>
                        </p>
                    </div>
                </group>
            </xpath>

            <!-- The Actions tab deliberately keeps the base view's kanban mode.
                 Forcing it to list,form here changed the tab for *every*
                 automation, DAG or not, just to surface two columns — and it
                 replaced the widget the rest of the product (and its tours)
                 drives. Dependencies are edited on the action form itself,
                 which the kanban opens: see view_ir_actions_server_form_workflow_dag. -->

        </field>
    </record>

</odoo>
