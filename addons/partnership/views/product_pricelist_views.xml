<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_pricelist_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.view_product_pricelist_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <div name="button_box" class="oe_button_box">
                    <button
                        name="partnership.action_pricelist_partners"
                        type="action"
                        icon="fa-users"
                        class="oe_stat_button">
                        <field
                            name="partners_count"
                            widget="statinfo"
                            nolabel="1"
                            class="oe_inline me-1" />
                        <field name="partners_label" widget="statinfo" nolabel="1" />
                    </button>
                </div>
            </sheet>
        </field>
    </record>

</odoo>
