<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_search" model="ir.ui.view">
        <field name="name">Production Lots Filter</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search string="Product Lots Filter">
                <field
                    name="name"
                    string="Lot/Serial Number"
                    filter_domain="['|', ('name', 'ilike', self),('ref', 'ilike', self)]" />
                <field name="partner_ids" string="Customers" />
                <field name="product_id" />
                <field name="lot_properties" />
                <field name="create_date" />
                <filter
                    name="at_customer"
                    string="At Customer"
                    domain="[('quant_ids.location_id.usage','=','customer'), ('quant_ids.quantity', '&gt;', 0)]" />
                <filter
                    name="on_hand"
                    string="On Hand"
                    domain="[('product_qty', '&gt;', 0)]" />
                <filter
                    name="creation_date"
                    string="Creation Date"
                    date="create_date" />
                <group>
                    <filter
                        name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_id'}" />
                    <filter
                        name="group_by_location"
                        string="Location"
                        context="{'group_by': 'location_id'}"
                        groups="stock.group_stock_multi_locations" />
                    <filter
                        name="group_by_creation_date"
                        string="Creation date"
                        context="{'group_by': 'create_date'}" />
                    <filter
                        name="group_by_Company"
                        string="Company"
                        context="{'group_by': 'company_id'}" />
                    <filter
                        name="group_by_lot_properties"
                        string="Properties"
                        context="{'group_by': 'lot_properties'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_stock_lot_list" model="ir.ui.view">
        <field name="name">stock.production.lot.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Lots/Serial Numbers" multi_edit="1">
                <field name="name" decoration-bf="1" />
                <field name="product_id" readonly="1" />
                <field name="ref" optional="hide" />
                <field name="create_date" optional="show" />
                <field name="company_id" groups="base.group_multi_company" />
                <field
                    name="partner_ids"
                    string="Transfer to"
                    widget="many2many_tags"
                    optional="hide" />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field name="lot_properties" optional="hide" />
                <field name="product_qty" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_stock_lot_kanban" model="ir.ui.view">
        <field name="name">stock.production.lot.kanban</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <kanban group_create="false" group_delete="false">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bolder fs-5" />
                        <field name="product_id" class="small" />
                        <field name="lot_properties" widget="properties" />
                        <field name="activity_ids" widget="kanban_activity" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_lot_form" model="ir.ui.view">
        <field name="name">stock.production.lot.form</field>
        <field name="model">stock.lot</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Lots/Serial Numbers">
                <header />
                <sheet>
                    <field name="company_id" invisible="1" />
                    <field name="display_complete" invisible="1" />
                    <div
                        class="oe_button_box"
                        name="button_box"
                        invisible="not display_complete">
                        <button
                            name="action_lot_open_transfers"
                            type="object"
                            help="Transfers"
                            icon="fa-truck"
                            invisible="count_transfer_outgoing == 0"
                            class="oe_stat_button">
                            <field
                                name="count_transfer_outgoing"
                                string="Transfers"
                                widget="statinfo" />
                        </button>
                        <button
                            name="action_lot_open_quants"
                            type="object"
                            icon="fa-arrows"
                            groups="stock.group_stock_multi_locations"
                            class="oe_stat_button">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Location</span>
                            </div>
                        </button>
                        <button
                            name="%(action_stock_report)d"
                            type="action"
                            icon="oi-arrow-up"
                            class="oe_stat_button">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Traceability</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. LOT/0001/20121" />
                        </h1>
                    </div>
                    <group name="main_group">
                        <group string="Information">
                            <field
                                name="product_id"
                                help="Product this lot/serial number contains. You cannot change it anymore if it has already been moved."
                                force_save="1"
                                context="{'default_is_storable': True, 'default_tracking': 'lot'}"
                                readonly="context.get('set_product_readonly', False)" />
                            <field name="ref" string="Reference" />
                            <field
                                name="company_id"
                                placeholder="Visible to all"
                                groups="base.group_multi_company" />
                            <field
                                name="partner_ids"
                                string="Customer"
                                widget="many2many_tags"
                                options="{'edit_tags': True}"
                                groups="stock.group_stock_manager"
                                invisible="not partner_ids or not location_id" />
                        </group>
                        <group name="inventory_group" string="Inventory">
                            <label for="product_qty" invisible="not display_complete" />
                            <div invisible="not display_complete">
                                <field name="product_qty" class="oe_inline me-1" />
                                <field
                                    name="product_uom_id"
                                    widget="many2one_uom"
                                    options="{'no_open': True}"
                                    groups="uom.group_uom"
                                    class="oe_inline" />
                            </div>
                            <field
                                name="location_id"
                                groups="stock.group_stock_manager"
                                invisible="not location_id" />
                        </group>
                        <field
                            name="lot_properties"
                            nolabel="1"
                            columns="2"
                            hideAddButton="1" />
                    </group>
                    <notebook invisible="not display_complete">
                        <page name="description" string="Description">
                            <field name="note" placeholder="Add an internal note" />
                        </page>
                        <page name="other_info" string="Other Info">
                            <group>
                                <group>
                                </group>
                                <group>
                                    <field
                                        name="company_id"
                                        placeholder="Visible to all coompanies"
                                        groups="base.group_multi_company" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_stock_lot_form" model="ir.actions.act_window">
        <field name="name">Lots / Serial Numbers</field>
        <field name="res_model">stock.lot</field>
        <field name="path">lots</field>
        <field name="search_view_id" ref="view_stock_lot_search" />
        <field
            name="domain">['|', ('location_id', '=', False), ('location_id.company_id', 'in', allowed_company_ids + [False])]</field>
        <field
            name="context">{'search_default_group_by_location': True, 'display_complete': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a lot/serial number
            </p>
            <p>
                Lots/Serial numbers help you tracking the path followed by your products.
                From their traceability report you will see the full history of their use, as well
                as their composition.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'list', 'view_id': ref('view_stock_lot_list')}), Command.create({'view_mode': 'kanban', 'view_id': ref('view_stock_lot_kanban')}), Command.create({'view_mode': 'form', 'view_id': ref('view_stock_lot_form')})]" />
    </record>

    <record id="action_stock_lot_form_2" model="ir.actions.act_window">
        <field name="name">Lots/Serial Numbers</field>
        <field name="res_model">stock.lot</field>
        <field name="search_view_id" ref="view_stock_lot_search" />
        <field
            name="domain">['|', ('location_id', '=', False), ('location_id.company_id', 'in', allowed_company_ids + [False])]</field>
        <field
            name="context">{'search_default_group_by_product': 1, 'display_complete': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a lot/serial number
            </p>
            <p>
                Lots/Serial numbers help you tracking the path followed by your products.
                From their traceability report you will see the full history of their use, as well
                as their composition.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'kanban', 'view_id': ref('view_stock_lot_kanban')}), Command.create({'view_mode': 'list', 'view_id': ref('view_stock_lot_list')}), Command.create({'view_mode': 'form', 'view_id': ref('view_stock_lot_form')})]" />
    </record>

</odoo>
