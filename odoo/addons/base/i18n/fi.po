msgid ""
"\n"
"Import a custom data module\n"
"===========================\n"
"\n"
"This module allows authorized users to import a custom data module (.xml "
"files and static assests)\n"
"for customization purpose.\n"
msgstr ""
"\n"
"Tuo mukautettu datamoduuli\n"
"===========================\n"
