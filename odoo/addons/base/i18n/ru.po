#. module: base
#: model:ir.module.module,description:base.module_hr_payroll_account
msgid ""
"\n"
"Generic Payroll system Integrated with Accounting.\n"
"==================================================\n"
"\n"
"    * Expense Encoding\n"
"    * Payment Encoding\n"
"    * Company Contribution Management\n"
