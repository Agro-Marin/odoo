#. module: base
#: model:ir.module.module,description:base.module_l10n_tz_account
msgid ""
"\n"
"Tanzanian localisation containing:\n"
"- COA\n"
"- Taxes\n"
"- Tax report\n"
"- Fiscal position\n"
msgstr ""
