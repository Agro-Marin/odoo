<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_grant_view_list" model="ir.ui.view">
        <field name="name">res.users.grant.list</field>
        <field name="model">res.users.grant</field>
        <field name="arch" type="xml">
            <list
                string="Grants"
                decoration-info="state == 'scheduled'"
                decoration-muted="state in ('expired', 'revoked')">
                <field name="user_id" />
                <field name="group_id" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="date_from" optional="show" />
                <field name="date_to" optional="show" />
                <field name="state" widget="badge" />
                <field name="cause" optional="show" />
                <field name="granted_by_id" optional="show" />
                <field name="create_date" string="Granted On" optional="hide" />
                <field name="reason" optional="hide" />
            </list>
        </field>
    </record>

    <record id="res_users_grant_view_form" model="ir.ui.view">
        <field name="name">res.users.grant.form</field>
        <field name="model">res.users.grant</field>
        <field name="arch" type="xml">
            <form string="Grant">
                <header>
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        confirm="End this grant now?"
                        invisible="state not in ('scheduled', 'active')" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="id" />
                            <field name="group_id" readonly="id" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                groups="base.group_multi_company"
                                readonly="state in ('expired', 'revoked')" />
                            <field name="reason" />
                        </group>
                        <group>
                            <field
                                name="date_from"
                                readonly="state not in ('scheduled', False)" />
                            <field
                                name="date_to"
                                readonly="state in ('expired', 'revoked')" />
                            <field name="cause" />
                            <field name="cause_model" invisible="not cause_model" />
                            <field name="cause_res_id" invisible="not cause_model" />
                        </group>
                    </group>
                    <group invisible="not id">
                        <group>
                            <field name="granted_by_id" />
                            <field name="create_date" string="Granted On" />
                        </group>
                        <group invisible="state != 'revoked'">
                            <field name="revoked_by_id" />
                            <field name="revoked_at" />
                            <field name="revoke_reason" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_users_grant_view_search" model="ir.ui.view">
        <field name="name">res.users.grant.search</field>
        <field name="model">res.users.grant</field>
        <field name="arch" type="xml">
            <search string="Grants">
                <field name="user_id" />
                <field name="group_id" />
                <field name="granted_by_id" />
                <filter
                    name="live"
                    string="Live"
                    domain="[('state', 'in', ('scheduled', 'active'))]" />
                <filter
                    name="timed"
                    string="Time-bound"
                    domain="[('date_to', '!=', False)]" />
                <separator />
                <filter
                    name="ended"
                    string="Ended"
                    domain="[('state', 'in', ('expired', 'revoked'))]" />
                <group>
                    <filter
                        name="group_by_user"
                        string="User"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="group_by_group"
                        string="Group"
                        context="{'group_by': 'group_id'}" />
                    <filter
                        name="group_by_cause"
                        string="Cause"
                        context="{'group_by': 'cause'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_users_grant" model="ir.actions.act_window">
        <field name="name">Grants</field>
        <field name="res_model">res.users.grant</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="ir_access_log_view_list" model="ir.ui.view">
        <field name="name">ir.access.log.list</field>
        <field name="model">ir.access.log</field>
        <field name="arch" type="xml">
            <list string="Authorization Log" create="0" edit="0" delete="0">
                <field name="create_date" string="Date" />
                <field name="event" />
                <field name="actor_id" />
                <field name="subject_user_id" />
                <field name="group_id" />
                <field name="cause" optional="show" />
                <field name="count" optional="hide" />
                <field name="reason" optional="show" />
            </list>
        </field>
    </record>

    <record id="ir_access_log_view_search" model="ir.ui.view">
        <field name="name">ir.access.log.search</field>
        <field name="model">ir.access.log</field>
        <field name="arch" type="xml">
            <search string="Authorization Log">
                <field name="subject_user_id" />
                <field name="actor_id" />
                <field name="group_id" />
                <field name="event" />
                <group>
                    <filter
                        name="group_by_event"
                        string="Event"
                        context="{'group_by': 'event'}" />
                    <filter
                        name="group_by_subject"
                        string="Subject"
                        context="{'group_by': 'subject_user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ir_access_log" model="ir.actions.act_window">
        <field name="name">Authorization Log</field>
        <field name="res_model">ir.access.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
