<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_module_filter" model="ir.ui.view">
        <field name="name">ir.module.module.list.select</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
            <search string="Search modules">
                <field
                    name="name"
                    string="Module"
                    filter_domain="['|', '|', ('summary', 'ilike', self), ('shortdesc', 'ilike', self), ('name','ilike', self)]" />
                <filter
                    name="app"
                    string="Apps"
                    domain="[('application', '=', True)]" />
                <filter
                    name="extra"
                    string="Extra"
                    domain="[('application', '=', False)]" />
                <separator />
                <filter
                    name="installed"
                    string="Installed"
                    domain="[('state', 'in', ['installed', 'to upgrade', 'to remove'])]" />
                <filter
                    name="not_installed"
                    string="Not Installed"
                    domain="[('state', 'in', ['uninstalled', 'uninstallable', 'to install'])]" />
                <field name="category_id" />
                <group>
                    <filter
                        name="author"
                        string="Author"
                        context="{'group_by':'author'}" />
                    <filter
                        name="category"
                        string="Category"
                        context="{'group_by':'category_id'}" />
                    <filter
                        name="state"
                        string="Status"
                        context="{'group_by':'state'}" />
                </group>
                <searchpanel>
                    <field name="category_id" string="Categories" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_module_category_form" model="ir.ui.view">
        <field name="name">ir.module.category.form</field>
        <field name="model">ir.module.category</field>
        <field name="arch" type="xml">
            <form string="Module Category">
                <group col="4">
                    <field name="name" />
                    <field name="parent_id" />
                    <field name="sequence" />
                </group>
                <field name="description" />
            </form>
        </field>
    </record>

    <record id="module_tree" model="ir.ui.view">
        <field name="name">ir.module.module.list</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
            <list
                string="Apps"
                create="0"
                decoration-info="state == 'uninstalled'"
                decoration-muted="state == 'uninstallable'">
                <header>
                    <button
                        name="button_immediate_install"
                        type="object"
                        string="Activate"
                        groups="base.group_system" />
                    <button
                        name="button_immediate_upgrade"
                        type="object"
                        string="Upgrade"
                        groups="base.group_system" />
                </header>
                <field name="shortdesc" />
                <field name="name" groups="base.group_no_one" />
                <field name="author" />
                <field name="website" />
                <field name="manifest_version" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state  == 'uninstalled'"
                    decoration-muted="state == 'uninstallable'"
                    decoration-success="state == 'installed'" />
            </list>
        </field>
    </record>

    <record id="module_view_kanban" model="ir.ui.view">
        <field name="name">Apps Kanban</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_modules_kanban" can_open="0">
                <field name="to_buy" />
                <field name="name" />
                <field name="state" />
                <field name="summary" />
                <field name="website" />
                <field name="application" />
                <templates>
                    <t t-name="menu">
                        <t
                            t-set="installed"
                            t-value="record.state.raw_value == 'installed'" />
                        <a type="open" class="dropdown-item">Module Info</a>
                        <a t-if="record.website.raw_value" role="menuitem" class="dropdown-item o-hidden-ios" t-att-href="record.website.raw_value" target="_blank">Learn More</a>
                        <a t-if="installed" name="button_immediate_upgrade" type="object" role="menuitem" class="dropdown-item" groups="base.group_system">Upgrade</a>
                        <a
                            t-if="installed"
                            name="button_uninstall_wizard"
                            type="object"
                            role="menuitem"
                            class="dropdown-item"
                            groups="base.group_system">
                            Uninstall…</a>
                    </t>
                    <t t-name="card" class="flex-row align-items-center">
                        <aside>
                            <field
                                name="icon"
                                widget="image_url"
                                options="{'size': [50, 50]}"
                                alt="Icon" />
                            <field
                                name="icon_flag"
                                class="oe_module_flag"
                                t-if="record.icon_flag.raw_value" />
                        </aside>
                        <main class="me-4" t-att-title="record.shortdesc.value">
                            <field name="shortdesc" class="fw-bold fs-5" />
                            <p class="text-muted small my-0 lh-sm">
                                <field name="summary" groups="!base.group_no_one" />
                                <code groups="base.group_no_one">
                                    <field name="name" />
                                </code>
                            </p>
                            <footer class="w-100 justify-content-between">
                                <button
                                    name="button_immediate_install"
                                    type="object"
                                    groups="base.group_system"
                                    invisible="state != 'uninstalled'"
                                    class="btn btn-primary btn-sm"
                                    t-if="! record.to_buy.raw_value">
                                    Activate</button>
                                <button
                                    class="d-flex align-items-center text-muted float-start"
                                    t-if="record.state.raw_value === 'installed'">
                                    Installed</button>
                                <a t-att-href="record.website.raw_value" target="_blank" invisible="website in (False, '')" class="btn btn-sm btn-secondary float-end o-hidden-ios" role="button">Learn More</a>
                                <a type="open" class="btn btn-secondary btn-sm float-end" id="module_info" role="button" invisible="website != ''">Module
                                    Info</a>
                                <a href="https://odoo.com/pricing?utm_source=db&amp;utm_medium=module#hosting=on_premise" target="_blank" class="btn btn-info btn-sm" invisible="state not in ('uninstalled', 'uninstallable')" t-if="record.to_buy.raw_value" role="button" groups="base.group_system">Upgrade</a>
                                <button groups="base.group_system" invisible="state != 'to remove'" class="btn btn-sm btn-secondary" disabled="1">Removing</button>
                                <button groups="base.group_system" invisible="state != 'to upgrade'" class="btn btn-sm btn-secondary" disabled="1">Upgrading</button>
                                <button groups="base.group_system" invisible="state != 'to install'" class="btn btn-sm btn-secondary" disabled="1">Installing</button>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="module_form" model="ir.ui.view">
        <field name="name">ir.module.module.form</field>
        <field name="model">ir.module.module</field>
        <field name="arch" type="xml">
            <form string="Module" create="0" edit="0" class="o_module_form">
                <link rel="stylesheet" href="/base/static/src/css/description.css" />
                <sheet>
                    <field name="icon_image" widget="image" class="oe_avatar" />
                    <div class="mb32">
                        <h1 class="d-flex flex-column">
                            <field name="shortdesc" placeholder="Module Name" />
                            <field
                                name="summary"
                                invisible="not summary"
                                class="fs-2 text-muted" />
                        </h1>
                        <h4 class="text-muted d-flex flex-column">
                            <div>By <field name="author" placeholder="Author Name" class="oe_inline" />
                            </div>
                            <small>
                                <field
                                    name="website"
                                    widget="url"
                                    invisible="not website" />
                            </small>
                        </h4>

                        <div>
                            <button
                                name="button_immediate_install"
                                type="object"
                                string="Activate"
                                groups="base.group_system"
                                invisible="to_buy or state != 'uninstalled'"
                                class="btn btn-primary me-1" />
                            <a href="https://odoo.com/pricing?utm_source=db&amp;utm_medium=module#hosting=on_premise" target="_blank" class="btn btn-primary me-1" invisible="not to_buy or state not in ('uninstalled', 'uninstallable')" role="button">Upgrade</a>
                            <button
                                name="button_immediate_upgrade"
                                type="object"
                                string="Upgrade"
                                groups="base.group_system"
                                invisible="state != 'installed'"
                                class="btn btn-primary me-1" />
                            <button
                                name="button_uninstall_wizard"
                                type="object"
                                string="Uninstall"
                                groups="base.group_system"
                                invisible="state != 'installed'"
                                class="btn btn-secondary me-1" />
                            <button groups="base.group_system" invisible="state != 'to remove'" class="btn btn-secondary me-1" disabled="1">Removing</button>
                            <button groups="base.group_system" invisible="state != 'to upgrade'" class="btn btn-secondary me-1" disabled="1">Upgrading</button>
                            <button groups="base.group_system" invisible="state != 'to install'" class="btn btn-secondary me-1" disabled="1">Installing</button>
                        </div>
                        <h6 class="text-muted mt-2" invisible="not has_iap">Contains In-App
                            Purchases</h6>
                    </div>
                    <notebook groups="base.group_no_one">
                        <page name="information" string="Information">
                            <group>
                                <group>
                                    <field
                                        name="category_id"
                                        options="{'no_open': True, 'no_create': True}" />
                                    <field name="name" />
                                    <field name="license" />
                                    <field name="manifest_version" />
                                </group>
                            </group>
                        </page>
                        <page name="technical_data" string="Technical Data">
                            <group col="4">
                                <field name="demo" />
                                <field name="application" />
                                <field name="state" />
                            </group>
                            <group>
                                <group string="Dependencies">
                                    <field
                                        name="dependencies_id"
                                        colspan="2"
                                        nolabel="1">
                                        <list string="Dependencies">
                                            <field name="name" />
                                            <field name="state" />
                                        </list>
                                    </field>
                                </group>
                                <group string="Exclusions">
                                    <field name="exclusion_ids" colspan="2" nolabel="1">
                                        <list string="Exclusions">
                                            <field name="name" />
                                            <field name="state" />
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page
                            name="installed_features"
                            string="Installed Features"
                            invisible="state != 'installed'">
                            <separator string="Created Menus" />
                            <field name="menus_by_module" />
                            <separator string="Created Views" />
                            <field name="views_by_module" />
                            <separator string="Defined Reports" />
                            <field name="reports_by_module" />
                        </page>
                    </notebook>
                    <field
                        name="description_html"
                        invisible="not description_html"
                        class="oe_styling_v8" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="open_module_tree" model="ir.actions.act_window">
        <field name="name">Apps</field>
        <field name="res_model">ir.module.module</field>
        <field name="path">apps</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_module_filter" />
        <field name="context">{'search_default_app':1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No module found!
            </p>
            <p>
                You should try other search criteria.
            </p>
        </field>
    </record>

    <record id="action_third_party" model="ir.actions.act_url">
        <field name="name">Third-Party Apps</field>
        <field name="url">https://apps.odoo.com/apps/modules</field>
    </record>

    <record id="action_theme_store" model="ir.actions.act_url">
        <field name="name">Theme Store</field>
        <field name="url">https://apps.odoo.com/apps/themes</field>
    </record>

</odoo>
