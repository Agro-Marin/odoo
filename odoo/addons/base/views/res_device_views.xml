<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_device_view_tree" model="ir.ui.view">
        <field name="name">res.device.list</field>
        <field name="model">res.device</field>
        <field name="arch" type="xml">
            <list default_order="last_activity desc">
                <field name="user_id" />
                <field name="display_name" string="Name" />
                <field name="ip_address" />
                <field name="first_activity" />
                <field name="last_activity" />
                <field name="country" optional="hide" />
                <field name="city" optional="hide" />
                <field name="active" column_invisible="1" />
                <button
                    name="revoke"
                    type="object"
                    string="Revoke"
                    invisible="not active"
                    class="btn btn-secondary" />
            </list>
        </field>
    </record>

    <record id="res_device_view_kanban" model="ir.ui.view">
        <field name="name">res.device.kanban</field>
        <field name="model">res.device</field>
        <field name="arch" type="xml">
            <kanban
                default_order="is_current desc, last_activity desc"
                create="0"
                can_open="0">
                <field name="id" />
                <field name="device_type" />
                <field name="last_activity" />
                <field name="is_current" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <span
                            t-if="record.device_type.raw_value === 'computer'"
                            class="fa-solid fa-laptop fs-1 col-1 mx-auto"
                            title="Computer"
                            role="img"
                            aria-label="Computer" />
                        <span
                            t-else=""
                            class="fa-solid fa-mobile-screen-button fs-1 col-1 mx-auto"
                            title="Mobile"
                            role="img"
                            aria-label="Mobile" />
                        <div class="d-flex col-11">
                            <div class="d-flex flex-column ms-2">
                                <div class="d-flex align-items-center">
                                    <field
                                        name="display_name"
                                        string="Name"
                                        class="fw-bolder" />
                                    <t t-if="record.is_current.raw_value">
                                        <span
                                            class="ms-2 text-success o_status o_status_green" />
                                    </t>
                                    <span
                                        t-out="luxon.DateTime.fromISO(record.last_activity.raw_value).toRelative()"
                                        class="ms-2 text-muted" />
                                </div>
                                <field name="ip_address" />
                                <field name="country" />
                                <field name="city" />
                            </div>
                            <button
                                name="revoke"
                                type="object"
                                string="Log out"
                                class="btn btn-secondary ms-auto mb-auto my-auto" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="res_device_view_form" model="ir.ui.view">
        <field name="name">res.device.form</field>
        <field name="model">res.device</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Revoked"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <field name="active" invisible="1" />
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="display_name" string="Name" />
                            <field name="device_type" />
                            <field name="ip_address" string="Last IP Address" />
                            <field name="country" />
                            <field name="city" />
                        </group>
                        <group>
                            <field name="first_activity" />
                            <field name="last_activity" />
                        </group>
                    </group>
                    <field name="log_ids">
                        <list>
                            <field name="ip_address" />
                            <field name="country" />
                            <field name="city" />
                            <field name="first_activity" />
                            <field name="last_activity" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_device_view_search" model="ir.ui.view">
        <field name="name">res.device.search</field>
        <field name="model">res.device</field>
        <field name="arch" type="xml">
            <search string="Devices">
                <field name="user_id" />
                <field
                    name="log_ids"
                    string="IP Address"
                    filter_domain="[('log_ids.ip_address', 'ilike', self)]" />
                <field name="platform" />
                <field name="browser" />
                <filter
                    name="computer"
                    string="Computers"
                    domain="[('device_type', '=', 'computer')]" />
                <filter
                    name="mobile"
                    string="Mobiles"
                    domain="[('device_type', '=', 'mobile')]" />
                <separator />
                <filter
                    name="revoked"
                    string="Revoked"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_user"
                        string="User"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="group_device_type"
                        string="Device Type"
                        context="{'group_by': 'device_type'}" />
                    <filter
                        name="group_platform"
                        string="Platform"
                        context="{'group_by': 'platform'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_user_device" model="ir.actions.act_window">
        <field name="name">User Devices</field>
        <field name="res_model">res.device</field>
        <field name="path">user-device</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="res_device_view_search" />
    </record>

</odoo>
