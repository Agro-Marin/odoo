<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_view_search" model="ir.ui.view">
        <field name="model">ir.cron</field>
        <field name="arch" type="xml">
            <search string="Scheduled Actions">
                <field name="name" string="Scheduled Action" />
                <field name="user_id" />
                <field name="model_id" />
                <field name="nextcall" />
                <field name="active" />
                <separator />
                <filter
                    name="all"
                    string="All"
                    domain="['|', ('active', '=', False), ('active', '=', True)]" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="user"
                        string="User"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="execution"
                        string="Execution"
                        context="{'group_by': 'nextcall'}" />
                    <filter
                        name="groupby_model_id"
                        string="Model"
                        context="{'group_by': 'model_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="ir_cron_view_tree" model="ir.ui.view">
        <field name="model">ir.cron</field>
        <field name="arch" type="xml">
            <list string="Scheduled Actions" decoration-muted="(not active)">
                <field name="priority" />
                <field name="name" />
                <field name="model_id" />
                <field name="nextcall" />
                <field name="repeat_interval" />
                <field name="repeat_unit" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="ir_cron_view_calendar" model="ir.ui.view">
        <field name="model">ir.cron</field>
        <field name="priority" eval="2" />
        <field name="arch" type="xml">
            <calendar string="Scheduled Actions" color="user_id" date_start="nextcall">
                <field name="name" />
            </calendar>
        </field>
    </record>

    <record id="ir_cron_view_form" model="ir.ui.view">
        <field name="name">ir.cron.view.form</field>
        <field name="model">ir.cron</field>
        <field name="inherit_id" ref="base.view_server_action_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='create_action']" position="replace">
                <button
                    name="method_direct_trigger"
                    type="object"
                    string="Run Manually"
                    invisible="state != 'code'"
                    class="oe_highlight" />
            </xpath>
            <xpath expr="//button[@name='unlink_action']" position="replace" />
            <xpath expr="//button[@name='run']" position="replace" />
            <xpath
                expr="//button[@name='action_view_code_history']"
                position="replace" />
            <xpath expr="//notebook" position="before">
                <group>
                    <group>
                        <field name="user_id" />
                        <label for="repeat_interval" string="Execute Every" />
                        <div>
                            <field name="repeat_interval" class="oe_inline" />
                            <field name="repeat_unit" class="oe_inline" />
                        </div>
                        <field name="active" widget="boolean_toggle" />
                        <field name="nextcall" />
                        <field name="priority" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//div[field[@name='state']]" position="replace" />
        </field>
    </record>

    <record id="ir_cron_act" model="ir.actions.act_window">
        <field name="name">Scheduled Actions</field>
        <field name="res_model">ir.cron</field>
        <field name="path">crons</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="view_id" ref="ir_cron_view_tree" />
        <field name="context">{'search_default_all': 1}</field>
    </record>

</odoo>
