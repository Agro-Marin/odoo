<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="contact_name">
        <div
            t-if="('name' in fields) or (options.get('country_image') and 'country_id' in fields and object.country_id.image_url)">
            <t t-if="'name' in fields">
                <span t-if="object.name" itemprop="name" t-esc="name" />
                <span
                    t-elif="object.parent_name"
                    itemprop="name"
                    t-esc="object.parent_name" />
            </t>
            <span
                t-if="options.get('country_image') and 'country_id' in fields and object.country_id.image_url"
                t-field="object.country_id.image_url"
                t-options="{'widget': 'image_url', 'class': 'country_flag'}" />
        </div>
    </template>

    <template id="contact">
        <address t-ignore="true" class="o_portal_address mb-0">
            <div t-if="not (('name' in fields) or (address and 'address' in fields) or (city and 'city' in fields) or (phone and 'phone' in fields) or (website and 'website' in fields) or (email and 'email' in fields))" class="css_non_editable_mode_hidden"> --<span class="text-muted" t-esc="name" />-- </div>
            <t t-if="object.country_id.name_position != 'after'">
                <t t-call="base.contact_name" />
            </t>
            <div
                class="gap-2"
                t-att-itemprop="options.get('with_microdata') and 'address'"
                itemscope="itemscope"
                itemtype="http://schema.org/PostalAddress">

                <div
                    t-if="address and 'address' in fields"
                    t-attf-class="d-flex align-items-baseline gap-1">
                    <i
                        t-if="not options.get('no_marker')"
                        class="fa-solid fa-location-dot "
                        role="img"
                        aria-label="Address"
                        title="Address" />
                    <span
                        class="w-100 lh-sm text-break d-block"
                        itemprop="streetAddress"
                        t-esc="address" />
                </div>
                <t t-set="has_city" t-value="city and 'city' in fields" />
                <t
                    t-set="has_state"
                    t-value="object.state_id and object.country_id.state_required" />
                <div
                    t-if="has_city or (country_id and 'country_id' in fields)"
                    t-attf-class="d-flex align-items-baseline gap-1">
                    <i
                        t-if="not options.get('no_marker')"
                        class="fa-solid fa-location-dot "
                        role="img"
                        aria-label="Address"
                        title="Address" />
                    <span>
                        <div>
                            <t t-if="has_city">
                                <span itemprop="addressLocality" t-out="city" />
                                <t t-if="country_id">,</t>
                            </t>
                            <t t-if="has_state">
                                <span itemprop="addressRegion" t-out="object.state_id.code" />, </t>
                            <span itemprop="addressCountry" t-out="country_id" />
                        </div>
                    </span>
                </div>
                <div
                    class="d-flex align-items-center gap-1"
                    t-if="phone and 'phone' in fields">
                    <i
                        t-if="not options.get('no_marker') or options.get('phone_icons')"
                        class="fa-solid fa-phone"
                        role="img"
                        aria-label="Phone"
                        title="Phone" />
                    <span class="o_force_ltr" itemprop="telephone" t-esc="phone" />
                </div>
                <!-- Safari on iOS needs a telephone itemprop even when there is no
                    number to put in it; see test_value_to_html_without_phone. -->
                <div t-if="not (phone and 'phone' in fields)" itemprop="telephone" />
                <div
                    class="d-flex align-items-baseline gap-1"
                    t-if="website and 'website' in fields">
                    <i
                        t-if="not options.get('no_marker')"
                        class="fa-solid fa-earth-americas"
                        role="img"
                        aria-label="Website"
                        title="Website" />
                    <a
                        class="text-break w-100"
                        t-att-href="website and '%s%s' % ('http://' if '://' not in website else '',website)">
                        <span itemprop="website" t-esc="website" />
                    </a>
                </div>
                <div
                    class="d-flex align-items-baseline gap-1"
                    t-if="email and 'email' in fields">
                    <i
                        t-if="not options.get('no_marker')"
                        class="fa-solid fa-envelope"
                        role="img"
                        aria-label="Email"
                        title="Email" />
                    <span class="text-break w-100" itemprop="email" t-esc="email" />
                </div>
            </div>
            <div t-if="vat and 'vat' in fields"><span t-esc="vat_label" />: <span itemprop="vatID" t-esc="vat" /></div>
            <t t-if="object.country_id and object.country_id.name_position == 'after'">
                <t t-call="base.contact_name" />
            </t>
        </address>
    </template>

    <template id="no_contact">
        <address t-ignore="true" class="mb-0">
            <div>
                <div class="d-flex align-items-baseline">
                    <i
                        t-if="not options.get('no_marker')"
                        class="fa-solid fa-location-dot "
                        role="img"
                        aria-label="Address"
                        title="Address" />
                    <span
                        class="w-100 o_force_ltr d-block"
                        t-out="options.get('null_text')" />
                </div>
            </div>
        </address>
    </template>

</odoo>
